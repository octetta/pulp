@name     filter_env_depth_alt
@alias    fd
@group    env
@c_name   skode_clause_filter_env_depth_alt_1
@type     immediate
@arity    1
@match    (finite)
@summary  set filter envelope modulation depth
@doc
Sets modulation depth of the filter envelope on cutoff.
Usage: fd 2000
@code
    return skode_exec_fd(ctx, s, args, argc);
@end

@name     filter_env_depth_alt
@alias    fd
@group    env
@c_name   skode_clause_filter_env_depth_alt_0
@type     immediate
@arity    0
@match    ()
@summary  filter envelope modulation depth no-op
@doc
Filter envelope depth no-op.
@code
    return skode_exec_fd(ctx, s, args, argc);
@end
