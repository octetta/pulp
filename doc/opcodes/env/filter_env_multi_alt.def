@name     filter_env_multi_alt
@alias    kte
@group    env
@c_name   skode_clause_filter_env_multi_alt_0
@type     immediate
@arity    0
@match    ()
@summary  configure multistage filter envelope from data (alt)
@doc
Configures multistage filter envelope from data buffer.
Usage: (0 0 100 1 50 .5) kte
@code
    return skode_exec_fte(ctx, s, args, argc);
@end

@name     filter_env_multi_alt
