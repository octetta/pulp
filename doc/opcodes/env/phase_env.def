@name     phase_env
@alias    ct
@group    env
@c_name   skode_clause_phase_env
@type     realtime
@arity    4
@match    (finite, finite, finite, finite)
@summary  phase distortion envelope parameters (ADSR)
@doc
Configures Casio CZ phase envelope (attack, decay, sustain, release).
Usage: ct a d s r (or phase_env a d s r)
@code
    if (voice < 0 || voice >= synth_config.voice_max) return -1;
    envelope_configure_e(&sv.cz_envelope[voice], args[0], args[1], args[2], args[3]);
    sv.use_cz_envelope[voice] = !(args[0] == 0 && args[1] == 0 && args[2] == 1 && args[3] == 0);
    return 0;
@end
