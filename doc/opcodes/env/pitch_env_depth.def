@name     pitch_env_depth
@alias    pd
@group    env
@c_name   skode_clause_pitch_env_depth
@type     immediate
@arity    1
@match    (finite)
@summary  set pitch envelope depth
@doc
Sets modulation depth for voice pitch/frequency envelope.
Usage: pd depth
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    sv.freq_env_depth[ctx->voice] = args[0];
    return 0;
@end
