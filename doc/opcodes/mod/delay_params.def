@name     delay_params
@alias    DL
@group    mod
@c_name   skode_clause_delay_params_0
@type     immediate
@arity    0
@match    ()
@summary  get delay parameters
@doc
Shows delay parameters.
Usage: DL
@code
    return skode_exec_DL(ctx, s, args, argc);
@end

@name     delay_params
@alias    DL
@group    mod
@c_name   skode_clause_delay_params_1
@type     realtime
@arity    1
@match    (finite)
@summary  set delay bus
@doc
Sets delay bus.
Usage: DL bus
@code
    (void)voice;
    int bus = (int)args[0];
    int coarse, fine, feedback, mod_freq, mod_depth, level;
    delay_params_get(&skred_global_engine, bus, &coarse, &fine, &feedback, &mod_freq, &mod_depth, &level);
    return delay_params_set(&skred_global_engine, bus, coarse, fine, feedback, mod_freq, mod_depth, level);
@end

@name     delay_params
@alias    DL
@group    mod
@c_name   skode_clause_delay_params_2
@type     realtime
@arity    2
@match    (finite, any)
@summary  set delay bus and coarse time
@doc
Sets delay bus and coarse time.
@code
    (void)voice;
    int bus = (int)args[0];
    int coarse, fine, feedback, mod_freq, mod_depth, level;
    delay_params_get(&skred_global_engine, bus, &coarse, &fine, &feedback, &mod_freq, &mod_depth, &level);
    if (isfinite(args[1])) coarse = (int)args[1];
    return delay_params_set(&skred_global_engine, bus, coarse, fine, feedback, mod_freq, mod_depth, level);
@end

