@name     voice_link_sync
@alias    H
@group    mod
@c_name   skode_clause_voice_link_sync_1
@type     realtime
@arity    1
@match    (finite)
@summary  link velocity to target voice
@doc
Links velocity of active voice to follow target voice.
Usage: H 0
@code
    if (voice < 0 || voice >= synth_config.voice_max) return -1;
    sv.link_velo_0[voice] = (args[0] >= 0 && args[0] < synth_config.voice_max) ? args[0] : -1.0f;
    sv.link_velo_1[voice] = -1.0f;
    sv.link_velo_2[voice] = -1.0f;
    sv.link_velo_3[voice] = -1.0f;
    sv.link_velo_4[voice] = -1.0f;
    sv.link_velo_5[voice] = -1.0f;
    return 0;
@end

@name     voice_link_sync
@alias    H
@group    mod
@c_name   skode_clause_voice_link_sync_0
@type     realtime
@arity    0
@match    ()
@summary  voice link velocity clear
@doc
Clears velocity links for active voice.
@code
    if (voice < 0 || voice >= synth_config.voice_max) return -1;
    sv.link_velo_0[voice] = -1.0f;
    sv.link_velo_1[voice] = -1.0f;
    sv.link_velo_2[voice] = -1.0f;
    sv.link_velo_3[voice] = -1.0f;
    sv.link_velo_4[voice] = -1.0f;
    sv.link_velo_5[voice] = -1.0f;
    return 0;
@end

@name     voice_link_sync
@alias    H
@group    mod
@c_name   skode_clause_voice_link_sync_2
@type     realtime
@arity    2
@match    (finite, finite)
@summary  link velocity to 2 target voices
@doc
Links velocity to two target voices.
Usage: H v1 v2
@code
    if (voice < 0 || voice >= synth_config.voice_max) return -1;
    sv.link_velo_0[voice] = (args[0] >= 0 && args[0] < synth_config.voice_max) ? args[0] : -1.0f;
    sv.link_velo_1[voice] = (args[1] >= 0 && args[1] < synth_config.voice_max) ? args[1] : -1.0f;
    sv.link_velo_2[voice] = -1.0f;
    sv.link_velo_3[voice] = -1.0f;
    sv.link_velo_4[voice] = -1.0f;
    sv.link_velo_5[voice] = -1.0f;
    return 0;
@end

