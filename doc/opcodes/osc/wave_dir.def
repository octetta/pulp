@name     wave_dir
@alias    b
@group    osc
@c_name   skode_clause_wave_dir_0
@type     realtime
@arity    0
@match    ()
@summary  toggle waveform playback direction
@doc
Toggles forward/reverse playback direction.
Usage: b (or wave_dir)
@code
    if (voice < 0 || voice >= synth_config.voice_max) return -1;
    return wave_dir(voice, -1);
@end

@name     wave_dir
@alias    b
@group    osc
@c_name   skode_clause_wave_dir_1
@type     realtime
@arity    1
@match    (finite)
@summary  set waveform playback direction
@doc
Sets waveform playback direction (0:forward, 1:reverse, etc.).
Usage: b dir (or wave_dir dir)
@code
    if (voice < 0 || voice >= synth_config.voice_max) return -1;
    return wave_dir(voice, (int)args[0]);
@end
