@name     wave_loop
@alias    B
@group    osc
@c_name   skode_clause_wave_loop_0
@type     realtime
@arity    0
@match    ()
@summary  toggle waveform loop mode
@doc
Toggles looping on active voice wave.
Usage: B (or wave_loop)
@code
    if (voice < 0 || voice >= synth_config.voice_max) return -1;
    return wave_loop(voice, -1);
@end

@name     wave_loop
@alias    B
@group    osc
@c_name   skode_clause_wave_loop_1
@type     realtime
@arity    1
@match    (finite)
@summary  set waveform loop mode
@doc
Sets waveform loop mode (0:one-shot, 1:loop, 2:ping-pong).
Usage: B mode (or wave_loop mode)
@code
    if (voice < 0 || voice >= synth_config.voice_max) return -1;
    return wave_loop(voice, (int)args[0]);
@end
