@name     wave_name
@alias    wt
@group    osc
@c_name   skode_clause_wave_name
@type     immediate
@arity    1
@match    (finite)
@summary  set wavetable name
@doc
Assigns name from bracket string to wavetable slot.
Usage: [name] wt wave
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int x = (int)args[0];
    if (skode_wave_valid(x)) {
        skode_copy_string(sw.name[x], WAVE_NAME_MAX, ands_string(ctx->parse));
    }
    return 0;
@end
