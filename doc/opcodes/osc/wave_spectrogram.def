@name     wave_spectrogram
@alias    WS
@group    osc
@c_name   skode_clause_wave_spectrogram
@type     immediate
@arity    1
@match    (finite)
@summary  display wavetable spectrogram
@doc
Displays ASCII spectrogram visualization for wavetable index.
Usage: WS wave
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int x = (int)args[0];
    if (x >= 0) {
        int w = WAVE_DISPLAY_DEFAULT_WIDTH;
        int h = WAVE_DISPLAY_DEFAULT_HEIGHT / 2;
        wavetable_spectrogram_show(ctx, x, w, h, sw.loop_start[x], sw.loop_end[x], NULL);
    }
    return 0;
@end
