@name     control_event
@alias    ce
@group    seq
@c_name   skode_clause_control_event_1
@type     realtime
@arity    1
@match    (finite)
@summary  emit control event with 1 argument
@doc
Emits control event.
Usage: ce id (or control_event id)
@code
    opcode_event_t op = { .code = SKODE_OP_CONTROL_EVENT, .argc = 1 };
    op.arg[0] = args[0];
    return skode_emit_control_event_opcode(&op, voice, -1, -1, -1);
@end

@name     control_event
@alias    ce
@group    seq
@c_name   skode_clause_control_event_2
@type     realtime
@arity    2
@match    (finite, finite)
@summary  emit control event with 2 arguments
@doc
Emits control event with parameter.
Usage: ce id p1
@code
    opcode_event_t op = { .code = SKODE_OP_CONTROL_EVENT, .argc = 2 };
    op.arg[0] = args[0];
    op.arg[1] = args[1];
    return skode_emit_control_event_opcode(&op, voice, -1, -1, -1);
@end

@name     control_event
