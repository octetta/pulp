    return skode_emit_control_event_opcode(&op, voice, -1, -1, -1);
@end

@name     control_event
@alias    ce
@group    seq
@c_name   skode_clause_control_event_4
@type     realtime
@arity    4
@match    (finite, finite, finite, finite)
@summary  emit control event with 4 arguments
@doc
Emits control event with 3 parameters.
Usage: ce id p1 p2 p3
@code
    opcode_event_t op = { .code = SKODE_OP_CONTROL_EVENT, .argc = 4 };
    op.arg[0] = args[0];
    op.arg[1] = args[1];
