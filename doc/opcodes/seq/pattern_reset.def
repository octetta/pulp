@name     pattern_reset
@alias    Y
@group    seq
@c_name   skode_clause_pattern_reset
@type     immediate
@arity    1
@match    (finite)
@summary  reset pattern steps and length
@doc
Clears all steps in target pattern.
Usage: Y pattern (or pattern_reset pattern)
@code
    (void)ctx; (void)s; (void)argc;
    int p = (int)args[0];
    if (p < 0 || p < PATTERNS_MAX) pattern_reset(p);
    return 0;
@end
