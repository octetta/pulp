@name     pattern_show
@alias    ys
@group    seq
@c_name   skode_clause_pattern_show_0
@type     immediate
@arity    0
@match    ()
@summary  display active pattern steps and status
@doc
Prints step program listings for active pattern.
Usage: ys (or pattern_show)
@code
    if (!ctx) return -1;
    (void)s; (void)args; (void)argc;
    pattern_show(ctx, ctx->pattern, 1);
    return 0;
@end

@name     pattern_show
@alias    ys
@group    seq
@c_name   skode_clause_pattern_show_1
@type     immediate
@arity    1
@match    (finite)
@summary  display target pattern steps and status
@doc
Prints step program listings for target pattern.
Usage: ys pattern (or pattern_show pattern)
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int p = (int)args[0];
    if (p >= 0 && p < PATTERNS_MAX) pattern_show(ctx, p, 1);
    return 0;
@end
