@name     record_wait
@alias    /rw
@group    seq
@c_name   skode_clause_record_wait_0
@type     immediate
@arity    0
@match    ()
@summary  record wait / arm
@doc
Arms recorder waiting for next audio trigger.
Usage: /rw
@code
    return skode_exec_slashrw(ctx, s, args, argc);
@end

@name     record_wait
@alias    /rw
@group    seq
@c_name   skode_clause_record_wait_1
@type     immediate
@arity    1
@match    (finite)
@summary  record wait with duration
@doc
Arms recorder waiting for trigger with duration limit.
Usage: /rw duration
@code
    return skode_exec_slashrw(ctx, s, args, argc);
@end
