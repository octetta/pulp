@name     repeat_macro_ticks
@alias    eRR
@group    seq
@c_name   skode_clause_repeat_macro_ticks
@type     immediate
@arity    1
@match    (any)
@summary  repeat user macro at beat subdivision interval
@doc
Repeats user macro at beat subdivision interval.
Usage: macro_id count beats eRR
@code
    if (!ctx) return -1;
    (void)s;
    skode_repeat_macro(ctx, args, argc, 1);
    return 0;
@end
