@name     step_append
@alias    xa
@group    seq
@c_name   skode_clause_step_append
@type     immediate
@arity    0
@match    ()
@summary  append bracketed program step to active pattern
@doc
Compiles the currently bracketed program string and appends as a step to the active pattern.
Usage: [program] xa (or [program] step_append)
@code
    if (!ctx) return -1;
    (void)s; (void)args; (void)argc;
    const char *source = ands_string(ctx->parse);
    event_program_t program;
    int source_only = source[0] == '\0' || strcmp(source, "-") == 0;
    char hint[16] = "";
    skode_compile_result_t result = source_only ?
      SKODE_COMPILE_OK :
      skode_compile_program_describe(source, &program, hint, sizeof(hint));
    if (result == SKODE_COMPILE_OK) {
      seq_step_append(ctx->pattern, source, source_only ? NULL : &program);
    } else if (result == SKODE_COMPILE_IMMEDIATE_ONLY) {
      if (hint[0])
        ctx->printf(ctx,
          "# '%s' is immediate-only and cannot be compiled into a pattern step\n"
          "# use 'ce N' in the step and bind N with '/ceb 4 N'\n", hint);
      else
        ctx->printf(ctx,
          "# step contains an immediate-only word (e.g. a string bracket or word like >u, e>, /ceb)\n"
          "# use 'ce N' in the step and bind N with '/ceb 4 N'\n");
    } else {
      ctx->printf(ctx, "# step could not be compiled (%d): [%s]\n", result, source);
    }
    return 0;
@end
