@name     audio_output
@alias    /ao
@group    sys
@c_name   skode_clause_audio_output
@type     immediate
@arity    1
@match    (finite)
@summary  select audio output device
@doc
Selects audio playback device by index (-1 for default).
Usage: /ao index
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int x = (int)args[0];
    int result = 0;
    if (x >= 0) result = skred_audio_refresh();
    if (result == 0) result = skred_audio_select(0, x);
    if (result == 0) ctx->printf(ctx, "# %s\n", skred_audio_status());
    else ctx->printf(ctx, "# audio selection failed: /ao %d\n", x);
    return 0;
@end
