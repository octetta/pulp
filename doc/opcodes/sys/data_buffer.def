@name     data_buffer
@alias    D
@group    sys
@c_name   skode_clause_data_buffer_0
@type     immediate
@arity    0
@match    ()
@summary  query data buffer capacity
@doc
Prints the current capacity of the internal data array.
Usage: D (or data_buffer)
@code
    if (!ctx) return -1;
    (void)s; (void)args; (void)argc;
    ctx->printf(ctx, "# D[%d]\n", ands_data_cap(ctx->parse));
    return 0;
@end

@name     data_buffer
@alias    D
@group    sys
@c_name   skode_clause_data_buffer_1
@type     immediate
@arity    1
@match    (finite)
@summary  resize data buffer capacity
@doc
Resizes internal data buffer to hold at least N elements.
Usage: D capacity
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int cap = (int)args[0];
    if (cap > ands_data_cap(ctx->parse)) ands_data_resize(ctx->parse, cap);
    return 0;
@end
