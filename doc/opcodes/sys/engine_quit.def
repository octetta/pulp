@name     engine_quit
@alias    /q
@group    sys
@c_name   skode_clause_engine_quit_0
@type     immediate
@arity    0
@match    ()
@summary  quit engine
@doc
Signals the engine to terminate.
Usage: /q
@code
    return skode_exec_slashq(ctx, s, args, argc);
@end

