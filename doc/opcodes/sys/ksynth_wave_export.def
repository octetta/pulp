@name     ksynth_wave_export
@alias    kw>
@group    sys
@ifdef KSYNTH
@c_name   skode_clause_ksynth_wave_export_0
@type     immediate
@arity    0
@match    ()
@summary  export KSynth result to data buffer
@doc
Copies active KSynth expression result into the data buffer.
Usage: kw>
@code
