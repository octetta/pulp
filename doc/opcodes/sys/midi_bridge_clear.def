@name     midi_bridge_clear
@alias    /mbC
@group    sys
@c_name   skode_clause_midi_bridge_clear
@type     immediate
@arity    0
@match    ()
@summary  clear all MIDI Skode bindings
@doc
Clears all active MIDI-to-Skode command bindings.
Usage: /mbC
@code
    if (!ctx) return -1;
    (void)s; (void)args; (void)argc;
    skred_midi_binding_clear();
    ctx->printf(ctx, "# MIDI Skode bindings cleared\n");
    return 0;
@end
