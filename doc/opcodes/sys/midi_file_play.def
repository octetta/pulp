@name     midi_file_play
@alias    /mf>
@group    sys
@ifdef SKRED_MIDI_ENABLED
@c_name   skode_clause_midi_file_play
@type     immediate
@arity    1
@match    (finite)
@summary  play MIDI file slot
@doc
Starts playback of loaded MIDI file in slot (0..3).
Usage: /mf> slot
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    midi_player_play((int)args[0]);
    return 0;
@end
