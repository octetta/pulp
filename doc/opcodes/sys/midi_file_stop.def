@name     midi_file_stop
@alias    /mf<
@group    sys
@ifdef SKRED_MIDI_ENABLED
@c_name   skode_clause_midi_file_stop
@type     immediate
@arity    1
@match    (finite)
@summary  stop MIDI file playback
@doc
Stops playback of MIDI file in slot (0..3).
Usage: /mf< slot
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    midi_player_stop((int)args[0]);
    return 0;
@end
