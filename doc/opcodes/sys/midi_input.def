@name     midi_input
@alias    /mi
@group    sys
@c_name   skode_clause_midi_input
@type     immediate
@arity    1
@match    (finite)
@summary  open MIDI input port
@doc
Opens the specified MIDI input port by index.
Usage: /mi port
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int port = (int)args[0];
    int result = skred_midi_init("pulp");
    if (result == 0) result = skred_midi_input_open(port);
    if (result != 0) ctx->printf(ctx, "# MIDI open failed (%d)\n", result);
    return 0;
@end
