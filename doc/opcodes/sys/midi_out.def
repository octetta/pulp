@name     midi_out
@alias    MO
@group    sys
@ifdef SKRED_MIDI_ENABLED
@c_name   skode_clause_midi_out_1
@type     immediate
@arity    1
@match    (finite)
@summary  send raw MIDI byte
@doc
Sends 1 raw MIDI status byte to open MIDI output port.
Usage: MO byte
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int byte = (int)args[0];
    if (byte < 0 || byte > 255 || (double)byte != args[0]) {
        ctx->printf(ctx, "# usage: MO status[,data1[,data2]]\n");
        return 0;
    }
    uint8_t b = (uint8_t)byte;
    int res = skred_midi_send_raw(&b, 1);
    if (res != 0) ctx->printf(ctx, "# MIDI output failed (%d)\n", res);
    return 0;
@end

@name     midi_out
@alias    MO
@group    sys
@c_name   skode_clause_midi_out_2
@type     immediate
@arity    2
@match    (finite, finite)
@summary  send 2 raw MIDI bytes
@doc
Sends 2 raw MIDI bytes (e.g. Program Change, Channel Pressure) to open MIDI output port.
Usage: MO byte1,byte2
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int b1 = (int)args[0], b2 = (int)args[1];
    if (b1 < 0 || b1 > 255 || (double)b1 != args[0] ||
        b2 < 0 || b2 > 255 || (double)b2 != args[1]) {
        ctx->printf(ctx, "# usage: MO status[,data1[,data2]]\n");
        return 0;
    }
    uint8_t b[2] = { (uint8_t)b1, (uint8_t)b2 };
    int res = skred_midi_send_raw(b, 2);
    if (res != 0) ctx->printf(ctx, "# MIDI output failed (%d)\n", res);
    return 0;
@end

@name     midi_out
@alias    MO
@group    sys
@c_name   skode_clause_midi_out_3
@type     immediate
@arity    3
@match    (finite, finite, finite)
@summary  send 3 raw MIDI bytes
@doc
Sends 3 raw MIDI bytes (e.g. Note On, Note Off, CC) to open MIDI output port.
Usage: MO byte1,byte2,byte3
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int b1 = (int)args[0], b2 = (int)args[1], b3 = (int)args[2];
    if (b1 < 0 || b1 > 255 || (double)b1 != args[0] ||
        b2 < 0 || b2 > 255 || (double)b2 != args[1] ||
        b3 < 0 || b3 > 255 || (double)b3 != args[2]) {
        ctx->printf(ctx, "# usage: MO status[,data1[,data2]]\n");
        return 0;
    }
    uint8_t b[3] = { (uint8_t)b1, (uint8_t)b2, (uint8_t)b3 };
    int res = skred_midi_send_raw(b, 3);
    if (res != 0) ctx->printf(ctx, "# MIDI output failed (%d)\n", res);
    return 0;
@end
