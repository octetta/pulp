@name     midi_output
@alias    /mo
@group    sys
@c_name   skode_clause_midi_output
@type     immediate
@arity    1
@match    (finite)
@summary  open MIDI output port
@doc
Opens the specified MIDI output port by index.
Usage: /mo port
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int port = (int)args[0];
    int result = skred_midi_init("pulp");
    if (result == 0) result = skred_midi_output_open(port);
    if (result != 0) ctx->printf(ctx, "# MIDI open failed (%d)\n", result);
    return 0;
@end
