@name     midi_route_clear
@alias    /mC
@group    sys
@ifdef SKRED_MIDI_ENABLED
@c_name   skode_clause_midi_route_clear
@type     immediate
@arity    0
@match    ()
@summary  clear all MIDI routes
@doc
Removes all installed MIDI routes.
Usage: /mC
@code
    if (!ctx) return -1;
    (void)s; (void)args; (void)argc;
    skred_midi_route_clear();
    ctx->printf(ctx, "# MIDI routes cleared\n");
    return 0;
@end
