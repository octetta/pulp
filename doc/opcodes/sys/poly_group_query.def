@name     poly_group_query
@alias    ?pg
@group    sys
@c_name   skode_clause_poly_group_query_0
@type     immediate
@arity    0
@match    ()
@summary  query all polyphony groups
@doc
Prints status of all configured polyphony groups.
Usage: ?pg
@code
    if (!ctx) return -1;
    (void)s; (void)args; (void)argc;
    ctx->printf(ctx, "%s", skred_poly_group_status(-1));
    return 0;
@end

@name     poly_group_query
@alias    ?pg
@group    sys
@c_name   skode_clause_poly_group_query_1
@type     immediate
@arity    1
@match    (finite)
@summary  query single polyphony group
@doc
Prints status of specified polyphony group.
Usage: ?pg group
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    ctx->printf(ctx, "%s", skred_poly_group_status((int)args[0]));
    return 0;
@end
