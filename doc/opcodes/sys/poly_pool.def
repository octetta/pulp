@name     poly_pool
@alias    /pp
@group    sys
@c_name   skode_clause_poly_pool_4
@type     immediate
@arity    4
@match    (finite, finite, finite, finite)
@summary  configure polyphonic voice pool
@doc
Configures a dynamic polyphonic allocation pool (pool, group, base, count).
Usage: /pp pool group base count
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int pool = (int)args[0], group = (int)args[1], base = (int)args[2], count = (int)args[3];
    if (skred_poly_pool_set(pool, group, base, count, SKRED_POLY_STEAL_RELEASE_OLDEST) != 0)
        ctx->printf(ctx, "# usage: /pp pool,group,base,count[,steal-policy]\n");
    return 0;
@end

@name     poly_pool
@alias    /pp
@group    sys
@c_name   skode_clause_poly_pool_5
@type     immediate
@arity    5
@match    (finite, finite, finite, finite, finite)
@summary  configure polyphonic voice pool with steal policy
@doc
Configures polyphonic allocation pool with custom voice stealing policy.
Usage: /pp pool group base count policy
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    int pool = (int)args[0], group = (int)args[1], base = (int)args[2], count = (int)args[3], policy = (int)args[4];
    if (skred_poly_pool_set(pool, group, base, count, policy) != 0)
        ctx->printf(ctx, "# usage: /pp pool,group,base,count[,steal-policy]\n");
    return 0;
@end
