@name     poly_pool_query
@alias    ?pp
@group    sys
@c_name   skode_clause_poly_pool_query_0
@type     immediate
@arity    0
@match    ()
@summary  query all polyphonic voice pools
@doc
Prints status of all configured polyphonic voice pools.
Usage: ?pp
@code
    if (!ctx) return -1;
    (void)s; (void)args; (void)argc;
    ctx->printf(ctx, "%s", skred_poly_pool_status(-1));
    return 0;
@end

@name     poly_pool_query
@alias    ?pp
@group    sys
@c_name   skode_clause_poly_pool_query_1
@type     immediate
@arity    1
@match    (finite)
@summary  query single polyphonic voice pool
@doc
Prints status of specified polyphonic voice pool.
Usage: ?pp pool
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    ctx->printf(ctx, "%s", skred_poly_pool_status((int)args[0]));
    return 0;
@end
