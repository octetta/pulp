@name     query_step
@alias    ?st
@group    sys
@c_name   skode_clause_query_step_0
@type     immediate
@arity    0
@match    ()
@summary  query active step index
@doc
Pushes active sequence step index to return register.
Usage: ?st
@code
    return skode_exec_qstep(ctx, s, args, argc);
@end

