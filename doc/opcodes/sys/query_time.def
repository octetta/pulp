@name     query_time
@alias    ?t
@group    sys
@c_name   skode_clause_query_time_0
@type     immediate
@arity    0
@match    ()
@summary  query current sample time
@doc
Pushes current engine sample count to return register.
Usage: ?t
@code
    return skode_exec_qtime(ctx, s, args, argc);
@end

@name     query_time
@alias    ?t
@group    sys
@c_name   skode_clause_query_time_1
@type     immediate
@arity    1
@match    (any)
@summary  query current sample time with argument
@doc
Pushes current engine sample count to return register.
@code
    return skode_exec_qtime(ctx, s, args, argc);
@end
