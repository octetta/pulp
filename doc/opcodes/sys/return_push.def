@name     return_push
@alias    *R
@group    sys
@type     immediate
@arity    0
@match    ()
@summary  reset or clear return registers
@doc
Pushes arguments into parser return registers @0 through @7.
Usage: *R [arg0] [arg1] ...
@code
    (void)ctx; (void)s; (void)args; (void)argc;
    return 0;
@end

@name     return_push
@alias    *R
@group    sys
@type     immediate
@arity    1
@match    (any)
@summary  push 1 argument into return registers
@doc
Pushes 1 argument into return register @0.
@code
    (void)ctx; (void)argc;
    ands_return_push(s, args[0]);
    return 0;
@end

@name     return_push
@alias    *R
@group    sys
@type     immediate
@arity    2
@match    (any, any)
@summary  push 2 arguments into return registers
@doc
Pushes 2 arguments into return registers @0 and @1.
@code
    (void)ctx; (void)argc;
    ands_return_push(s, args[0]);
    ands_return_push(s, args[1]);
    return 0;
@end

@name     return_push
@alias    *R
@group    sys
@type     immediate
@arity    3
@match    (any, any, any)
@summary  push 3 arguments into return registers
@doc
Pushes 3 arguments into return registers @0 through @2.
@code
    (void)ctx; (void)argc;
    for (int i = 0; i < 3; i++) ands_return_push(s, args[i]);
    return 0;
@end

