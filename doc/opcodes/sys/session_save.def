@name     session_save
@alias    GS>
@group    sys
@c_name   skode_clause_session_save_0
@type     immediate
@arity    0
@match    ()
@summary  save global session to zip
@doc
Saves global session archive to the filename in parser string buffer.
Usage: [session.zip] GS>
@code
    return skode_exec_GS_gt(ctx, s, args, argc);
@end

@name     session_save
@alias    GS>
@group    sys
@c_name   skode_clause_session_save_1
@type     immediate
@arity    1
@match    (any)
@summary  save global session to zip with argument
@doc
Saves global session archive.
@code
    return skode_exec_GS_gt(ctx, s, args, argc);
@end
