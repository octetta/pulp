@name     stack_clear
@alias    clr
@group    sys
@c_name   skode_clause_stack_clear_0
@type     immediate
@arity    0
@match    ()
@summary  clear argument stack
@doc
Clears all arguments from the parser stack.
Usage: clr
@code
    return skode_exec_clr(ctx, s, args, argc);
@end

