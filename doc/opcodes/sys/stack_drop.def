@name     stack_drop
@alias    drop
@group    sys
@c_name   skode_clause_stack_drop_1
@type     immediate
@arity    1
@match    (any)
@summary  drop argument from stack
@doc
Drops top argument from the parser stack.
Usage: 1 drop
@code
    return skode_exec_drop(ctx, s, args, argc);
@end

