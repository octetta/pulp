@name     stack_dup
@alias    dup
@group    sys
@c_name   skode_clause_stack_dup_1
@type     immediate
@arity    1
@match    (any)
@summary  duplicate top stack argument
@doc
Duplicates top argument on the parser stack.
Usage: 1 dup
@code
    return skode_exec_dup(ctx, s, args, argc);
@end

