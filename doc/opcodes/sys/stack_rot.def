@name     stack_rot
@alias    rot
@group    sys
@c_name   skode_clause_stack_rot_3
@type     immediate
@arity    3
@match    (any, any, any)
@summary  rotate top three stack arguments
@doc
Rotates top three parser arguments left.
Usage: 1 2 3 rot
@code
    return skode_exec_rot(ctx, s, args, argc);
@end

