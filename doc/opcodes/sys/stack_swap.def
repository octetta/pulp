@name     stack_swap
@alias    swap
@group    sys
@c_name   skode_clause_stack_swap_2
@type     immediate
@arity    2
@match    (any, any)
@summary  swap top two stack arguments
@doc
Swaps the top two arguments on the parser stack.
Usage: 1 2 swap
@code
    return skode_exec_swap(ctx, s, args, argc);
@end

