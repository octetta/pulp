@name     step_program_set
@alias    x
@group    sys
@c_name   skode_clause_step_program_set_1
@type     immediate
@arity    1
@match    (finite)
@summary  set pattern step program
@doc
Sets program for specified pattern step from string buffer.
Usage: [v0 n60] 0 x
@code
    return skode_exec_x(ctx, s, args, argc);
@end

