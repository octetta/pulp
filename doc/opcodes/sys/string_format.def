@name     string_format
@alias    s%
@group    sys
@c_name   skode_clause_string_format_0
@type     immediate
@arity    0
@match    ()
@summary  format string template with arguments
@doc
Substitutes format placeholders (@0, @1...) in string with stack arguments.
Usage: [template] s%
@code
    return skode_exec_s_pct(ctx, s, args, argc);
@end

@name     string_format
@alias    s%
@group    sys
@c_name   skode_clause_string_format_1
@type     immediate
@arity    1
@match    (any)
@summary  format string template with 1 argument
@doc
Substitutes @0 in template string with stack argument.
Usage: [template] arg0 s%
@code
    return skode_exec_s_pct(ctx, s, args, argc);
@end

@name     string_format
@alias    s%
@group    sys
