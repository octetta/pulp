@name     trace_toggle
@alias    /t
@group    sys
@c_name   skode_clause_trace_toggle_0
@type     immediate
@arity    0
@match    ()
@summary  toggle parser trace
@doc
Toggles trace execution logging.
Usage: /t
@code
    return skode_exec_slasht(ctx, s, args, argc);
@end

@name     trace_toggle
@alias    /t
@group    sys
@c_name   skode_clause_trace_toggle_1
@type     immediate
@arity    1
@match    (finite)
@summary  set parser trace level
@doc
Sets parser trace level (0=off, 1=on, 2=verbose).
Usage: /t 1
@code
    return skode_exec_slasht(ctx, s, args, argc);
@end
