@name     var_div
@alias    /=
@group    sys
@c_name   skode_clause_var_div
@type     immediate
@arity    3
@match    (finite, finite, finite)
@summary  divide two values and store in variable
@doc
Stores (v1 / v2) into variable register $var.
Usage: /= var v1 v2
@code
    if (!ctx) return -1;
    (void)argc;
    if (args[2] == 0.0) return -1;
    int var = (int)args[0];
    double val = args[1] / args[2];
    ands_set_local(ctx->parse, var, val);
    ands_arg_clear(s);
    ands_arg_push(s, val);
    return 1;
@end
