@name     verbose_toggle
@alias    /v
@group    sys
@c_name   skode_clause_verbose_toggle_0
@type     immediate
@arity    0
@match    ()
@summary  toggle verbose output
@doc
Toggles verbose diagnostics output.
Usage: /v
@code
    return skode_exec_slashv(ctx, s, args, argc);
@end

@name     verbose_toggle
@alias    /v
@group    sys
@c_name   skode_clause_verbose_toggle_1
@type     immediate
@arity    1
@match    (finite)
@summary  set verbose level
@doc
Sets verbose diagnostics level (0=off, 1=on).
Usage: /v 1
@code
    return skode_exec_slashv(ctx, s, args, argc);
@end
