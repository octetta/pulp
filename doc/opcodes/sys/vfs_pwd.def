@name     vfs_pwd
@alias    %pwd
@group    sys
@c_name   skode_clause_vfs_pwd_0
@type     immediate
@arity    0
@match    ()
@summary  print current vfs directory
@doc
Prints the current working directory in VFS.
Usage: %pwd
@code
    return skode_exec_pctpwd(ctx, s, args, argc);
@end

@name     vfs_pwd
@alias    %pwd
@group    sys
@c_name   skode_clause_vfs_pwd_1
@type     immediate
@arity    1
@match    (any)
@summary  print current vfs directory with argument
@doc
Prints the current working directory in VFS.
@code
    return skode_exec_pctpwd(ctx, s, args, argc);
@end
