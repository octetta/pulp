@name     voice_bench
@alias    /m_
@group    sys
@c_name   skode_clause_voice_bench_0
@type     immediate
@arity    0
@match    ()
@summary  benchmark synth voice
@doc
Runs benchmark on active synth voice.
Usage: /m_
@code
    return skode_exec_slashm_(ctx, s, args, argc);
@end

@name     voice_bench
