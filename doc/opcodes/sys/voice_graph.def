@name     voice_graph
@alias    /vg
@group    sys
@c_name   skode_clause_voice_graph_1
@type     immediate
@arity    1
@match    (finite)
@summary  inspect voice routing graph
@doc
Inspects audio and modulation routing tree for voice.
Usage: /vg voice
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    ctx->printf(ctx, "%s", skred_voice_graph((int)args[0], 0, 0));
    return 0;
@end

@name     voice_graph
@alias    /vg
@group    sys
@c_name   skode_clause_voice_graph_2
@type     immediate
@arity    2
@match    (finite, finite)
@summary  inspect voice routing graph with format
@doc
Inspects voice graph with output format (0=text, 1=dot/mermaid).
Usage: /vg voice format
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    ctx->printf(ctx, "%s", skred_voice_graph((int)args[0], (int)args[1], 0));
    return 0;
@end

@name     voice_graph
@alias    /vg
@group    sys
@c_name   skode_clause_voice_graph_3
@type     immediate
@arity    3
@match    (finite, finite, finite)
@summary  inspect voice routing graph with format and depth
@doc
Inspects voice graph with format and traversal depth limit.
Usage: /vg voice format depth
@code
    if (!ctx) return -1;
    (void)s; (void)argc;
    ctx->printf(ctx, "%s", skred_voice_graph((int)args[0], (int)args[1], (int)args[2]));
    return 0;
@end
