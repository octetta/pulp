@name     delay_send
@alias    ds
@group    voice
@c_name   skode_clause_delay_send_1
@type     immediate
@arity    1
@match    (finite)
@summary  set voice delay send level
@doc
Sets delay send level for the active voice.
Usage: ds 15
@code
    return skode_exec_ds(ctx, s, args, argc);
@end

@name     delay_send
