@name     gate_off
@alias    off
@group    voice
@c_name   skode_clause_gate_off_0
@type     immediate
@arity    0
@match    ()
@summary  turn active voice gate off
@doc
Triggers voice gate off (velocity 0.0) with linked voices.
Usage: off
@code
    return skode_exec_off(ctx, s, args, argc);
@end

@name     gate_off
@alias    off
