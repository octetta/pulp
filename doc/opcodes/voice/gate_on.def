@name     gate_on
@alias    on
@group    voice
@c_name   skode_clause_gate_on_0
@type     immediate
@arity    0
@match    ()
@summary  turn active voice gate on
@doc
Triggers voice gate on (velocity 1.0) with linked voices.
Usage: on
@code
    return skode_exec_on(ctx, s, args, argc);
@end

@name     gate_on
