@name     rec_to_wave_slot_alias
@alias    r!
@group    voice
@c_name   skode_clause_rec_to_wave_slot_alias_1
@type     immediate
@arity    1
@match    (finite)
@summary  save trimmed recording to wavetable slot (alias)
@doc
Saves trimmed recording buffer into specified wavetable slot.
Usage: 0 r!
@code
    return skode_exec_w_bang(ctx, s, args, argc);
@end

@name     rec_to_wave_slot_alias
@alias    r!
@group    voice
@c_name   skode_clause_rec_to_wave_slot_alias_0
@type     immediate
@arity    0
@match    ()
@summary  save trimmed recording to default wavetable slot (alias)
@doc
Saves trimmed recording buffer into default slot.
Usage: r!
@code
    return skode_exec_w_bang(ctx, s, args, argc);
@end
