@name     rec_trim_end
@alias    w<
@group    voice
@c_name   skode_clause_rec_trim_end_0
@type     immediate
@arity    0
@match    ()
@summary  advance recording end trim by 1
@doc
Advances recording buffer end trim by 1 sample.
Usage: w<
@code
    return skode_exec_w_lt(ctx, s, args, argc);
@end

@name     rec_trim_end
@alias    w<
@group    voice
@c_name   skode_clause_rec_trim_end_1
@type     immediate
@arity    1
@match    (finite)
@summary  advance recording end trim by samples
@doc
Advances recording buffer end trim by specified sample count.
Usage: 100 w<
@code
    return skode_exec_w_lt(ctx, s, args, argc);
@end
