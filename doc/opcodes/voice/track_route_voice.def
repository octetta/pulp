@name     track_route_voice
@alias    rv
@group    voice
@c_name   skode_clause_track_route_voice_2
@type     immediate
@arity    2
@match    (finite, finite)
@summary  set track volume in dB
@doc
Sets volume in dB for specified track.
Usage: rv 2, -9
@code
    return skode_exec_rv(ctx, s, args, argc);
@end

@name     track_route_voice
@alias    rv
@group    voice
@c_name   skode_clause_track_route_voice_1
@type     immediate
@arity    1
@match    (finite)
@summary  route target voice to active voice track
@doc
Routes target voice to the track of the active voice.
Usage: rv 0
@code
    return skode_exec_rv(ctx, s, args, argc);
@end

@name     track_route_voice
@alias    rv
@group    voice
@c_name   skode_clause_track_route_voice_0
@type     immediate
