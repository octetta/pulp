@name     velocity
@alias    l
@group    voice
@c_name   skode_clause_velocity
@type     realtime
@arity    1
@match    (finite)
@summary  set voice note velocity
@doc
Sets voice note velocity / gate duration.
Usage: l vel (or velocity vel)
@code
    if (voice < 0 || voice >= synth_config.voice_max) return -1;
    return skode_linked_velocity(voice, args[0], SAMPLE_COUNT_GET());
@end
