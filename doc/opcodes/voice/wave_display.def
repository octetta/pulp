@name     wave_display
@alias    W
@group    voice
@c_name   skode_clause_wave_display_1
@type     immediate
@arity    1
@match    (any)
@summary  render ascii waveform for wave slot
@doc
Renders ASCII waveform preview for wave slot or recording buffer.
Usage: 0 W
@code
    return skode_exec_W(ctx, s, args, argc);
@end

@name     wave_display
@alias    W
@group    voice
@c_name   skode_clause_wave_display_0
@type     immediate
@arity    0
@match    ()
@summary  render ascii waveform for default slot
@doc
Renders ASCII waveform preview.
@code
    return skode_exec_W(ctx, s, args, argc);
@end

@name     wave_display
@alias    W
@group    voice
@c_name   skode_clause_wave_display_2
@type     immediate
@arity    2
@match    (any, any)
@summary  render ascii waveform with dimensions
@doc
Renders ASCII waveform preview with dimensions.
Usage: 0 80 W
@code
    return skode_exec_W(ctx, s, args, argc);
@end

@name     wave_display
@alias    W
