# ======================================================================
#  ELECTRIC SUN (Vince Clarke & Diplo Collaboration Tribute)
#  122 BPM, E minor / G Major, Global Festival Synth-Pop Anthem
# ======================================================================

[ELECTRIC SUN - VINCE CLARKE & DIPLO GLOBAL ANTHEM] puts
V -7.6
M 122 16

# ----------------------------------------------------------------------
# DELAY BUSES (tempo synced to 122 BPM)
# ----------------------------------------------------------------------
# Bus 1: Dotted-eighth stereo lead echo (Global anthem space)
DS 1 122 .75
DL 1 - - 8 3 3 11
DD 1 7 3

# Bus 2: 16th ping-pong arpeggiator & marimba echo (Vince Clarke signature)
DS 2 122 .25
DL 2 - - 6 0 0 9
DD 2 5 4
DP 2 1

# Bus 3: Eighth note slapback
DS 3 122 .5
DL 3 - - 7 0 0 10
DD 3 6 4

# Bus 4: Warm festival hall wash
DS 4 122 1.0
DL 4 - - 11 4 8 10
DD 4 8 2
DP 4 1

