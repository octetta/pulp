v21 w94 f440 a3.5 p.2                        # crash cymbal
v22 w96 f520 a3.5 p-.25 r2 ds.3              # Diplo tropical woodblock / perc tick
v23 w87 f440 a4.5 p.25                       # crisp rimshot / snap

# RISER (inline K-synth festival noise sweep)
[
/ global festival riser
N: 131072
T: !N
E: (e(T*(4.5%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 850*(e(T*(2.8%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.65))
] k!
k>w301,44100,1
v16 w301 f180 a7.5 p0 t.005,.01,1,.3 r4 ds.3  # noise riser

