# ======================================================================
# BLUE MONDAY - NEW ORDER
# A Step-by-Step Live Coding Setup for Skred
# ======================================================================

# ----------------------------------------------------------------------
# STEP 1: INITIALIZATION & TEMPO
# ----------------------------------------------------------------------
M130

# Delay Bus 1: A chorus effect for the high melodic bass and synths
DL 1 4 12 4 0 31 10 DD 1 2 DF 0 DP 0 DG 0,0

# ----------------------------------------------------------------------
# STEP 2: VOICE CONFIGURATION (THE SYNTHS & DRUMS)
# ----------------------------------------------------------------------
# DRUMS
v 0 vt [Kick]  w 100 f 65  a 25 t 0.001 0.1 0 0     r 0 ds 0.0
v 1 vt [Hat]   w 101 f 440 a 3  t 0.001 0.05 0 0    r 0 ds 0.0
v 2 vt [Snare] w 103 f 440 a 15 t 0.001 0.2 0 0 J 2 0 K 1500 Q 2 r 0 ds 0.0

# SYNTH BASS (The iconic octave-jumping D minor bass)
v 3 vt [Bass] w 1 f 440 a 6 t 0.01 0.1 0.3 0.1 J 1 0 K 800 Q 1.5 r 1 ds 0.2

# SEQUENCE SYNTH (The fast 16th note riff)
v 4 vt [Seq] w 2 f 440 a 4 t 0.001 0.1 0.1 0.05 J 1 0 K 1500 Q 1.0 r 1 ds 0.4

# HOOK BASS (Peter Hook's high melodic bass guitar)
v 5 vt [Hook] w 1 f 440 a 8 t 0.01 0.2 0.4 0.2 J 1 0 K 2500 Q 1.0 r 1 ds 0.6

# ----------------------------------------------------------------------
# STEP 3: MACRO DEFINITIONS (Max 4 chars)
# ----------------------------------------------------------------------
[Kik] : v 0 l 1 ;
[Hat] : v 1 l 1 ;
[Snr] : v 2 l 1 ;
[Bas] : v 3 n $$0 l 1 ;
[Seq] : v 4 n $$0 l 1 ;
[Hok] : v 5 n $$0 l 1 ;

# ----------------------------------------------------------------------
# STEP 4: SEQUENCING THE PATTERNS
# ----------------------------------------------------------------------
y 0 yt [BarClock]
% 16
[#] x 15

# --- DRUM & BASS (1-bar loop, 16th notes) ---
# Combined to avoid the 2-pattern trigger limit in the orchestrator.
y 2 yt [DrumBass]
% 1
[Kik Bas 41] x 0   [Hat] x 1         [Hat Bas 53] x 2   [Hat] x 3
[Kik Bas 36] x 4   [Hat] x 5         [Snr Bas 48] x 6   [Hat] x 7
[Kik Bas 38] x 8   [Hat] x 9         [Hat Bas 50] x 10  [Hat] x 11
[Kik Bas 38] x 12  [Hat] x 13        [Snr Bas 50] x 14  [Hat] x 15

# --- SEQUENCE SYNTH (1-bar loop, 16th notes) ---
# D - C - D - F - G - F - D - C (16ths)
# D - C - D - F - G(8th) - F(8th)
y 4 yt [SeqLine]
% 1
[Seq 62] x 0   [Seq 60] x 1   [Seq 62] x 2   [Seq 65] x 3
[Seq 67] x 4   [Seq 65] x 5   [Seq 62] x 6   [Seq 60] x 7
[Seq 62] x 8   [Seq 60] x 9   [Seq 62] x 10  [Seq 65] x 11
[Seq 67] x 12                 [Seq 65] x 14

# --- HOOK BASS (2-bar loop, 8th and 4tr notes) ---
# We split this into y 5 (Bar 1) and y 6 (Bar 2)
y 5 yt [HookA]
% 1
[Hok 62] x 0   [Hok 60] x 2   [Hok 62] x 4   [Hok 65] x 6
[Hok 67] x 8   [Hok 65] x 10  [Hok 62] x 12  [Hok 60] x 14

y 6 yt [HookB]
% 1
[Hok 62] x 0   [Hok 60] x 2   [Hok 62] x 4   [Hok 65] x 6
[Hok 67] x 8                                 [Hok 65] x 12

# ----------------------------------------------------------------------
# STEP 5: THE ORCHESTRATOR 
# ----------------------------------------------------------------------
y 1 yt [Arranger]
% 16
# Trigger DrumBass (y 2) and Seq (y 4) on Bar 1
[ /z 2 1 /z 4 1 Kik Bas 41 Seq 62 ] x 0

# Trigger Hook Bass A (y 5) on Bar 5, Hook Bass B (y 6) on Bar 6
[ /z 5 1 Hok 62 ] x 4
[ /z 6 1 Hok 62 ] x 5
[ /z 5 1 Hok 62 ] x 6
[ /z 6 1 Hok 62 ] x 7
[ /z 5 1 Hok 62 ] x 8
[ /z 6 1 Hok 62 ] x 9
[ /z 5 1 Hok 62 ] x 10
[ /z 6 1 Hok 62 ] x 11
[ /z 5 1 Hok 62 ] x 12
[ /z 6 1 Hok 62 ] x 13
[ /z 5 1 Hok 62 ] x 14
[ /z 6 1 Hok 62 ] x 15

# Safety padding via comment to prevent empty array compilation bugs!
[#] x 63

# ----------------------------------------------------------------------
# STEP 6: LIVE PERFORMANCE GUIDE
# ----------------------------------------------------------------------
# 1. Start the Master Clock:  y 0 z 1
# 2. Drop the Arranger:       y 1 z 1
# 3. Stop everything:         /z 1 0 /z 2 0 /z 3 0 /z 4 0 /z 5 0 /z 6 0
