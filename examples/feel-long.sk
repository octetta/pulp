# ----------------------------------------------------------------------
# Donna Summer – I Feel Love  (extended ~8 min version)
# Giorgio Moroder / Moog modular style
# ----------------------------------------------------------------------

M 128 16

# Short delay for the classic doubled-bass effect
DT 1 115
DL 1 - - 4 0 1 5
DD 1 4 2

# ======================================================================
# K-SYNTH DRUMS
# ======================================================================
[sk/drums-kick.ks]  /ks 1 k>d d>r /r100
[sk/drums-chh.ks]   /ks 1 k>d d>r /r101
[sk/drums-ohh.ks]   /ks 1 k>d d>r /r102
[sk/drums-clap.ks]  /ks 1 k>d d>r /r103

# ======================================================================
# VOICES
# ======================================================================

v 0 vt [Kick]
w100 f440 a12

v 1 vt [ClosedHat]
w101 f440 a3.0

v 2 vt [OpenHat]
w102 f440 a4.5

v 3 vt [Clap]
w103 f440 a5

v 4 vt [MoogBass]
w 2 a 0.70
t 0.001 0.18 0.15 0.08
J 1 K 280 Q 1.8
N 0 0
g 0.005
p 0 r 1 ds 3

v 5 vt [MoogBassDelay]
w 2 a 0.55
t 0.001 0.18 0.15 0.08
J 1 K 300 Q 1.6
N 0 0
g 0.005
L 0.04
p 0.35 r 1 ds 2

v 6 vt [HighStab]
w 18 a 0.35
t 0.005 0.12 0.2 0.1
J 1 K 2200 Q 1.5
N 0 4

v 7 vt [Pad]
w 19 a 0.22
t 0.9 1.2 0.65 2.0
J 1 K 850 Q 0.6
p 0 r 1 ds 4

# ======================================================================
# MACROS
# ======================================================================

# One note of the sequence (dry + delayed)
[Seq] : v4 n $$0 l1  v5 n $$0 l1 ;

[offB] : v4 l0 v5 l0 ;
[offS] : v6 l0 ;
[offP] : v7 l0 ;

# ======================================================================
# PATTERN 0 – Master
# ======================================================================
y0 yt [Master]
% 16

# 0:00  Intro – drums only
[ /z 1 1 ] x0

# 0:15  Bass enters in C
[ /z 2 1 ] x4

# 0:30  High stabs + pad
[ /z 6 1 /z 7 1 ] x8

# 1:00  Move to Eb
[ /z 2 0 /z 3 1 ] x16

# 1:30  Keep driving
[ /z 6 0 ] x24

# 2:00  Move to F
[ /z 3 0 /z 4 1 /z 6 1 ] x32

# 2:45  Move to G
[ /z 4 0 /z 5 1 ] x44

# 3:30  Back to C – peak section
[ /z 5 0 /z 2 1 ] x56

# 4:15  Drop stabs, pure groove
[ /z 6 0 /z 7 0 ] x68

# 5:00  Bring atmosphere back
[ /z 7 1 ] x80

# 5:45  Final key run (C → Eb → F → G)
[ /z 2 0 /z 3 1 ] x92
[ /z 3 0 /z 4 1 ] x100
[ /z 4 0 /z 5 1 ] x108

# 6:30  Return to C for the long outro
[ /z 5 0 /z 2 1 /z 6 1 ] x116

# 7:15  Thin out
[ /z 6 0 /z 7 0 ] x128

# 7:45  End
[ /z 1 0 /z 2 0 offB offS offP ] x136
[ /z 0 0 ] x140

# ======================================================================
# PATTERN 1 – Drums
# ======================================================================
y1 yt [Drums]
% 1
[v0 l1] x0
[v1 l1] x1
[v2 l1] x2
[v1 l1] x3
[v0 l1] x4
[v1 l1] x5
[v2 l1] x6
[v1 l1] x7
[v0 l1] x8
[v1 l1] x9
[v2 l1] x10
[v1 l1] x11
[v0 l1] x12
[v1 l1] x13
[v2 l1] x14
[v1 l1] x15
[#] x15

# ======================================================================
# PATTERN 2 – Bass sequence in C
# ======================================================================
y2 yt [BassC]
% 1
[Seq 36] x0
[Seq 36] x2
[Seq 43] x4
[Seq 46] x6
[Seq 36] x8
[Seq 36] x10
[Seq 43] x12
[Seq 46] x14
[#] x15

# ======================================================================
# PATTERN 3 – Bass sequence in Eb
# ======================================================================
y3 yt [BassEb]
% 1
[Seq 39] x0
[Seq 39] x2
[Seq 46] x4
[Seq 49] x6
[Seq 39] x8
[Seq 39] x10
[Seq 46] x12
[Seq 49] x14
[#] x15

# ======================================================================
# PATTERN 4 – Bass sequence in F
# ======================================================================
y4 yt [BassF]
% 1
[Seq 41] x0
[Seq 41] x2
[Seq 48] x4
[Seq 51] x6
[Seq 41] x8
[Seq 41] x10
[Seq 48] x12
[Seq 51] x14
[#] x15

# ======================================================================
# PATTERN 5 – Bass sequence in G
# ======================================================================
y5 yt [BassG]
% 1
[Seq 43] x0
[Seq 43] x2
[Seq 50] x4
[Seq 53] x6
[Seq 43] x8
[Seq 43] x10
[Seq 50] x12
[Seq 53] x14
[#] x15

# ======================================================================
# PATTERN 6 – High stabs
# ======================================================================
y6 yt [Stabs]
% 1
[v6 n 72 l1] x0
[offS] x2
[v6 n 72 l1] x8
[offS] x10
[#] x15

# ======================================================================
# PATTERN 7 – Pad
# ======================================================================
y7 yt [Pad]
% 1
[v7 n 48 l1] x0
[v7 n 55 l1] x8
[#] x15
