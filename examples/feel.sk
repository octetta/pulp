# ----------------------------------------------------------------------
# Donna Summer – I Feel Love
# Giorgio Moroder / Moog modular style
# ----------------------------------------------------------------------

M 128 16

# Short, tight delay to help the “double” bass feel
DT 1 120
DL 1 - - 4 0 1 5
DD 1 4 2

# ======================================================================
# K-SYNTH DRUMS
# ======================================================================
[sk/drums-kick.ks]  /ks 1 k>d d>r /r100
[sk/drums-chh.ks]   /ks 1 k>d d>r /r101
[sk/drums-ohh.ks]   /ks 1 k>d d>r /r102
[sk/drums-clap.ks]  /ks 1 k>d d>r /r103

# ======================================================================
# VOICES
# ======================================================================

# Kick – solid four-on-the-floor
v 0 w100 f440 a12

# Hats
v 1 w101 f440 a3.0          # closed
v 2 w102 f440 a4.5          # open (off-beat)

# Clap / perc accent
v 3 w103 f440 a5

# Moog-style sequenced bass (the star)
v 4
w 2 a 0.70
t 0.001 0.18 0.15 0.08
J 1 K 280 Q 1.8
N 0 0
g 0.005
p 0 r 1 ds 3

# Second bass voice for the delayed / doubled effect
v 5
w 2 a 0.55
t 0.001 0.18 0.15 0.08
J 1 K 300 Q 1.6
N 0 0
g 0.005
L 0.04                    # small delay to create the classic double
p 0.3 r 1 ds 2

# High synth stab / accent
v 6
w 18 a 0.35
t 0.005 0.12 0.2 0.1
J 1 K 2200 Q 1.5
N 0 4

# Pad / atmosphere
v 7
w 19 a 0.22
t 0.8 1.0 0.6 1.8
J 1 K 900 Q 0.6
p 0 r 1 ds 4

# ======================================================================
# MACROS – the famous sequence
# Core pattern: C C G Bb  (MIDI 36 36 43 46)
# ======================================================================

# One step of the sequence (root + delayed copy)
[Seq] : v4 n $$0 l1  v5 n $$0 l1 ;

# Full 4-note cell
[Cell] : [Seq 36] x0  [Seq 36] x2  [Seq 43] x4  [Seq 46] x6 ;

# Transposed cells (the original moves the sequence up)
[CellC]  : [Seq 36] x0  [Seq 36] x2  [Seq 43] x4  [Seq 46] x6 ;   # C
[CellEb] : [Seq 39] x0  [Seq 39] x2  [Seq 46] x4  [Seq 49] x6 ;   # Eb
[CellF]  : [Seq 41] x0  [Seq 41] x2  [Seq 48] x4  [Seq 51] x6 ;   # F
[CellG]  : [Seq 43] x0  [Seq 43] x2  [Seq 50] x4  [Seq 53] x6 ;   # G

[offB] : v4 l0 v5 l0 ;
[offS] : v6 l0 ;
[offP] : v7 l0 ;

# ======================================================================
# PATTERN 1 – Drums (classic four-on-the-floor + off-beat open hat)
# ======================================================================
y1
% 1
[v0 l1] x0
[v1 l1] x1
[v2 l1] x2                # open hat on the and
[v1 l1] x3
[v0 l1] x4
[v1 l1] x5
[v2 l1] x6
[v1 l1] x7
[v0 l1] x8
[v1 l1] x9
[v2 l1] x10
[v1 l1] x11
[v0 l1] x12
[v1 l1] x13
[v2 l1] x14
[v1 l1] x15
[#] x15

# ======================================================================
# PATTERN 2 – Bass sequence in C
# ======================================================================
y2
% 1
[Seq 36] x0
[Seq 36] x2
[Seq 43] x4
[Seq 46] x6
[Seq 36] x8
[Seq 36] x10
[Seq 43] x12
[Seq 46] x14
[#] x15

# ======================================================================
# PATTERN 3 – Bass sequence in Eb
# ======================================================================
y3
% 1
[Seq 39] x0
[Seq 39] x2
[Seq 46] x4
[Seq 49] x6
[Seq 39] x8
[Seq 39] x10
[Seq 46] x12
[Seq 49] x14
[#] x15

# ======================================================================
# PATTERN 4 – Bass sequence in F
# ======================================================================
y4
% 1
[Seq 41] x0
[Seq 41] x2
[Seq 48] x4
[Seq 51] x6
[Seq 41] x8
[Seq 41] x10
[Seq 48] x12
[Seq 51] x14
[#] x15

# ======================================================================
# PATTERN 5 – Bass sequence in G
# ======================================================================
y5
% 1
[Seq 43] x0
[Seq 43] x2
[Seq 50] x4
[Seq 53] x6
[Seq 43] x8
[Seq 43] x10
[Seq 50] x12
[Seq 53] x14
[#] x15

# ======================================================================
# PATTERN 6 – High stab accents
# ======================================================================
y6
% 1
[v6 n 72 l1] x0
[offS] x2
[v6 n 72 l1] x8
[offS] x10
[#] x15

# ======================================================================
# MASTER – form that follows the original’s key movement
# ======================================================================
y0
% 16

# Intro – drums + C sequence
[ /z 1 1 /z 2 1 ] x0

# Build
[ /z 6 1 ] x4

# Move to Eb
[ /z 2 0 /z 3 1 ] x8

# Move to F
[ /z 3 0 /z 4 1 ] x16

# Move to G
[ /z 4 0 /z 5 1 ] x24

# Back to C for the peak
[ /z 5 0 /z 2 1 ] x32

# Keep driving
[ /z 6 0 ] x40

# Final stretch
[ /z 2 0 /z 1 0 offB offS offP ] x48
[ /z 0 0 ] x50
