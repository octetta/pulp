# ----------------------------------------------------------------------
# Donna Summer – I Feel Love
# Live-coding / CLI / calculator-ey teaching version
# Restructured so zq quantizes to musical bars
# ----------------------------------------------------------------------
#
# HOW TO PLAY
# -----------
# 1. Load:
#      [examples/i_feel_love.sk] /ls
#
# 2. Start everything:
#      y0 z 1          # bar clock (required for zq)
#      y8 z 1          # song form
#
# 3. Live moves (type these while it runs):
#
#    PHASE-SAFE MUTE / UNMUTE
#    ------------------------
#    y1 ym 1 / y1 ym 0     # drums
#    y6 ym 1 / y6 ym 0     # stabs
#    y7 ym 1 / y7 ym 0     # pad
#
#    CLEAN SECTION CHANGE ON NEXT BAR  (zq)
#    -------------------------------------
#    Because y0 is a 16-step bar clock, zq now lands on musical bars:
#
#    y2 zq 0  y3 zq 1        # C → Eb on next bar
#    y3 zq 0  y4 zq 1        # Eb → F
#    y4 zq 0  y5 zq 1        # F → G
#    y5 zq 0  y2 zq 1        # G → C
#
#    HARD RESTART (resets phase)
#    ---------------------------
#    y2 z 0  y3 z 1
#
#    LEVEL (default master is V-20)
#    ------------------------------
#    V -26                 # drop 6 dB
#    V -20                 # restore default
#
#    SPACE
#    -----
#    DL 1 0 0 0 0 0 0      # kill delay
#    DL 1 - - 4 0 1 5      # classic delay back
#
#    HARD STOP
#    ---------
#    /z 0 0
#
# Summary:
#   ym  = mute/unmute, phase-safe
#   zq  = queue start/stop on next bar (y0 step 0)
#   z   = immediate start/stop (can reset phase)
# ----------------------------------------------------------------------

M 128 16
V -20

DT 1 115
DL 1 - - 4 0 1 5
DD 1 4 2

# ======================================================================
# K-SYNTH DRUMS
# ======================================================================
[sk/drums-kick.ks]  /ks 1 k>d d>r /r100
[sk/drums-chh.ks]   /ks 1 k>d d>r /r101
[sk/drums-ohh.ks]   /ks 1 k>d d>r /r102
[sk/drums-clap.ks]  /ks 1 k>d d>r /r103

# ======================================================================
# VOICES  (a is dB)
# ======================================================================

v 0 vt [Kick]
w100 f440 a11

v 1 vt [ClosedHat]
w101 f440 a2

v 2 vt [OpenHat]
w102 f440 a3.5

v 3 vt [Clap]
w103 f440 a4

v 4 vt [MoogBass]
w 15 a0
t 0.001 0.18 0.15 0.08
J 1 K 270 Q 1.9
N 0 0
g 0.005
H 5
G 5
r 1 ds 3

v 5 vt [MoogBassSq]
w 16 a-4
t 0.001 0.18 0.15 0.08
J 1 K 290 Q 1.7
N 0 8
g 0.005
L 0.04
r 1 ds 2

v 6 vt [HighStab]
w 15 a-2
t 0.008 0.22 0.25 0.15
J 1 K 1800 Q 1.3
N 0 0
H 8
G 8
r 1 ds 2

v 8 vt [HighStab2]
w 16 a-6
t 0.008 0.22 0.25 0.15
J 1 K 1900 Q 1.2
N 0 6
r 1 ds 2

v 7 vt [Pad]
w 15 a-8
t 1.1 1.4 0.7 2.2
J 1 K 650 Q 0.7
N 0 0
H 9
G 9
r 1 ds 4

v 9 vt [Pad2]
w 18 a-12
t 1.1 1.4 0.7 2.2
J 1 K 700 Q 0.6
N 0 -5
r 1 ds 4

# ======================================================================
# MACROS
# ======================================================================

[Seq] : v4 n $$0 l1 ;

[offB] : v4 l0 v5 l0 ;
[offS] : v6 l0 v8 l0 ;
[offP] : v7 l0 v9 l0 ;

# ======================================================================
# PATTERN 0 – Bar clock (16 steps). This is the zq quantize reference.
# ======================================================================
y0 yt [BarClock]
% 1
[#] x0
[#] x1
[#] x2
[#] x3
[#] x4
[#] x5
[#] x6
[#] x7
[#] x8
[#] x9
[#] x10
[#] x11
[#] x12
[#] x13
[#] x14
[#] x15

# ======================================================================
# PATTERN 1 – Drums
# ======================================================================
y1 yt [Drums]
% 1
[v0 l1] x0
[v1 l1] x1
[v2 l1] x2
[v1 l1] x3
[v0 l1] x4
[v1 l1] x5
[v2 l1] x6
[v1 l1] x7
[v0 l1] x8
[v1 l1] x9
[v2 l1] x10
[v1 l1] x11
[v0 l1] x12
[v1 l1] x13
[v2 l1] x14
[v1 l1] x15
[#] x15

# ======================================================================
# PATTERNS 2–5 – Bass sequences
# ======================================================================
y2 yt [BassC]
% 1
[Seq 36] x0
[Seq 36] x2
[Seq 43] x4
[Seq 46] x6
[Seq 36] x8
[Seq 36] x10
[Seq 43] x12
[Seq 46] x14
[#] x15

y3 yt [BassEb]
% 1
[Seq 39] x0
[Seq 39] x2
[Seq 46] x4
[Seq 49] x6
[Seq 39] x8
[Seq 39] x10
[Seq 46] x12
[Seq 49] x14
[#] x15

y4 yt [BassF]
% 1
[Seq 41] x0
[Seq 41] x2
[Seq 48] x4
[Seq 51] x6
[Seq 41] x8
[Seq 41] x10
[Seq 48] x12
[Seq 51] x14
[#] x15

y5 yt [BassG]
% 1
[Seq 43] x0
[Seq 43] x2
[Seq 50] x4
[Seq 53] x6
[Seq 43] x8
[Seq 43] x10
[Seq 50] x12
[Seq 53] x14
[#] x15

# ======================================================================
# PATTERN 6 – Stabs
# ======================================================================
y6 yt [Stabs]
% 1
[v6 n 72 l1] x0
[offS] x2
[v6 n 72 l1] x8
[offS] x10
[#] x15

# ======================================================================
# PATTERN 7 – Pad
# ======================================================================
y7 yt [Pad]
% 1
[v7 n 48 l1] x0
[v7 n 55 l1] x8
[#] x15

# ======================================================================
# PATTERN 8 – Song form (long arrangement)
# ======================================================================
y8 yt [Song]
% 16
[ /z 1 1 /z 2 1 ] x0                  # drums + BassC
[ /z 6 1 /z 7 1 ] x4                  # stabs + pad
[ /z 2 0 /z 3 1 ] x8                  # → Eb
[ /z 6 0 ] x12
[ /z 3 0 /z 4 1 /z 6 1 ] x16          # → F
[ /z 4 0 /z 5 1 ] x22                 # → G
[ /z 5 0 /z 2 1 ] x28                 # back to C
[ /z 6 0 /z 7 0 ] x34
[ /z 7 1 ] x40
[ /z 2 0 /z 3 1 ] x46
[ /z 3 0 /z 4 1 ] x50
[ /z 4 0 /z 5 1 ] x54
[ /z 5 0 /z 2 1 /z 6 1 ] x58          # long C outro
[ /z 6 0 /z 7 0 ] x64
[ /z 1 0 /z 2 0 offB offS offP ] x68
[ /z 0 0 ] x70
