# ======================================================================
# MINIMAL DARK SYNTH-POP (Inspired by Eurythmics)
# A Step-by-Step Live Coding Setup for Skred
# ======================================================================

# ----------------------------------------------------------------------
# STEP 1: INITIALIZATION & TEMPO
# ----------------------------------------------------------------------
M124

# Delay Bus 1: A subtle chorus/delay for the pads and high synth
DL 1 4 12 4 0 31 10 DD 1 2 DF 0 DP 0 DG 0,0

# ----------------------------------------------------------------------
# STEP 2: VOICE CONFIGURATION (THE SYNTHS & DRUMS)
# ----------------------------------------------------------------------

# DRUMS (Dry, synthetic, tight)
v 0 vt [Kick]  w 100 f 55  a 25 t 0.001 0.1 0 0     r 0 ds 0.0
v 1 vt [Snare] w 103 f 440 a 15 t 0.001 0.15 0 0 J 2 0 K 1200 Q 1.5 r 0 ds 0.0
v 2 vt [Hat]   w 101 f 440 a 4  t 0.001 0.05 0 0    r 0 ds 0.0

# BASS (Monophonic analog-style, sawtooth, fast attack, short decay)
v 3 vt [Bass]  w 1 f 440 a 8  t 0.001 0.15 0.1 0.1 J 1 0 K 800 Q 1.5 r 0 ds 0.0

# PAD SYNTH (Polyphonic, 3 oscillators for the triad chords, detuned sawtooth)
# Attack 100ms, Release 500ms
v 4 vt [Pad1]  w 1 f 440 a 4  t 0.1 0.1 0.8 0.5 J 1 0 K 1500 Q 1.0 r 1 ds 0.5
v 5 vt [Pad2]  w 1 f 442 a 4  t 0.1 0.1 0.8 0.5 J 1 0 K 1500 Q 1.0 r 1 ds 0.5
v 6 vt [Pad3]  w 1 f 438 a 4  t 0.1 0.1 0.8 0.5 J 1 0 K 1500 Q 1.0 r 1 ds 0.5

# HIGH SYNTH (Bright pulse wave, moderate resonance)
v 7 vt [High]  w 2 f 440 a 5  t 0.01 0.1 0.2 0.2 J 1 0 K 2500 Q 2.0 r 1 ds 0.3

# ----------------------------------------------------------------------
# STEP 3: MACRO DEFINITIONS (Max 4 chars)
# ----------------------------------------------------------------------
[Kik] : v 0 l 1 ;
[Snr] : v 1 l 1 ;
[Hat] : v 2 l 1 ;
[Bas] : v 3 n $$0 l 1 ;
[Pad] : v 4 n $$0 l 1   v 5 n $$1 l 1   v 6 n $$2 l 1 ;
[Hgh] : v 7 n $$0 l 1 ;

# ----------------------------------------------------------------------
# STEP 4: SEQUENCING THE PATTERNS
# ----------------------------------------------------------------------
y 0 yt [BarClock]
% 16
[#] x 15

# --- DRUMS (1-bar loop, 16th notes) ---
# Kick on 1,2,3,4. Snare on 2,4. Hats on 8th notes.
y 2 yt [Drums]
% 1
[Kik Hat] x 0   [Hat] x 2
[Kik Snr Hat] x 4   [Hat] x 6
[Kik Hat] x 8   [Hat] x 10
[Kik Snr Hat] x 12  [Hat] x 14

# --- BASS (2-bar loop, split into Bar 1 and Bar 2) ---
y 3 yt [Bass1]
% 1
[Bas 33] x 0   [Bas 33] x 3   [Bas 40] x 5   [Bas 36] x 8   [Bas 33] x 10

y 4 yt [Bass2]
% 1
[Bas 33] x 0   [Bas 36] x 2   [Bas 40] x 6   [Bas 38] x 8   [Bas 33] x 11

# --- PADS (4-bar harmonic cycle) ---
# % 16 means 1 step = 1 whole bar! So a 4-step sequence covers 4 bars.
y 5 yt [Pads]
% 16
[Pad 57 60 64] x 0  # A minor
[Pad 53 57 60] x 1  # F major
[Pad 48 52 55] x 2  # C major
[Pad 55 59 62] x 3  # G major

# --- HIGH SYNTH (2-bar phrase, split into Bar 1 and Bar 2) ---
y 6 yt [High1]
% 1
[Hgh 76] x 8   [Hgh 79] x 10  [Hgh 81] x 12

y 7 yt [High2]
% 1
[Hgh 79] x 4   [Hgh 76] x 6   [Hgh 72] x 10


# ----------------------------------------------------------------------
# STEP 5: THE ORCHESTRATOR
# ----------------------------------------------------------------------
# In this generic track, we'll build it up block by block manually!
# But we'll provide the Master Arranger for convenience.
y 1 yt [Arranger]
% 16
# Start Bass 1
[ /z 3 1 Bas 33 ] x 0
# Alternate Bass 2
[ /z 4 1 Bas 33 ] x 1
[ /z 3 1 Bas 33 ] x 2
[ /z 4 1 Bas 33 ] x 3
# Introduce Drums on Bar 5
[ /z 3 1 /z 2 1 Bas 33 Kik Hat ] x 4
[ /z 4 1 Bas 33 ] x 5
[ /z 3 1 Bas 33 ] x 6
[ /z 4 1 Bas 33 ] x 7
# Introduce Pads on Bar 9 (Note: Pads sequence takes care of the 4-bar loop!)
[ /z 3 1 /z 5 1 Bas 33 Pad 57 60 64 ] x 8
[ /z 4 1 Bas 33 ] x 9
[ /z 3 1 Bas 33 ] x 10
[ /z 4 1 Bas 33 ] x 11
# Introduce High Synth on Bar 13
[ /z 3 1 /z 6 1 Bas 33 ] x 12
[ /z 4 1 /z 7 1 Bas 33 ] x 13
[ /z 3 1 /z 6 1 Bas 33 ] x 14
[ /z 4 1 /z 7 1 Bas 33 ] x 15

# Safe comment padding for wrap-around
[#] x 63

# ----------------------------------------------------------------------
# STEP 6: LIVE PERFORMANCE GUIDE
# ----------------------------------------------------------------------
# 1. Start the Master Clock:  y 0 z 1
# 2. Drop the Arranger:       y 1 z 1
# 3. Stop everything:         /z 1 0 /z 2 0 /z 3 0 /z 4 0 /z 5 0 /z 6 0 /z 7 0
