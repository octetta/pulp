# ----------------------------------------------------------------------
# Music for the Funeral of Queen Mary (Wendy Carlos / Clockwork Orange style)
# Structural Sequencer Demonstration with Musical Notes
# ----------------------------------------------------------------------

# ======================================================================
# VOICE SETUPS (Placeholders)
# ======================================================================
# Voice 0: Timpani (Percussive, low, thudding)
# Voice 1: Brass Soprano (Main melody)
# Voice 2: Brass Alto    (Harmony)
# Voice 3: Brass Tenor   (Harmony)
# Voice 4: Brass Bass    (Deep foundation)

# Initialize Timpani (Voice 0)
v 0 
a 1
t 0.01 0.4 0 0 

# Initialize Brass Ensemble (Voices 1-4)
[bras] : v $$0 a 0.6 t 0.1 0.1 0.8 0.4 ;
1 bras
2 bras
3 bras
4 bras

# ======================================================================
# THE SCORE (Pattern 1)
# ======================================================================
y1
z%2      # 1 step = 8th note (to give us some rhythmic grid)

# --- TIMPANI INTRO (2 Bars: Steps 0-15) ---
[ v 0 n 36 l 1 ] x 0
[ v 0 n 36 l 1 ] x 3
[ v 0 n 36 l 1 ] x 4
[ v 0 n 36 l 1 ] x 5
[ v 0 n 36 l 1 ] x 8
[ v 0 n 36 l 1 ] x 11
[ v 0 n 36 l 1 ] x 12
[ v 0 n 36 l 1 ] x 13

# Loop Intro 2 times (using variable 1)
[ /zl 1 2 0 ] x 15


# --- THEME A (4 Bars: Steps 16-47) ---
# Bar 1
[ v 1 n 67 l 1   v 4 n 48 l 1 ] x 16
[ v 1 n 67 l 1 ] x 20
[ v 1 n 67 l 1 ] x 22

# Bar 2
[ v 1 n 67 l 1   v 4 n 48 l 1 ] x 24
[ v 1 n 68 l 1 ] x 27
[ v 1 n 67 l 1 ] x 28

# Bar 3
[ v 1 n 65 l 1   v 4 n 41 l 1 ] x 32
[ v 1 n 63 l 1 ] x 34
[ v 1 n 62 l 1   v 4 n 43 l 1 ] x 36

# Bar 4
[ v 1 n 63 l 1   v 4 n 48 l 1 ] x 40

# Loop Theme A 2 times (using variable 2)
[ /zl 2 2 16 ] x 47


# --- THEME B (4 Bars: Steps 48-79) ---
# (Placeholder for Theme B descending melody)
[ v 1 n 62 l 1 ] x 48

# Loop Theme B 2 times (using variable 3)
[ /zl 3 2 48 ] x 79


# --- TIMPANI OUTRO (2 Bars: Steps 80-95) ---
[ v 0 n 36 l 1 ] x 80
[ v 0 n 36 l 1 ] x 83
[ v 0 n 36 l 1 ] x 84
[ v 0 n 36 l 1 ] x 85
[ v 0 n 36 l 1 ] x 88
[ v 0 n 36 l 1 ] x 91
[ v 0 n 36 l 1 ] x 92
[ v 0 n 36 l 1 ] x 93

# Stop pattern at the end
[ /z 1 0 ] x 95

