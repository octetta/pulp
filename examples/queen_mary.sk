# ======================================================================
# MASTER ORCHESTRATOR (Pattern 0)
# Section A = 48 steps, Section B = 72 steps
# Master modulo: 48 steps (= 8 bars)
# ======================================================================
y0
48 %

[ /z 1 1 ] x 0              # t=0: Timpani solo (2 bars intro, looping)
[ /z 2 1 ] x 1              # t=8bar: Section A pass 1 starts
[ /z 2 0   /z 2 1 ] x 2     # t=16bar: Section A pass 2 (Da Capo A)
[ /z 2 0   /z 3 1 ] x 3     # t=24bar: Section B starts (72 steps = 1.5 master steps)
[ /z 3 0   /z 3 1 ] x 5     # t=40bar: Section B pass 2
[ /z 3 0   /z 1 0   off ] x 7  # t=56bar: End - stop all, release voices
[ /z 0 0 ] x 8

