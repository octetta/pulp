# ----------------------------------------------------------------------
# Purcell - Music for the Funeral of Queen Mary (Wendy Carlos Moog style)
# Notes sourced directly from: classclef.com MIDI file (E minor / 6/8 / d.=40)
# Form: Section A (8 bars) + Section B (12 bars), Da Capo
# 1 step = 1 eighth note  |  6 steps = 1 bar
# ----------------------------------------------------------------------

M 40  # dotted-quarter = 40 BPM (6/8 feel)

# ======================================================================
# VOICE SETUPS
# ======================================================================

# Delay / Reverb on Track 1
DL 1,6,8,15,0,31,10

# --- Timpani (Voice 0) ---
v 0
w 1
a 0.9
t 0.01 0.5 0 0
J 1
K 80
Q 2.0
ft 0.01 0.2 0 0
fd 600

# --- Brass voices (1-4): Sawtooth, resonant LP filter ---
[bras] : v $$0 w 2 a 0.4 t 0.02 0.15 0.75 0.12 J 1 K 1400 Q 1.8 ;
1 bras
2 bras
3 bras
4 bras

# Subtle inter-voice detuning (Carlos "thick" unison sound)
v 1 N 0  0
v 2 N 0  6
v 3 N 0 -6
v 4 N 0 -3

# Route to delay
v 1 p 0 r 1 ds 8
v 2 p 0 r 1 ds 8
v 3 p 0 r 1 ds 8
v 4 p 0 r 1 ds 8

# ======================================================================
# MACROS
# ======================================================================

# Timpani: pitch sweep (glides from C3+12 down to C3 over 80ms)
[Tlow] : v 0 g 0 n 60 g 0.08 n 48 l 1 ;  # C3
[Thig] : v 0 g 0 n 67 g 0.08 n 55 l 1 ;  # G3

[off] : v 1 l 0  v 2 l 0  v 3 l 0  v 4 l 0 ;

# SECTION A CHORDS
# (V1=Soprano/Lead, V2=Alto, V3=Tenor, V4=Bass)
# Harmony derived from guitar MIDI chord structure, transposed to 4-voice homophony.
# Bar 1: E minor - melody E4=64
[SAa] : v 1 n 64 l 1  v 2 n 59 l 1  v 3 n 52 l 1  v 4 n 40 l 1 ; # Em: E4 B3 E3 E2
# Bar 2 beat1: F over D - melody F4=65
[SAb] : v 1 n 65 l 1  v 2 n 57 l 1  v 3 n 53 l 1  v 4 n 50 l 1 ; # D7: F4 A3 F3 D3
# Bar 2 beat2: F over A - melody F4=65
[SAc] : v 1 n 65 l 1  v 2 n 57 l 1  v 3 n 52 l 1  v 4 n 45 l 1 ; # Am: F4 A3 E3 A2
# Bar 3: E minor - melody E4=64
[SAd] : v 1 n 64 l 1  v 2 n 59 l 1  v 3 n 52 l 1  v 4 n 49 l 1 ; # Em/C#: E4 B3 E3 C#3
# Bar 4 beat1: A minor - melody E4=64
[SAe] : v 1 n 64 l 1  v 2 n 57 l 1  v 3 n 52 l 1  v 4 n 45 l 1 ; # Am: E4 A3 E3 A2
# Bar 4 beat2: A - melody A4=69
[SAf] : v 1 n 69 l 1  v 2 n 64 l 1  v 3 n 57 l 1  v 4 n 45 l 1 ; # A: A4 E4 A3 A2
# Bar 5 beat1: C major - melody C4=60
[SAg] : v 1 n 60 l 1  v 2 n 55 l 1  v 3 n 52 l 1  v 4 n 48 l 1 ; # C: C4 G3 E3 C3
# Bar 5 beat2: C major - melody C4=60
[SAh] : v 1 n 60 l 1  v 2 n 55 l 1  v 3 n 52 l 1  v 4 n 48 l 1 ; # C: C4 G3 E3 C3
# Bar 6 beat1: F over F - melody A4=69
[SAi] : v 1 n 69 l 1  v 2 n 65 l 1  v 3 n 57 l 1  v 4 n 41 l 1 ; # F: A4 F4 A3 F2
# Bar 6 beat2: F over F3 - melody A4=69
[SAj] : v 1 n 69 l 1  v 2 n 65 l 1  v 3 n 57 l 1  v 4 n 53 l 1 ; # F/F3: A4 F4 A3 F3
# Bar 7: Ab/E - melody Ab4=68
[SAk] : v 1 n 68 l 1  v 2 n 64 l 1  v 3 n 59 l 1  v 4 n 52 l 1 ; # E aug: Ab4 E4 B3 E3
# Bar 8 beat1: E/Ab - melody Ab4=68
[SAl] : v 1 n 68 l 1  v 2 n 64 l 1  v 3 n 59 l 1  v 4 n 52 l 1 ; # E aug: Ab4 E4 B3 E3
# Bar 8 beat2: E/F# - melody A4=69
[SAm] : v 1 n 69 l 1  v 2 n 64 l 1  v 3 n 59 l 1  v 4 n 54 l 1 ; # E/F#: A4 E4 B3 F#3

# SECTION B CHORDS
# Bar 9: E/G - melody B4=71
[SBa] : v 1 n 71 l 1  v 2 n 67 l 1  v 3 n 59 l 1  v 4 n 55 l 1 ; # Em/G: B4 G4 B3 G3
# Bar 10 beat1: A - melody A4=69
[SBb] : v 1 n 69 l 1  v 2 n 64 l 1  v 3 n 57 l 1  v 4 n 45 l 1 ; # A: A4 E4 A3 A2
# Bar 10 beat2: D/B - melody F#4=66
[SBc] : v 1 n 66 l 1  v 2 n 62 l 1  v 3 n 57 l 1  v 4 n 47 l 1 ; # Bm: F#4 D4 A3 B2
# Bar 11: E/E - melody G4=67
[SBd] : v 1 n 67 l 1  v 2 n 64 l 1  v 3 n 59 l 1  v 4 n 40 l 1 ; # Em low: G4 E4 B3 E2
# Bar 12 beat1: C - melody E4=64
[SBe] : v 1 n 64 l 1  v 2 n 60 l 1  v 3 n 55 l 1  v 4 n 48 l 1 ; # C: E4 C4 G3 C3
# Bar 12 beat2: G/D - melody B3=59
[SBf] : v 1 n 59 l 1  v 2 n 55 l 1  v 3 n 50 l 1  v 4 n 50 l 1 ; # G/D: B3 G3 D3 D3
# Bar 13: C - melody G4=67
[SBg] : v 1 n 67 l 1  v 2 n 64 l 1  v 3 n 60 l 1  v 4 n 48 l 1 ; # C: G4 E4 C4 C3
# Bar 14 beat1: F - melody F4=65
[SBh] : v 1 n 65 l 1  v 2 n 60 l 1  v 3 n 57 l 1  v 4 n 41 l 1 ; # F: F4 C4 A3 F2
# Bar 14 beat2: G - melody D4=62
[SBi] : v 1 n 62 l 1  v 2 n 59 l 1  v 3 n 55 l 1  v 4 n 43 l 1 ; # G: D4 B3 G3 G2
# Bar 15: C - melody E4=64
[SBj] : v 1 n 64 l 1  v 2 n 60 l 1  v 3 n 55 l 1  v 4 n 48 l 1 ; # C: E4 C4 G3 C3
# Bar 16 beat1: C - melody E4=64
[SBk] : v 1 n 64 l 1  v 2 n 60 l 1  v 3 n 55 l 1  v 4 n 48 l 1 ; # C: E4 C4 G3 C3
# Bar 16 beat2: G - melody G4=67
[SBl] : v 1 n 67 l 1  v 2 n 62 l 1  v 3 n 59 l 1  v 4 n 43 l 1 ; # G: G4 D4 B3 G2
# Bar 17: A minor - melody A4=69
[SBm] : v 1 n 69 l 1  v 2 n 64 l 1  v 3 n 57 l 1  v 4 n 45 l 1 ; # Am: A4 E4 A3 A2
# Bar 18 beat1: D minor - melody A4=69
[SBn] : v 1 n 69 l 1  v 2 n 65 l 1  v 3 n 57 l 1  v 4 n 50 l 1 ; # Dm: A4 F4 A3 D3
# Bar 18 beat2: Abdim/E - melody Ab4=68
[SBo] : v 1 n 68 l 1  v 2 n 62 l 1  v 3 n 59 l 1  v 4 n 52 l 1 ; # E7: Ab4 D4 B3 E3
# Bar 19: A minor - melody A4=69
[SBp] : v 1 n 69 l 1  v 2 n 64 l 1  v 3 n 57 l 1  v 4 n 45 l 1 ; # Am: A4 E4 A3 A2
# Bar 20 beat1: D/D - melody D4=62
[SBq] : v 1 n 62 l 1  v 2 n 57 l 1  v 3 n 53 l 1  v 4 n 50 l 1 ; # Dm: D4 A3 F3 D3
# Bar 20 beat2: E - melody E4=64
[SBr] : v 1 n 64 l 1  v 2 n 59 l 1  v 3 n 52 l 1  v 4 n 40 l 1 ; # Em: E4 B3 E3 E2


# ======================================================================
# PATTERN 1: TIMPANI (2 bars = 12 steps, loops)
# ======================================================================
y1
1 %   # 1 step = 1 eighth note

# Bar 1: steady march pulse (dotted-8th+16th pairs approximated as 8th beats)
[ Tlow ] x 0
[ Tlow ] x 2
[ Tlow ] x 4
# Bar 2: cadence with G accent
[ Tlow ] x 6
[ Tlow ] x 8
[ Thig ] x 10
[ ] x 11


# ======================================================================
# PATTERN 2: SECTION A (8 bars = 48 steps)
# ======================================================================
y2
1 %

# Bar 1 (step 0-5): E minor whole bar
[ SAa ] x 0
[ off ] x 5

