# ----------------------------------------------------------------------
# Purcell - Music for the Funeral of Queen Mary (Wendy Carlos Moog Emulation)
# ----------------------------------------------------------------------

M 50  # Slow, heavy dirge

# ======================================================================
# VOICE SETUPS
# ======================================================================

# Timpani (Voice 0) 
v 0 
w 1              # Triangle Wave
a 1.0            # Volume
t 0.01 0.6 0 0   # ADSR: Fast attack, 600ms decay, no sustain
J 1              # Low-pass filter
K 60             # Base cutoff
Q 1.5            # Slight resonance
ft 0.01 0.3 0 0  # Filter ADSR
fd 400           # Filter sweep depth

# Brass Voices (Voices 1, 2, 3, 4)
# 4 separate voices playing 4-part classical harmony with authentic Carlos tone.
# 24dB resonant lowpass filter (~1.2kHz cutoff), subtle inter-voice detune (+-5 cents).
[bras] : v $$0 w 2 a 0.5 t 0.02 0.1 0.8 0.1 J 1 K 1200 Q 2 ;
1 bras
2 bras
3 bras
4 bras

v 1 N 0  0
v 2 N 0  5
v 3 N 0 -5
v 4 N 0 -3


# ======================================================================
# MACROS
# ======================================================================

# Timpani Fake Pitch Envelope (Glides instantly down 12 semitones in 60ms)
[Tlow] : v 0 g 0 n 48 g 0.06 n 36 l 1 ;
[Thig] : v 0 g 0 n 55 g 0.06 n 43 l 1 ;

# Note Off Macro
[off] : v 1 l 0  v 2 l 0  v 3 l 0  v 4 l 0 ;

# SECTION A CHORDS
[Aone] : v 1 n 72 l 1  v 2 n 67 l 1  v 3 n 63 l 1  v 4 n 48 l 1 ;
[Atwo] : v 1 n 72 l 1  v 2 n 67 l 1  v 3 n 63 l 1  v 4 n 48 l 1 ;
[Athr] : v 1 n 72 l 1  v 2 n 67 l 1  v 3 n 63 l 1  v 4 n 48 l 1 ;
[Afou] : v 1 n 74 l 1  v 2 n 67 l 1  v 3 n 62 l 1  v 4 n 47 l 1 ;
[Afiv] : v 1 n 75 l 1  v 2 n 67 l 1  v 3 n 60 l 1  v 4 n 48 l 1 ;
[Asix] : v 1 n 74 l 1  v 2 n 65 l 1  v 3 n 62 l 1  v 4 n 47 l 1 ;
[Asev] : v 1 n 72 l 1  v 2 n 63 l 1  v 3 n 63 l 1  v 4 n 48 l 1 ;
[Aeig] : v 1 n 71 l 1  v 2 n 65 l 1  v 3 n 62 l 1  v 4 n 50 l 1 ;
[Anin] : v 1 n 72 l 1  v 2 n 67 l 1  v 3 n 63 l 1  v 4 n 51 l 1 ;
[Aten] : v 1 n 74 l 1  v 2 n 67 l 1  v 3 n 62 l 1  v 4 n 43 l 1 ;
[Aelv] : v 1 n 74 l 1  v 2 n 66 l 1  v 3 n 60 l 1  v 4 n 50 l 1 ;
[Atwv] : v 1 n 67 l 1  v 2 n 67 l 1  v 3 n 59 l 1  v 4 n 43 l 1 ;

# SECTION B CHORDS
[Bone] : v 1 n 75 l 1  v 2 n 67 l 1  v 3 n 60 l 1  v 4 n 48 l 1 ;
[Btwo] : v 1 n 75 l 1  v 2 n 67 l 1  v 3 n 60 l 1  v 4 n 48 l 1 ;
[Bthr] : v 1 n 75 l 1  v 2 n 72 l 1  v 3 n 67 l 1  v 4 n 48 l 1 ;
