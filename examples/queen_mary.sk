# ----------------------------------------------------------------------
# Music for the Funeral of Queen Mary (Wendy Carlos / Clockwork Orange style)
# ----------------------------------------------------------------------

M 60  # Set tempo to 60 BPM for a proper, heavy dirge pace

# ======================================================================
# VOICE SETUPS
# ======================================================================

# Timpani (Voice 0) 
v 0 
w 1              # Triangle Wave
a 1.0            # Volume
t 0.01 0.6 0 0   # ADSR: Fast attack, 600ms decay, no sustain
J 1              # Low-pass filter
K 60             # Base cutoff (very low for a dull thud)
Q 1.5            # Slight resonance for drum body
ft 0.01 0.3 0 0  # Filter ADSR: Snaps closed quickly
fd 400           # Filter envelope sweeps down from +400Hz to simulate mallet strike

# THE LEAD (Voices 1, 2, and 3)
v 1 
( 2 3 ) G  # Link MIDI pitches
( 2 3 ) H  # Link Envelope triggers

v 2 ( -12 -8 ) N  # Octave down, flat
v 3 ( -12  8 ) N  # Octave down, sharp
v 1 N 0 0         # Unison

[lead] : v $$0 w 2 a 0.5 t 0.1 0.1 0.8 0.4 g 0.05 J 1 K 100 Q 2.5 ft 0.3 0.2 0.5 0.5 fd 1800 ;
1 lead
2 lead
3 lead

# THE CHOIR (Voices 4, 5, 6, and 7)
[choi] : v $$0 w 1 a 0.2 t 0.4 0.1 0.8 0.5 J 1 K 600 Q 0 ;
4 choi
5 choi
6 choi
7 choi


# ======================================================================
# CHORD MACROS (Corrected Melody!)
# ======================================================================
# v4=Bass, v5=Tenor, v6=Alto, v7=Soprano, v1=Lead (Linked to v2, v3)

# Theme A Chords
[CmC]  : v 4 n 48 l 1  v 5 n 55 l 1  v 6 n 63 l 1  v 7 n 72 l 1  v 1 n 72 l 1 ; # Cmin (C5 melody)
[CmEb] : v 4 n 48 l 1  v 5 n 55 l 1  v 6 n 60 l 1  v 7 n 75 l 1  v 1 n 75 l 1 ; # Cmin (Eb5 melody)
[GmaD] : v 4 n 43 l 1  v 5 n 50 l 1  v 6 n 59 l 1  v 7 n 74 l 1  v 1 n 74 l 1 ; # Gmaj (D5 melody)
[FmF]  : v 4 n 41 l 1  v 5 n 48 l 1  v 6 n 56 l 1  v 7 n 77 l 1  v 1 n 77 l 1 ; # Fmin (F5 melody)
[CmC2] : v 4 n 36 l 1  v 5 n 55 l 1  v 6 n 63 l 1  v 7 n 72 l 1  v 1 n 72 l 1 ; # Cmin (Low Bass, C5 melody)

# Theme B Chords
[EbEb] : v 4 n 51 l 1  v 5 n 58 l 1  v 6 n 67 l 1  v 7 n 75 l 1  v 1 n 75 l 1 ; # Ebmaj (Eb5 melody)
[BbF]  : v 4 n 46 l 1  v 5 n 53 l 1  v 6 n 62 l 1  v 7 n 77 l 1  v 1 n 77 l 1 ; # Bbmaj (F5 melody)
[EbG]  : v 4 n 51 l 1  v 5 n 58 l 1  v 6 n 63 l 1  v 7 n 79 l 1  v 1 n 79 l 1 ; # Ebmaj (G5 melody)
[EbE2] : v 4 n 39 l 1  v 5 n 58 l 1  v 6 n 67 l 1  v 7 n 75 l 1  v 1 n 75 l 1 ; # Ebmaj (Low Bass, Eb5 melody)

[off]  : v 7 l 0  v 6 l 0  v 5 l 0  v 4 l 0  v 1 l 0 ; # Releases all voices


# ======================================================================
# PATTERN 1: TIMPANI INTRO/OUTRO (2 Bars = 32 steps)
# ======================================================================
y1
1 %      

[ v 0 n 36 l 1 ] x 0
[ v 0 n 36 l 1 ] x 8
[ v 0 n 36 l 1 ] x 14
[ v 0 n 36 l 1 ] x 16
[ v 0 n 36 l 1 ] x 24
[ v 0 n 36 l 1 ] x 30
[ ] x 31  


# ======================================================================
# PATTERN 2: THEME A (4 Bars = 64 steps)
# ======================================================================
y2
1 %      

# Bar 1 (C half, C quarter, C quarter)
[ CmC ] x 0
[ off ] x 7
[ CmC ] x 8
[ off ] x 11
[ CmC ] x 12
[ off ] x 15

# Bar 2 (Eb dotted-quarter, D eighth, C half)
[ CmEb ] x 16
[ GmaD ] x 22
[ CmC ] x 24
[ off ] x 31

# Bar 3 (F quarter, Eb quarter, D half)
[ FmF ] x 32
[ off ] x 35
[ CmEb ] x 36
[ off ] x 39
[ GmaD ] x 40
[ off ] x 47

# Bar 4 (C whole)
[ CmC2 ] x 48
[ off ] x 62


# ======================================================================
# PATTERN 3: THEME B (4 Bars = 64 steps)
# ======================================================================
y3
1 %

# Bar 1 (Eb half, Eb quarter, Eb quarter)
[ EbEb ] x 0
[ off ] x 7
[ EbEb ] x 8
[ off ] x 11
[ EbEb ] x 12
[ off ] x 15

# Bar 2 (Eb dotted-quarter, F eighth, G half)
[ EbEb ] x 16
[ BbF ] x 22
[ EbG ] x 24
[ off ] x 31

# Bar 3 (F quarter, Eb quarter, D half)
[ BbF ] x 32
[ off ] x 35
[ CmEb ] x 36
[ off ] x 39
[ GmaD ] x 40
[ off ] x 47

# Bar 4 (Eb whole)
[ EbE2 ] x 48
[ off ] x 62


# ======================================================================
# MASTER ORCHESTRATOR (Pattern 0)
# ======================================================================
y0
32 %   

[ /z 1 1 ] x 0                 
[ /z 1 0   /z 2 1 ] x 1        
[ /z 2 0   /z 2 1 ] x 3        
[ /z 2 0   /z 3 1 ] x 5        
[ /z 3 0   /z 3 1 ] x 7        
[ /z 3 0   /z 1 1 ] x 9        
[ /z 1 0   /z 2 1 ] x 10       
[ /z 2 0   /z 3 1 ] x 12       
[ /z 3 0   /z 1 1 ] x 14       
[ /z 1 0   /z 0 0 ] x 15       

