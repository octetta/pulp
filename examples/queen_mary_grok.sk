# ----------------------------------------------------------------------
# Purcell – Music for the Funeral of Queen Mary
# Wendy Carlos / A Clockwork Orange style
#
# Source: classclef.com MIDI + PDF (E minor, 6/8, dotted-quarter = 40)
# Form: Intro (timpani) → Section A ×2 → Section B ×2
#
# 1 step = 1 eighth note | 6 steps = 1 bar of 6/8
# ----------------------------------------------------------------------

M 60 8

# Delay – moderate time, controlled feedback, light modulation
# (user-tuned: DL1,6,8,7,0,4,7)
DL 1 6 8 7 0 4 7
DD 1 11 5

# --- Timpani (Voice 0) ---
v 0
w 1 a 0.82
t 0.005 1.5 0 0.4
J 1 K 65 Q 1.7
ft 0.008 0.22 0 0
fd 500

# --- Brass Ensemble (Voices 1–4) ---
# DW-8000 wave + resonant low-pass, subtle detune, small attack stagger
[bras] : v $$0 w 18 a 0.36 t 0.05 0.22 0.70 0.50 J 1 K 1050 Q 1.6 ;
1 bras
2 bras
3 bras
4 bras

v 1 N 0 0
v 2 N 0 6
v 3 N 0 -5
v 4 N 0 -2

v 1 g 0.045
v 2 g 0.05
v 3 g 0.04
v 4 g 0.055

# Small attack delays so the chord blooms
v 1 L 0.00
v 2 L 0.012
v 3 L 0.025
v 4 L 0.008

v 1 p 0 r 1 ds 5
v 2 p 0 r 1 ds 5
v 3 p 0 r 1 ds 5
v 4 p 0 r 1 ds 5

# Prime pitches (required for glide)
v 0 n 36
v 1 n 64
v 2 n 59
v 3 n 52
v 4 n 40

# --- Macros ---
[Tx]  : v0 g0 n $$0 l1  v0 g.04 n $$1 ;
[Tlow]: Tx 41 36 ;
[Thig]: Tx 46 41 ;

[off] : v1 l0 v2 l0 v3 l0 v4 l0 ;

# Section A chords
[SAa] : v1 n64 l1 v2 n59 l1 v3 n52 l1 v4 n40 l1 ;  # Em
[SAb] : v1 n65 l1 v2 n57 l1 v3 n53 l1 v4 n50 l1 ;  # D7
[SAc] : v1 n65 l1 v2 n57 l1 v3 n52 l1 v4 n45 l1 ;  # Am
[SAd] : v1 n64 l1 v2 n59 l1 v3 n52 l1 v4 n49 l1 ;  # Em/C#
[SAe] : v1 n64 l1 v2 n57 l1 v3 n52 l1 v4 n45 l1 ;  # Am
[SAf] : v1 n69 l1 v2 n64 l1 v3 n57 l1 v4 n45 l1 ;  # A
[SAg] : v1 n60 l1 v2 n55 l1 v3 n52 l1 v4 n48 l1 ;  # C
[SAh] : v1 n60 l1 v2 n55 l1 v3 n52 l1 v4 n48 l1 ;  # C
[SAi] : v1 n69 l1 v2 n65 l1 v3 n57 l1 v4 n41 l1 ;  # F
[SAj] : v1 n69 l1 v2 n65 l1 v3 n57 l1 v4 n53 l1 ;  # F/F3
[SAk] : v1 n68 l1 v2 n64 l1 v3 n59 l1 v4 n52 l1 ;  # Eaug
[SAl] : v1 n68 l1 v2 n64 l1 v3 n59 l1 v4 n52 l1 ;  # Eaug
[SAm] : v1 n69 l1 v2 n64 l1 v3 n59 l1 v4 n54 l1 ;  # E/F#

# Section B chords
[SBa] : v1 n71 l1 v2 n67 l1 v3 n59 l1 v4 n55 l1 ;  # Em/G
[SBb] : v1 n69 l1 v2 n64 l1 v3 n57 l1 v4 n45 l1 ;  # A
[SBc] : v1 n66 l1 v2 n62 l1 v3 n57 l1 v4 n47 l1 ;  # Bm
[SBd] : v1 n67 l1 v2 n64 l1 v3 n59 l1 v4 n40 l1 ;  # Em low
[SBe] : v1 n64 l1 v2 n60 l1 v3 n55 l1 v4 n48 l1 ;  # C
[SBf] : v1 n59 l1 v2 n55 l1 v3 n50 l1 v4 n50 l1 ;  # G/D
[SBg] : v1 n67 l1 v2 n64 l1 v3 n60 l1 v4 n48 l1 ;  # C
[SBh] : v1 n65 l1 v2 n60 l1 v3 n57 l1 v4 n41 l1 ;  # F
[SBi] : v1 n62 l1 v2 n59 l1 v3 n55 l1 v4 n43 l1 ;  # G
[SBj] : v1 n64 l1 v2 n60 l1 v3 n55 l1 v4 n48 l1 ;  # C
[SBk] : v1 n64 l1 v2 n60 l1 v3 n55 l1 v4 n48 l1 ;  # C
[SBl] : v1 n67 l1 v2 n62 l1 v3 n59 l1 v4 n43 l1 ;  # G
[SBm] : v1 n69 l1 v2 n64 l1 v3 n57 l1 v4 n45 l1 ;  # Am
[SBn] : v1 n69 l1 v2 n65 l1 v3 n57 l1 v4 n50 l1 ;  # Dm
[SBo] : v1 n68 l1 v2 n62 l1 v3 n59 l1 v4 n52 l1 ;  # E7
[SBp] : v1 n69 l1 v2 n64 l1 v3 n57 l1 v4 n45 l1 ;  # Am
[SBq] : v1 n62 l1 v2 n57 l1 v3 n53 l1 v4 n50 l1 ;  # Dm
[SBr] : v1 n64 l1 v2 n59 l1 v3 n52 l1 v4 n40 l1 ;  # Em final

# ======================================================================
# PATTERN 1 – Timpani (6 steps = 1 bar of 6/8)
# Hits on the two dotted-quarter beats
# ======================================================================
y1
% 1
[Tlow] x0
[] x1
[] x2
[Tlow] x3
[] x4
[#] x5

# ======================================================================
# PATTERN 2 – Section A (48 steps = 8 bars)
# ======================================================================
y2
% 1
[SAa] x0
[off] x5
[SAb] x6
[off] x8
[SAc] x9
[off] x11
[SAd] x12
[off] x17
[SAe] x18
[off] x20
[SAf] x21
[off] x23
[SAg] x24
[off] x26
[SAh] x27
[off] x29
[SAi] x30
[off] x32
[SAj] x33
[off] x35
[SAk] x36
[off] x41
[SAl] x42
[off] x44
[SAm] x45
[off] x47

# ======================================================================
# PATTERN 3 – Section B (72 steps = 12 bars)
# ======================================================================
y3
% 1
[SBa] x0
[off] x5
[SBb] x6
[off] x8
[SBc] x9
[off] x11
[SBd] x12
[off] x17
[SBe] x18
[off] x20
[SBf] x21
[off] x23
[SBg] x24
[off] x29
[SBh] x30
[off] x32
[SBi] x33
[off] x35
[SBj] x36
[off] x41
[SBk] x42
[off] x44
[SBl] x45
[off] x47
[SBm] x48
[off] x53
[SBn] x54
[off] x56
[SBo] x57
[off] x59
[SBp] x60
[off] x65
[SBq] x66
[off] x68
[SBr] x69
[off] x71

# ======================================================================
# MASTER ORCHESTRATOR (Pattern 0)
# 12 % → each master step = 2 bars
# ======================================================================
y0
% 12
[ /z 1 1 ] x0               # Timpani solo intro
[ /z 2 1 ] x1               # Section A pass 1
[ /z 2 0 /z 2 1 ] x5        # Section A pass 2
[ /z 2 0 /z 3 1 ] x9        # Section B pass 1
[ /z 3 0 /z 3 1 ] x15       # Section B pass 2
[ /z 3 0 /z 1 0 off ] x21   # Stop all + release
[ /z 0 0 ] x22              # Stop master
