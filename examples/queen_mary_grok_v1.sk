# ----------------------------------------------------------------------
# Purcell – Music for the Funeral of Queen Mary
# Wendy Carlos style – correct % syntax + trailing step fix
# ----------------------------------------------------------------------

M 60 8

# Delay
DT 1 300
DL 1 - - 8 1 6 10
DD 1 8 3

# --- Timpani ---
v 0
w 1 a 0.95
t 0.004 1.6 0 0.35
J 1 K 85 Q 2.0
ft 0.006 0.22 0 0
fd 600

# --- Brass ---
[bras] : v $$0 w 2 a 0.40 t 0.03 0.16 0.75 0.30 J 1 K 1280 Q 1.9 ;
1 bras
2 bras
3 bras
4 bras

v 1 N 0 0
v 2 N 0 8
v 3 N 0 -7
v 4 N 0 -3

v 1 g 0.03
v 2 g 0.035
v 3 g 0.025
v 4 g 0.04

v 1 p 0 r 1 ds 7
v 2 p 0 r 1 ds 7
v 3 p 0 r 1 ds 7
v 4 p 0 r 1 ds 7

v 0 n 36
v 1 n 64
v 2 n 59
v 3 n 52
v 4 n 40

# --- Macros ---
[Tx]  : v0 g0 n $$0 l1  v0 g.035 n $$1 ;
[Tlow]: Tx 41 36 ;
[Thig]: Tx 48 43 ;

[off] : v1 l0 v2 l0 v3 l0 v4 l0 ;

