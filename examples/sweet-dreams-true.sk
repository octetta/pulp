# ======================================================================
# SWEET DREAMS (ARE MADE OF THIS) - EURYTHMICS (TRUE MIDI VERSION)
# A Step-by-Step Live Coding Setup for Skred
# ======================================================================

# ----------------------------------------------------------------------
# STEP 1: INITIALIZATION & TEMPO
# ----------------------------------------------------------------------
M124

# Delay Bus 1: Chorus/Delay to thicken the synths (especially the Arp)
DL 1 4 12 4 0 31 10 DD 1 2 DF 0 DP 0 DG 0,0

# ----------------------------------------------------------------------
# STEP 2: LOAD SAMPLES & VOICE CONFIGURATION
# ----------------------------------------------------------------------
# Load classic drum machine samples into K-Synth (Required for w 100-103)
[sk/drums-kick.ks]  /ks 1 k>d d>r /r100
[sk/drums-chh.ks]   /ks 1 k>d d>r /r101
[sk/drums-ohh.ks]   /ks 1 k>d d>r /r102
[sk/drums-snare.ks] /ks 1 k>d d>r /r103

# DRUMS (Upgraded to the heavy IFL patches)
# We use G (Link MIDI) and H (Link Velocity) to chain v 11 to v 0 for a massive kick!
v 11 vt [SubKick] w 100 f 220 a 15 t 0.001 0.1 0 0
v 0  vt [Kick]    w 100 f 440 a 25 G 11 H 11
v 1  vt [Snare]   w 103 f 440 a 15 J 2 0 K 500 Q 2 r 0 ds 0.2
v 2  vt [Hat]     w 101 f 440 a 3  t 0.001 0.1 0 0 r 0 ds 0.1

# BASS (CH0 in MIDI) - Heavy, rigid synth bass
v 3 vt [Bass] w 2 f 440 a 6 t 0.01 0.1 0.4 0.1 J 1 0 K 1200 Q 1.5 r 1 ds 0.2

# LEAD (CH1 in MIDI) - Bright, high-pitched motif
v 4 vt [Lead] w 1 f 442 a 5 t 0.01 0.1 0.2 0.1 J 1 0 K 2500 Q 1.0 r 1 ds 0.4

# ARP (CH2 in MIDI) - The driving mid-range syncopation
v 5 vt [Arp]  w 2 f 438 a 4 t 0.001 0.1 0.1 0.05 J 1 0 K 1800 Q 2.0 r 1 ds 0.5

# ----------------------------------------------------------------------
# STEP 3: MACRO DEFINITIONS (Max 4 chars)
# ----------------------------------------------------------------------
[Kik] : v 0 l 1 ;
[Snr] : v 1 l 1 ;
[Hat] : v 2 l 1 ;
[Bas] : v 3 n $$0 l 1 ;
[Led] : v 4 n $$0 l 1 ;
[Arp] : v 5 n $$0 l 1 ;

# ----------------------------------------------------------------------
# STEP 4: SEQUENCING THE PATTERNS (PARALLEL INSTRUMENTS)
# ----------------------------------------------------------------------
# All rhythmic notes in this riff fall on 8th notes! 
# By using % 2 (1 step = 8th note), we fit a 2-bar loop perfectly into 16 steps!

y 0 yt [BarClock]
% 16
[#] x 15

# --- DRUMS (1-bar loop, % 2) ---
y 2 yt [Drums]
% 2
[Kik] x 0   [Hat] x 1   [Kik Snr] x 2   [Hat] x 3
[Kik] x 4   [Hat] x 5   [Kik Snr] x 6   [Hat] x 7

# --- THE TRUE SWEET DREAMS SYNTH INTERPLAY ---
# Separated into parallel master/slave patterns per instrument!

# BASS (2-bar loop, % 2)
y 3 yt [Bass]
% 2
# Bar 1 (C minor)
[Bas 36] x 0   [Bas 48] x 2   [Bas 36] x 3   [Bas 48] x 5   [Bas 36] x 6   [Bas 48] x 7
# Bar 2 (Ab major to G major)
[Bas 44] x 8   [Bas 44] x 10  [Bas 44] x 11  [Bas 43] x 12  [Bas 43] x 13  [Bas 46] x 14  [Bas 46] x 15

# LEAD (2-bar loop, % 2)
y 4 yt [Lead]
% 2
# Bar 1
[Led 36] x 0   [Led 60] x 2   [Led 60] x 3   [Led 63] x 5   [Led 60] x 7
# Bar 2
[Led 56] x 10  [Led 60] x 11  [Led 55] x 14  [Led 60] x 15

# ARP (2-bar loop, % 2)
y 5 yt [Arp]
% 2
# Bar 1
[Arp 36] x 0   [Arp 36] x 1   [Arp 48] x 2   [Arp 48] x 3   [Arp 51] x 4   [Arp 48] x 6
# Bar 2
[Arp 44] x 8   [Arp 56] x 9   [Arp 43] x 12  [Arp 43] x 13

# ----------------------------------------------------------------------
# STEP 5: THE ORCHESTRATOR
# ----------------------------------------------------------------------
y 1 yt [Arranger]
% 16
# Trigger all parallel instruments on Bar 1!
# They will stay perfectly in sync.
# Manually inject Step 0 notes to avoid the mid-tick miss bug!
[ /z 2 1 /z 3 1 /z 4 1 /z 5 1 Kik Bas 36 Led 36 Arp 36 ] x 0

# Safe comment padding for wrap-around
[#] x 63

# ----------------------------------------------------------------------
# STEP 6: LIVE PERFORMANCE GUIDE
# ----------------------------------------------------------------------
# 1. Start the Master Clock:  y 0 z 1
# 2. Drop the Arranger:       y 1 z 1
# 3. Stop everything:         /z 1 0 /z 2 0 /z 3 0 /z 4 0 /z 5 0
