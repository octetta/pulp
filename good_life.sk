# ======================================================================
#  GOOD LIFE (Detroit Rave & Bass Mix - Kevin Saunderson / Inner City)
#  125 BPM, F minor, Bouncing Detroit Techno-Funk & 909 Heavy Club Stomp
# ======================================================================

[GOOD LIFE - DETROIT TECHNO FUNK] puts
V -7.3
M 125 16

# ----------------------------------------------------------------------
# DELAY BUSES (tempo synced to 125 BPM)
# ----------------------------------------------------------------------
# Bus 1: Dotted-eighth stereo lead echo
DS 1 125 .75
DL 1 - - 8 3 3 11
DD 1 7 3

# Bus 2: 16th ping-pong piano/stab echo
DS 2 125 .25
DL 2 - - 6 0 0 9
DD 2 5 4
DP 2 1

# Bus 3: Eighth note slapback
DS 3 125 .5
DL 3 - - 7 0 0 10
DD 3 6 4

# Bus 4: Warm Detroit hall wash
DS 4 125 1.0
DL 4 - - 11 4 8 10
DD 4 8 2
DP 4 1

# ----------------------------------------------------------------------
# VOICES
# ----------------------------------------------------------------------
# DRUMS (Roland TR-909 Heavyweight Kit)
v0 w82 f440 a5.5 p0                          # 909 kick punch
v1 w83 f440 a6.0 r2 p0 ds.25                 # 909 snappy snare
v2 w84 f440 a-3.5 p.2                        # 909 closed hat
v3 w85 f440 a-1.5 p-.2                       # 909 open hat (offbeat sizzle)
v4 w86 f440 a5.5 r2 p0 ds.3                  # 909 backbeat clap
v5 w0 a-2.5 p0 t.002,.30,0,.10 j1 k160 q.7   # sub kick weight (pitch drop)
v21 w94 f440 a3.5 p.2                        # crash cymbal
v22 w96 f440 a3.5 p-.25 r2 ds.3              # 909 cowbell / perc tick
v23 w87 f440 a4.5 p.25                       # 909 rimshot

# RISER (inline K-synth rave noise sweep)
[
/ rave noise riser
N: 131072
T: !N
E: (e(T*(4.5%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 850*(e(T*(2.7%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.65))
] k!
k>w301,44100,1
v16 w301 f180 a7.5 p0 t.005,.01,1,.3 r4 ds.3  # noise riser

# BASS 1: The Iconic Kevin Saunderson TX81Z / Minimoog Bouncing Bass
# Punchy resonant low-pass filter with snappy decay & phase-distortion bite
v6 w15 a-2 p0 t.002,.16,0,.04 j1,1 k680 q3.5 ft.001,.13,0,.03 fd2400 c4,.35
v6 >7
v7 w16 a-4 N12,8 p0
v6 G7 H7

# BASS 2: Deep Sub Bass Reinforcer (Chorus & Climax)
v8 w0 a-1.5 p0 t.002,.25,.2,.08 j1 k250 q1.5

# PIANO / DETROIT CHORD STABS (Layered FM + Saws)
v9 w0 a-5 p-.25 t.002,.22,0,.10 FF2 FB4 F10,2.2 G10 H10 r2 ds.3
v10 w0 a-5 t.002,.18,0,.10 N19 m1

# LEAD: The Anthem Hook Trio (Rich Detuned Stereo Saws)
v13 w15 a-7.5 p0 t.004,.24,.4,.12 j1,1 k4600 q1.5 c4,.3 ct.001,.2,0,.1 cd.4 r1 ds.35
v13 >14
v13 >15
v14 w15 a-9.5 p-.55 N0,9 r0
v15 w16 a-9.5 p.55 N0,-9 r0
v13 G14,15 H14,15

# DETROIT POLYPHONIC STRINGS POOL (Juno / Matrix-12 style)
