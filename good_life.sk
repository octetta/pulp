# "Take me to that good life... oh oh oh, take me to that good life..."
[
  C5 - C5 C5  - Bb4 Ab4 -  F4 - - -  - - - -
  Eb5 - Eb5 Eb5  - C5 Bb4 -  Ab4 - - -  - - - -
  C5 - C5 C5  - Bb4 Ab4 -  Bb4 - C5 -  Bb4 - Ab4 -
  F4 - - -  - - - -  - - - -  - - - -
] n>d /SS 13
/SC 4 13

# Stream 14: High Climax Anthem Hook - Memory Bank (4 bars / 64 steps)
[
  C6 - C6 C6  - Bb5 Ab5 -  F5 - - -  - - - -
  Eb6 - Eb6 Eb6  - C6 Bb5 -  Ab5 - - -  - - - -
  C6 - C6 C6  - Bb5 Ab5 -  Bb5 - C6 -  Bb5 - Ab5 -
  F5 - - -  - - - -  - - - -  - - - -
] n>d /SS 14

