[
  F1 - F1 F2  - F1 - F2  F1 - F1 Ab1 - Bb1 C2 -
  Eb1 - Eb1 Eb2 - Eb1 - Eb2  Eb1 - Eb1 G1  - Ab1 Bb1 -
  Db1 - Db1 Db2 - Db1 - Db2  Db1 - Db1 F1  - G1 Ab1 -
  C1 - C1 C2  - C1 - C2  C1 - C1 E1  - G1 Bb1 -
] n>d /SS 2

