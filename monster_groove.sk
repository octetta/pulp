# ======================================================================
#  MONSTER GROOVE (Lady Gaga Style Original Dance Anthem)
#  122 BPM, B minor, Electro-Funk / House-Pop Anthem
# ======================================================================

[MONSTER GROOVE] puts
V -6.3
M 122 16

# ----------------------------------------------------------------------
# DELAY BUSES (tempo synced to 122 BPM)
# ----------------------------------------------------------------------
# Bus 1: Dotted-eighth stereo lead echo
DS 1 122 .75
DL 1 - - 8 3 3 11
DD 1 7 3
# Bus 2: 16th ping-pong arpeggio echo
DS 2 122 .25
DL 2 - - 6 0 0 9
DD 2 5 4
DP 2 1
# Bus 3: Eighth note slapback
DS 3 122 .5
DL 3 - - 7 0 0 9
DD 3 6 4
# Bus 4: Hall wash for strings/pads
DS 4 122 1
DL 4 - - 11 4 8 10
DD 4 8 2
DP 4 1

# ----------------------------------------------------------------------
# VOICES
# ----------------------------------------------------------------------
# DRUMS (100% built-in drum waves 82-99)
v0 w82 f440 a6 p0                           # kick punch
v1 w83 f440 a7 r2 p0 ds.2                   # snare
v2 w84 f440 a-3 p.2                         # closed hat
v3 w85 f440 a-2 p-.2                        # open hat
v4 w86 f440 a6 r2 p0 ds.25                  # disco clap
v5 w0 a-2 p0 t.002,.22,0,.08 j1 k160 q.7    # sine sub drop (kick weight)
v21 w94 f440 a5 p.25                        # crash
v22 w96 f440 a3 p-.3 r2 ds.3                # cowbell
v23 w87 f440 a5 p.3                         # rim tick

# RISER (inline K-synth white noise sweep)
[
/ noise riser
N: 131072
T: !N
E: (e(T*(4.5%N)))%100
R: r T
L: 0.3 f R
H: R-L
F: 800*(e(T*(2.8%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.3)+(H*.7))
] k!
k>w301,44100,1
v16 w301 f180 a8 p0 t.005,.01,1,.3 r4 ds.3  # riser sweep

# BASS 1: Funky Slap/Electro Chug Bass (Detuned Saw + Pulse)
v6 w15 a-2 p0 t.002,.16,0,.05 j1 k700 q3.5 ft.001,.14,0,.04 fd2400 c4,.25
v6 >7
v7 w16 a-4 N0,12 p0
v6 G7 H7

# BASS 2: Deep Sub Bass (Choruses & Drop)
v8 w0 a-1 p0 t.002,.25,.2,.08 j1 k300 q1.5

# LEAD 1: Stereo Phase-Distortion Hook Lead Trio
v13 w15 a-8 p0 t.004,.24,.4,.12 j1 k5000 q1.5 c4,.3 ct.001,.2,0,.1 cd.4 r1 ds.35
v13 >14
v13 >15
v14 w15 a-10 p-.6 N0,9 r0
v15 w16 a-10 p.6 N0,-9 r0
v13 G14,15 H14,15

# LEAD 2: Punchy Electro Verse Stabs
v9 w16 a-6 p-.2 t.002,.18,.1,.08 j1 k3200 q2.0 r3 ds.25

# DISCO BRASS: Polyphonic FM Brass Stabs
v11 w0 a-4 p-.35 t.001,.30,0,.15 FF2 FB4 F12,2.0 G12 H12 r2 ds.3
v12 w0 a-4 t.001,.20,0,.15 N19 m1

# 16TH DISCO ARPEGGIATOR (Jupiter-8 style)
v17 w15 a-9 p0 t.002,.12,0,.05 j1 k3600 q1.8 r2 ds.4

# ANALOG STRINGS / PAD (Poly pool, 2-voice prototype -> v28..v37)
v24 w0 f.35 a0 t0,0,1,0 m1
v26 w15 a-9 p-.5 t1.0,.4,.7,1.2 j1 k2600 q.8 c4,.2 C24,.2 G27 H27
v27 w15 a-11 p.5 N0,8 t1.0,.4,.7,1.2 j1 k2600 q.8 c4,.2 C24,.2
/pg 0,26,2,0
/pp 0,0,28,5,0
v24 l1

# ----------------------------------------------------------------------
# STREAMS (Notes via n>d)
# ----------------------------------------------------------------------

# Stream 1: Verse Funky Bassline (16 steps = 1 bar in B minor)
[ B1 . B1 D2  - E2 - F#2  - A1 - B1  - D2 E2 - ] n>d /SS 1

# Stream 2: Chorus Octave Bouncing Bassline (4 bars: Bm -> G -> D -> A)
[
  B1 - B1 B2  - B1 - B2  B1 - B1 D2  - E2 F#2 -
  G1 - G1 G2  - G1 - G2  G1 - G1 B1  - C#2 D2 -
  D2 - D2 D3  - D2 - D3  D2 - D2 F#2 - E2 D2 -
  A1 - A1 A2  - A1 - A2  A1 - A1 C#2 - E2 F#2 -
] n>d /SS 2

# Stream 13: The Monster Hook Lead (Memory Bank - 4 bars / 64 steps)
[
  F#4 - F#4 -  F#4 E4 D4 E4  F#4 - - -  A4 - B4 -
  F#4 - F#4 -  F#4 E4 D4 B3  D4 - - -  E4 - - -
  F#4 - F#4 -  F#4 E4 D4 E4  F#4 - - -  D5 - C#5 -
  B4 - - -  A4 - - -  F#4 - E4 -  D4 - B3 -
] n>d /SS 13
/SC 3 13

# Stream 14: High Octave Hook Variation (Memory Bank - for Climax)
[
  F#5 - F#5 -  F#5 E5 D5 E5  F#5 - - -  A5 - B5 -
  F#5 - F#5 -  F#5 E5 D5 B4  D5 - - -  E5 - - -
  F#5 - F#5 -  F#5 E5 D5 E5  F#5 - - -  D6 - C#6 -
  B5 - - -  A5 - - -  F#5 - E5 -  D5 - B4 -
] n>d /SS 14
/SC 4 14

# Stream 5: Verse Synth Lead (2 bars / 32 steps)
[
  B4 - - B4  - A4 - F#4  - - - -  E4 - F#4 -
  B4 - - B4  - A4 - F#4  - - - -  D4 - B3 -
] n>d /SS 5

# Stream 6: Pre-Chorus Chords (4 bars: G -> A -> Bm -> F#)
[
  G4 . . .  . . . .  . . . .  . . . .
  A4 . . .  . . . .  . . . .  . . . .
  B4 . . .  . . . .  . . . .  . . . .
  F#4 . . . . . . .  . . . .  . . . .
] n>d /SS 6

# Stream 7: 16th Disco Arpeggio (4 bars: Bm -> G -> D -> A)
[
  B3 D4 F#4 B4  D4 F#4 B4 D5  F#4 B4 D5 F#5  D5 B4 F#4 D4
  G3 B3 D4 G4   B3 D4 G4 B4   D4 G4 B4 D5    B4 G4 D4 B3
  F#3 A3 D4 F#4 A3 D4 F#4 A4  D4 F#4 A4 D5   A4 F#4 D4 A3
  E3 A3 C#4 E4  A3 C#4 E4 A4  C#4 E4 A4 C#5  E4 C#4 A3 E3
] n>d /SS 7

