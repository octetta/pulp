# ======================================================================
#  MORODER GROOVE (Ultimate Synth Disco Tribute to Giorgio Moroder)
#  128 BPM, D minor, Propulsive Moog Modular Bass & 70s Euro-Disco
# ======================================================================

[MORODER GROOVE - GIORGIO MORODER SYNTH DISCO TRIBUTE] puts
V -7.2
M 128 16

# ----------------------------------------------------------------------
# DELAY BUSES (tempo synced to 128 BPM)
# ----------------------------------------------------------------------
# Bus 1: Moog bass 16th slapback / ping-pong gallop (The Moroder Pulse!)
DS 1 128 .25
DL 1 - - 7 2 2 10
DD 1 6 3
DP 1 1

# Bus 2: Shimmering 16th arpeggio ping-pong delay
DS 2 128 .25
DL 2 - - 6 0 0 9
DD 2 5 4
DP 2 1

# Bus 3: Dotted-eighth space echo for anthem lead
DS 3 128 .75
DL 3 - - 8 3 3 11
DD 3 7 3

# Bus 4: Solina strings & noise wash stereo hall
DS 4 128 1.0
DL 4 - - 11 4 8 10
DD 4 8 2
DP 4 1

# ----------------------------------------------------------------------
# VOICES
# ----------------------------------------------------------------------
# DRUMS (Four-on-the-Floor Munich Disco Kit)
v0 w82 f440 a5.5 p0                          # 4-on-the-floor punch kick
v1 w83 f440 a6.0 r2 p0 ds.25                 # crisp disco snare
v2 w84 f440 a-3.5 p.2                        # running 16th closed hats
v3 w85 f440 a-1.5 p-.2                       # sizzling offbeat open hats
v4 w86 f440 a5.5 r2 p0 ds.3                  # electronic disco clap
v5 w0 a-2.5 p0 t.002,.30,0,.10 j1 k160 q.7   # sub kick weight (pitch drop)
v21 w94 f440 a3.5 p.2                        # crash cymbal
v22 w96 f440 a3.5 p-.25 r2 ds.3              # disco cowbell / perc tick
v23 w87 f440 a4.5 p.25                       # rim tick

# SIMMONS / DISCO TOMS (Stereo Fill Trio)
v18 w90 f440 a4.5 p-.4 r2 ds.25              # hi tom
v19 w91 f440 a4.5 p0 r2 ds.25                # mid tom
v20 w92 f440 a5.0 p.4 r2 ds.25               # lo tom

# RISER (inline K-synth white noise wind sweep)
[
/ moroder noise wind riser
N: 131072
T: !N
E: (e(T*(4.5%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 800*(e(T*(2.8%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.65))
] k!
k>w301,44100,1
v16 w301 f180 a7.5 p0 t.005,.01,1,.3 r4 ds.3  # noise sweep

# BASS 1: The Legendary Moroder Moog Modular Galloping Bass
# Driven ladder filter + snappy envelope + phase distortion + Bus 1 ping-pong delay
v6 w15 a-2 p0 t.002,.14,0,.04 j1,1 k620 q3.8 ft.001,.12,0,.04 fd2400 c4,.35 r1 ds.35
v6 >7
v7 w16 a-4 N12,8 p0 r1 ds.35
v6 G7 H7

# BASS 2: Sub-Bass Reinforcer (Drops & Climax)
v10 w0 a-1.5 p0 t.002,.25,.2,.08 j1 k220 q1.5

# ARPEGGIATOR: Roland Jupiter-8 / ARP Odyssey 16th-Note Shimmer
v17 w15 a-8 p0 t.002,.12,0,.04 j1 k3800 q2.0 r2 ds.4

# DISCO FM BRASS: Punchy 2-Operator Stabs
v11 w0 a-5 p-.3 t.001,.25,0,.12 FF2 FB4 F12,2.0 G12 H12 r2 ds.3
v12 w0 a-5 t.001,.20,0,.12 N19 m1

# LEAD: Soaring Euro-Disco Anthem Hook (Detuned Stereo Saw Trio)
v13 w15 a-7.5 p0 t.004,.24,.4,.12 j1,1 k4800 q1.5 c4,.3 ct.001,.2,0,.1 cd.4 r3 ds.35
v13 >14
v13 >15
v14 w15 a-9.5 p-.55 N0,9 r0
v15 w16 a-9.5 p.55 N0,-9 r0
v13 G14,15 H14,15

# SOLINA STRING ENSEMBLE POOL (Lush Euro-Disco Strings)
v24 w0 f.32 a0 t0,0,1,0 m1
v26 w15 a-9.5 p-.5 t1.0,.4,.7,1.2 j1 k2400 q.8 c4,.2 C24,.2 G27 H27
v27 w15 a-11.5 p.5 N0,8 t1.0,.4,.7,1.2 j1 k2400 q.8 c4,.2 C24,.2
/pg 0,26,2,0
/pp 0,0,28,5,0
v24 l1

# ----------------------------------------------------------------------
# STREAMS (Notes via n>d)
# ----------------------------------------------------------------------

# Stream 1: The Iconic Moroder 16th Octave Gallop in D minor
# D1 D2 D1 D2  D1 D2 F2 D2  D1 D2 G2 D2  Ab2 G2 F2 D2
[
  D1 D2 D1 D2  D1 D2 F2 D2  D1 D2 G2 D2  Ab2 G2 F2 D2
] n>d /SS 1

# Stream 2: Chorus Propulsive Modulating Bass (4 bars: Dm -> F -> Gm -> Bb/A)
[
  D1 D2 D1 D2  D1 D2 F2 D2  D1 D2 G2 D2  Ab2 G2 F2 D2
  F1 F2 F1 F2  F1 F2 A2 F2  F1 F2 C3 F2  D3 C3 A2 F2
  G1 G2 G1 G2  G1 G2 Bb2 G2 G1 G2 D3 G2  Eb3 D3 Bb2 G2
  Bb1 Bb2 Bb1 Bb2 Bb1 Bb2 D3 Bb2 A1 A2 A1 A2  C#3 A2 G2 E2
] n>d /SS 2

# Stream 7: Shimmering 16th Arpeggio (4 bars: Dm -> F -> Gm -> Bb/A)
[
  D3 F3 A3 D4  F3 A3 D4 F4  A3 D4 F4 A4  F4 D4 A3 F3
  F3 A3 C4 F4  A3 C4 F4 A4  C4 F4 A4 C5  A4 F4 C4 A3
  G3 Bb3 D4 G4 Bb3 D4 G4 Bb4 D4 G4 Bb4 D5 Bb4 G4 D4 Bb3
  Bb3 D4 F4 Bb4 D4 F4 Bb4 D5 A3 C#4 E4 A4  C#4 E4 A4 C#5
] n>d /SS 7

# Stream 13: The Giorgio Anthem Lead Hook - Memory Bank (4 bars / 64 steps)
[
  D4 - - D4  F4 - G4 -  A4 - - -  - - - -
  C5 - - C5  A4 - G4 -  F4 - - -  - - - -
  G4 - - G4  A4 - Bb4 - C5 - - -  Bb4 - A4 -
  G4 - - -   F4 - E4 -  D4 - - -  - - - -
] n>d /SS 13
/SC 4 13

# Stream 14: High Climax Anthem Variation - Memory Bank (4 bars / 64 steps)
[
  D5 - - D5  F5 - G5 -  A5 - - -  - - - -
  C6 - - C6  A5 - G5 -  F5 - - -  - - - -
  G5 - - G5  A5 - Bb5 - C6 - - -  Bb5 - A5 -
  G5 - - -   F5 - E5 -  D5 - - -  - - - -
] n>d /SS 14

