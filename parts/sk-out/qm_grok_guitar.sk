# ----------------------------------------------------------------------
# Purcell – Music for the Funeral of Queen Mary
# Wendy Carlos style + guitar part (chords) from the classclef MIDI
# ----------------------------------------------------------------------

M 60 8

# Delay
DL 1 6 8 7 0 4 7
DD 1 11 5

DL 2 5 0 15 0 10 10
DL 3 4 0 15 0 10 10

# --- Timpani (Voice 0) ---
v 0
w 1 a 0.82
t 0.005 1.5 0 0.4
j 1 k 65 q 1.7
kt 0.008 0.22 0 0
kd 500

A 10 1

v10 m1 a0 f5 l1

r 2 ds .7

# --- Brass Ensemble (Voices 1–4) ---
[bras] : v $$0 w 18 a 0.36 t 0.05 0.22 0.70 0.50 j 1 k 2050 q 1.6 ;
1 bras
2 bras
3 bras
4 bras

v 1 N 0 0
v 2 N 0 6
v 3 N 0 -5
v 4 N 0 -2

v 1 g 0.045
v 2 g 0.05
v 3 g 0.04
v 4 g 0.055

v 1 L 0.00
v 2 L 0.012
v 3 L 0.025
v 4 L 0.008

v 1 p 0 r 1 ds .6
v 2 p 0 r 1 ds .6
v 3 p 0 r 1 ds .6
v 4 p 0 r 1 ds .6

# --- Guitar (Voices 5–7) ---
v 5 w15 a0 t 0.002 0.32 0.12 0.22 j1 k3600 q0.8 g0.008 p0 r3 ds .7
> 6
> 7

# Prime
v 0 n 36
v 1 n 64
v 2 n 59
v 3 n 52
v 4 n 40
v 5 n 64
v 6 n 59
v 7 n 52

# --- Macros ---

[Tx]  : v0 g0 n $$0 l1  v0 g.04 n $$1 ;

[Tlow]: Tx 41 36 ;
[Thig]: Tx 46 41 ;

[off]  : v1 l0 v2 l0 v3 l0 v4 l0 ;
[goff] : v5 l0 v6 l0 v7 l0 ;

# Guitar macros (1 / 2 / 3 notes)
[GuiA] : v5 n $$0 l1 v6 l0 v7 l0 ;
[GuiB] : v5 n $$0 l1  v6 n $$1 l1 v6 l0 ;
[GuiC] : v5 n $$0 l1  v6 n $$1 l1  v7 n $$2 l1 ;

