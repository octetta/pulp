## NINE INCH NAILS - CLOSER (Instrumental Cover for PULP / SKRED)
#  90 BPM, C minor / C blues modal tension, 92 bars (about 4:05). Trent Reznor (1994).
#  Self-contained: drums from built-in waves 82-99, inline K-synth riser.
#  Uses n>d to convert note name strings (with '-' rests) to MIDI note streams.
#  Load:   [closer.sk] /ls
#  Start:  play        Stop:  stop
#
#  VOICE MAP (all labeled via [name] vt):
#    v0  kick (w82) + v5 sub-drop glide (w0) = the iconic heartbeat pulse
#    v1  industrial snare (w83) + v4 gated clap (w86)
#    v2  closed hat (w84)  v3  open hat (w85)  v15 metallic sizzle (w95)
#    v6  Minimoog bass saw (w15, centre) + v7 partner square (w16, right)
#    v8  chorus synth brass centre (w15) + v9 (w15 left), v10 (w16 right)
#    v11 post-chorus ascending hook (w15) + v12 partner pulse (w16)
#    v13 outro piano tone (w15) + v14 tape sub/wood layer (w0)
#    v16 K-synth build riser (w301)
#    v17 crash cymbal (w94)
#    v18 ring mod metal clang (w16) + v19 modulator (w15)
#    v20 bitcrushed industrial noise burst (w5)
#    v21 Trent vocal lead synth (w15) + v22 partner saw (w15)
#    v24 pad LFO  v26,v27 pad prototype  v28-v37 poly pool (5 stereo pairs)
#    v38 sub boom sine (w0) + v40 slowed kick sample (w82 f110)
#
#  DELAY BUSES:
#    Bus 1: Hook & Lead dotted-eighth echo (DS 1 90 .75)
#    Bus 2: Bass slapback sixteenth (DS 2 90 .25)
#    Bus 3: Snare & Clap gated industrial tail (DS 3 90 .5)
#    Bus 4: Outro piano & Riser deep hall wash (DS 4 90 .75, DP 4 1)
#
#  ARRANGEMENT (92 bars):
#    0-3   Intro: heartbeat kick & industrial noise pulse
#    4-7   Minimoog bass enters alone with heartbeat kick
#    8-15  Verse 1: snare, clap, closed hats, vocal lead enters, clangs
#    16-23 Verse 1 Pre-Chorus: 16th hats, pad swells, bass filter opens
#    24-31 Post-Chorus Hook 1: E-F-G-Ab lead explodes with dotted echo
#    32-39 Verse 2: stripped industrial funk groove, vocal lead verse 2
#    40-47 Build-up: snare ratchet roll, K-synth riser, bass sweep
#    48-63 Full Chorus: wall of sound (Ab - Bb - Cm), vocal chorus, brass stabs
#    64-71 Climax & Delay Freeze: hook returns, freeze drone capture (DF 1 1)
#    72-87 Outro: Downward Spiral piano solo over heartbeat kick & hall delay
#    88-91 Fade to black: final piano echo decays, heartbeat stops
#    92    End cleanup
# ======================================================================

[NINE INCH NAILS - CLOSER] puts
M 90 16

## INLINE K-SYNTH RISER (one-shot wave 301)
[
/ riser: exponential sweep + highpass noise, zero DC
N: 131072
T: !N
E: (e(T*(4.6%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 900*(e(T*(2.7%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.6))
] k!
k>w301,44100,1

## DELAY BUSES
# Bus 1: Lead dotted-eighth echo
DS 1 90 .75
DL 1 - - 8 3 3 11
DD 1 7 3

# Bus 2: Bass slapback sixteenth (adds thickness without blur)
DS 2 90 .25
DL 2 - - 4 0 0 8
DD 2 6 3

# Bus 3: Industrial snare / clap gated tail
DS 3 90 .5
DL 3 - - 6 0 0 9
DD 3 5 4

# Bus 4: Outro piano & riser deep ping-pong hall wash
DS 4 90 .75
DL 4 - - 11 4 8 10
DD 4 8 2
DP 4 1

## VOICES
# Drums: heartbeat kick + sub drop layer
v0 w82 f440 a7 p0 [kick nightclubbing] vt
v5 w0 a-2 p0 t.002,.35,0,.10 j1 k160 q.7 [kick sub drop] vt

# Industrial snare & claps
v1 w83 f440 a8 p0 r3 ds.25 [snare industrial] vt
v2 w84 f440 a-3 p.25 [closed hat] vt
v3 w85 f440 a-2 p-.25 [open hat] vt
v4 w86 f440 a7 p0 [gated clap] vt
v15 w95 f440 a-4 p-.35 [metallic sizzle] vt
v17 w94 f440 a4 p.2 [crash cymbal] vt

# Minimoog Bass: saw (centre) + detuned square partner (right), Character 2 overdrive
v6 w15 a-1 p0 t.002,.22,0,.06 j1,2 k440 q6 g.03 r2 ds.10 [minimoog bass saw] vt
v6 >7
v7 w16 a-5 N0,9 p.4 r0 [minimoog partner square] vt
v6 G7 H7

# Chorus Synth Brass / Power Stabs (detuned trio)
# s=0 decay envelope guarantees notes decay cleanly and never hang
v8 w15 a-7 p0 t.008,.35,0,.25 j1,2 k3600 q1.8 c4,.25 r1 ds.3 [synth brass centre] vt
v8 >9
v8 >10
v9 w15 a-8 N0,12 p-.6 r0 [synth brass left] vt
v10 w16 a-10 N0,-12 p.6 r0 [synth brass right] vt
v8 G9,10 H9,10

# Post-Chorus Ascending Hook (nasal saw + pulse partner, phase distortion c4)
v11 w15 a-6 p0 t.004,.28,0,.20 j1 k2800 q2.2 c4,.35 r1 ds.35 [ascending hook saw] vt
v11 >12
v12 w16 a-9 N0,11 p.55 r0 [ascending partner pulse] vt
v11 G12 H12

# Trent Reznor Vocal Lead Synth (expressive singing saw pair)
v21 w15 a-6 p0 t.004,.30,0,.12 j1,2 k2400 q2.0 c4,.20 r1 ds.25 [trent vocal lead] vt
v21 >22
v22 w15 a-8 N0,10 p-.4 r0 [trent vocal partner] vt
v21 G22 H22

# Outro Piano (The Downward Spiral motif: filtered saw + tape sine sub)
v13 w15 a-6 p0 t.002,.65,0,.45 j1 k1400 q1.4 c4,.15 r4 ds.4 [downward spiral piano] vt
v13 >14
v14 w0 a-4 p.3 N0,5 t.002,.70,0,.40 j1 k800 q.7 r0 [piano tape sub wood] vt
v13 G14 H14

# Riser: stretched K-synth one-shot
v16 w301 f120 a8 p0 t.005,.01,1,.4 r4 ds.3 [ksynth build riser] vt

# Industrial Clangs: ring modulation of two inharmonic frequencies + bitcrush
v18 w16 f311 a2 t.001,.30,0,.15 bc5 XM19 H19 [machine ring mod clang] vt
v19 w15 f187 a0 t.001,.25,0,.15 m1 [ring mod carrier] vt

# Bitcrushed industrial noise burst
v20 w5 a-4 p-.4 t.001,.18,0,.10 j2 k1600 q1.2 bc6 [bitcrushed noise burst] vt

# Sub boom: audible sub drop + slowed kick
v38 w0 a0 p0 t.002,.90,0,.40 j1 k240 q.7 r3 ds.3 [sub boom sine] vt
v40 w82 f110 a5 p0 [slowed kick drop] vt

# Pad: Poly pool, 2-voice prototype (detuned stereo saw pair), 5 instances at v28-v37
v24 w0 f.22 a0 t0,0,1,0 m1 [pad lfo] vt
v26 w15 a-10 p-.5 t1.5,.5,0,1.6 j1 k2000 q.8 c4,.2 C24,.2 G27 H27 [pad proto left] vt
v27 w15 a-12 p.5 N0,8 t1.5,.5,0,1.6 j1 k2000 q.8 c4,.2 C24,.2 [pad proto right] vt
/pg 0,26,2,0
/pp 0,0,28,5,0
v24 l1

## EVENTS
[O DQ] /ceb 4 99
/cer 1

## STREAMS (Note arrays converted via n>d with '-' rests)
# Stream 1: Minimoog Rubber Bass in C minor (2 bars / 32 sixteenths)
# Features octave snaps, C1 bounces, and F#1->G1 chromatic slides
[C1 - C1 - C2 - C1 - C1 - Eb1 - C2 - F#1 G1  C1 - C1 - C2 - C1 - Bb0 - Bb0 - C2 - F#1 G1] n>d /SS 1

# Stream 2: Chorus Bassline Roots (Ab -> Bb, 2 bars / 32 sixteenths)
[Ab0 - - - Ab0 - - - Ab1 - - - Ab0 - - -  Bb0 - - - Bb0 - - - Bb1 - - - Bb0 - - -] n>d /SS 2

# Stream 3: Post-Chorus Ascending Hook (E -> F -> G -> Ab chromatic tension)
[E4 - - - F4 - - - G4 - - - Ab4 - - - G4 - - - F4 - - - E4 - - - C4 - - -] n>d /SS 3

# Stream 4: The Outro Piano (The Downward Spiral Descending Motif, 4 bars / 64 steps)
[Bb4 - - - - - - - A4 - - - - - - - Ab4 - - - - - - - G4 - - - - - - - Gb4 - - - - - - - F4 - - - - - - - Eb4 - - - - - D4 D4 C4 - - - - - - -] n>d /SS 4

# Stream 5: Trent Reznor Verse Vocal Lead (4 bars / 64 steps)
[C4 - C4 - C4 - C4 - C4 - C4 - Eb4 D4 C4 - - -  C4 - C4 - C4 - C4 - C4 - C4 - Eb4 D4 C4 - - -  C4 - C4 - C4 - C4 - C4 - C4 - Eb4 D4 C4 - - -  Eb4 - D4 - C4 - Bb3 - C4 - - - - - - - - - - -] n>d /SS 5

# Stream 6: Trent Reznor Chorus Vocal Hook (4 bars / 64 steps)
[C4 - C4 - Eb4 - D4 - C4 - C4 - Eb4 - D4 - - -  C4 - C4 - Eb4 - D4 - F4 - Eb4 - D4 - C4 - - -  C4 - C4 - Eb4 - D4 - C4 - C4 - Eb4 - D4 - - -  Ab4 - G4 - F4 - Eb4 - D4 - - - - - - - - - - -] n>d /SS 6

