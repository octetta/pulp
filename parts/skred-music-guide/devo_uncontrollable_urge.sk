## DEVO - UNCONTROLLABLE URGE (Full Post-Punk Showcase Cover for PULP / SKRED)
#  184 BPM, Key of A Major / A Mixolydian, 128 bars (~2:47).
#  Written by Mark Mothersbaugh & Gerald Casale (1978, Q: Are We Not Men? A: We Are Devo!).
#  Self-contained: drums from built-in waves 82-99, inline K-synth riser.
#  Uses n>d to convert note name strings (with '-' rests) to MIDI streams.
#  Load:   [devo_uncontrollable_urge.sk] /ls
#  Start:  play        Stop:  stop
#
#  VOICE MAP (all labeled via [name] vt):
#    v0  motorik electronic kick (w82) + v5 sub punch (w0)
#    v1  crack 70s snare (w83) + v4 tight clap (w86)
#    v2  closed hat 8ths (w84)  v3  open hat offbeat (w85)
#    v17 crash cymbal (w94)
#    v18 hi tom (w90)  v19 mid tom (w91)  v20 lo tom (w92) = Simmons toms
#    v6  Gerald Casale bass saw centre (w15) + v7 partner square right (w16)
#    v8  Bob Mothersbaugh guitar root left (w15) + v9 fifth (w15), v10 octave (w16)
#    v14 Bob Casale rhythm guitar root right (w16) + v15 fifth left (w15)
#    v11 Mark Mothersbaugh Minimoog lead saw (w15) + v12 pulse partner (w16)
#    v16 K-synth build riser (w301)
#    v21 DEVO vocal lead centre (w15) + v22 left (w16), v23 right (w15)
#    v24 DEVO FM metal stab / pick scrape (w0) + v25 modulator (w0)
#
#  DELAY BUSES:
#    Bus 1: Vocal slapback sixteenth (DS 1 184 .25, DL 1 - - 5 0 0 9)
#    Bus 2: Bass slapback sixteenth (DS 2 184 .25, DL 2 - - 4 0 0 8)
#    Bus 3: Snare room reverb tail (DS 3 184 .5, DL 3 - - 6 0 0 9)
#    Bus 4: Minimoog stereo chorus wash (DS 4 184 .75, DL 4 - - 8 3 6 10, DP 4 1)
#
#  ARRANGEMENT (128 bars):
#    0-1   Alan Myers 4-count hi-hat clicks
#    2-5   Intro F -> G build riff + machine-gun snare roll & sudden dead stop
#    6-13  Main Unison Riff explosion & manic 'YEAH!' shouts
#    14-29 Verse 1: 'Got an urge, got a surge, and it's out of control...'
#    30-37 Chorus 1: 'It's got style, it's got class... And I say: YEAH!'
#    38-41 Main Riff & 'YEAH!' reprise
#    42-49 Start-Stop Breaks 1: sudden dead stops with metallic scrapes
#    50-65 Verse 2: 'Got an urge, I wanna purge, 'cause I'm losing control...'
#    66-73 Chorus 2: 'It's got style, it's got class...'
#    74-89 Bridge & Bob Mothersbaugh Angular Guitar Solo + Minimoog madness
#    90-97 Start-Stop Breaks 2: precision unison cuts
#    98-105 Final Climax Chorus: maximum power, 16th hats, crashing cymbals
#    106-121 Outro Vamp: frantic 'Uncontrollable Urge!' chanting
#    122-125 Final 'Yeah Yeah' sprint & sudden precision cutoff
#    126   Final unison crash hit
#    127   Cleanup and stop
# ======================================================================

[DEVO - UNCONTROLLABLE URGE] puts
M 184 16

## INLINE K-SYNTH RISER (one-shot wave 301)
[
/ riser: exponential sweep + highpass noise, zero DC
N: 65536
T: !N
E: (e(T*(4.2%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 950*(e(T*(2.6%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.55))
] k!
k>w301,44100,1

## DELAY BUSES
# Bus 1: Vocal & guitar slapback sixteenth
DS 1 184 .25
DL 1 - - 5 0 0 9
DD 1 7 3

# Bus 2: Bass slapback sixteenth (tight low-end punch)
DS 2 184 .25
DL 2 - - 4 0 0 8
DD 2 6 3

# Bus 3: Snare room tail
DS 3 184 .5
DL 3 - - 6 0 0 9
DD 3 5 4

# Bus 4: Minimoog stereo chorus wash
DS 4 184 .75
DL 4 - - 8 3 6 10
DD 4 7 2
DP 4 1

## VOICES
# Alan Myers motorik drums: kick, sub punch, crack snare, clap, hats, crash, toms
v0 w82 f440 a7 p0 [kick motorik] vt
v5 w0 a-2 p0 t.001,.18,0,.05 j1 k160 q.7 [kick sub punch] vt
v1 w83 f440 a8 p0 r3 ds.18 [snare 70s crack] vt
v4 w86 f440 a6 p0 [clap tight] vt
v2 w84 f440 a-3 p.25 [closed hat] vt
v3 w85 f440 a-2 p-.25 [open hat] vt
v17 w94 f440 a5 p.2 [crash cymbal] vt
v18 w90 f440 a6 p-.35 [hi tom] vt
v19 w91 f360 a6 p0 [mid tom] vt
v20 w92 f280 a6 p.35 [lo tom] vt

# Gerald Casale Bass: gritty, driving Moog/Rickenbacker saw + square pair
v6 w15 a-1 p0 t.001,.14,0,.04 j1,2 k1400 q2.8 r2 ds.08 [casale bass saw] vt
v6 >7
v7 w16 a-5 N0,7 p.35 r0 [casale bass square] vt
v6 G7 H7

# Bob Mothersbaugh ('Bob 1') Punk Guitar Power Chord Trio: root, fifth, octave
# Crisp staccato attack, character drive j1,2, slight bitcrush, and delay slapback
v8 w15 a-5 p-.30 t.001,.11,0,.03 j1,2 k3400 q1.2 c4,.20 r1 ds.12 [bob1 guitar root] vt
v8 >9
v8 >10
v9 w15 a-7 N7,5 p.25 r1 [bob1 guitar fifth] vt
v10 w16 a-9 N12,0 p-.45 r1 [bob1 guitar octave] vt
v8 G9,10 H9,10

# Bob Casale ('Bob 2') Rhythm Guitar: stereo spread double-tracking
v14 w16 a-7 p.40 t.001,.10,0,.03 j1 k3000 q1.0 c4,.15 [bob2 guitar root] vt
v14 >15
v15 w15 a-9 N7,7 p-.20 [bob2 guitar fifth] vt
v14 G15 H15

# Mark Mothersbaugh Minimoog Lead & Quirky Stabs (centre-left saw + pulse partner)
v11 w15 a-3 p-.20 t.002,.20,0,.05 j1 k2600 q4.0 g.03 r1 ds.25 [minimoog lead saw] vt
v11 >12
v12 w16 a-6 N0,12 p.20 [minimoog lead pulse] vt
v11 G12 H12

# Inline K-Synth Riser Voice
v16 w301 f440 a5 p0 [ksynth riser] vt

# DEVO Vocal Lead: Searing punk vocal synth trio with safe s=0 envelope
v21 w15 a-2 p0 t.003,.16,0,.04 j1,2 k3600 q2.2 r1 ds.20 [devo vocal lead] vt
v21 >22
v21 >23
v22 w16 a-6 N0,5 p-.40 [devo vocal left] vt
v23 w15 a-6 N0,-5 p.40 [devo vocal right] vt
v21 G22,23 H22,23

# DEVO FM Metal Stab / Pick Scrape (signature start-stop accent)
v24 w0 a-3 p-.35 t.001,.30,0,.20 FF2 FB4 F25,2.4 G25 H25 [devo metal stab] vt
v25 w0 a0 t.001,.20,0,.20 N21 m1 [stab modulator] vt

## EVENTS (end-of-song cleanup responder)
[O DQ] /ceb 4 99
/cer 1

