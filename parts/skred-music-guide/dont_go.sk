[O DQ] /ceb 4 99
/cer 1

## STREAMS (Note and parameter arrays converted via n>d)
# Stream 1: Vince Clarke 16th Bassline (Gm root groove, 2 bars / 32 sixteenths)
# Notice '-' used as rests between syncopated bounce notes!
[G1 G1 G2 G1  G1 G1 G2 G1  G1 G1 G2 G1  Bb1 - C2 -  G1 G1 G2 G1  G1 G1 G2 G1  G1 G1 G2 G1  F1 - F#1 -] n>d /SS 1

# Stream 2: Chorus Bassline Roots (Eb -> F -> Gm -> Bb)
[Eb1 Eb1 Eb2 Eb1  Eb1 Eb1 Eb2 Eb1  F1 F1 F2 F1  F1 F1 F2 F1  G1 G1 G2 G1  G1 G1 G2 G1  Bb1 Bb1 Bb2 Bb1  Bb1 Bb1 Bb2 Bb1] n>d /SS 2

# Stream 3: The Famous Arpeggio Riff (Gm - Dm - Eb - D7 arpeggios, 4 bars / 32 eighth notes)
[D4 G4 Bb4 D5 C5 Bb4 G4 D4  D4 F4 A4 C5 D5 C5 A4 F4  Eb4 G4 Bb4 D5 C5 Bb4 G4 Eb4  D4 F#4 A4 C5 Bb4 A4 G4 F#4] n>d /SS 3

# Stream 4: Vocal Lead Hook ('Baby don't go, baby don't go...')
[Bb4 A4 G4 - Bb4 A4 G4 - D5 - C5 Bb4 A4 G4 - -  Bb4 A4 G4 - Bb4 A4 G4 - D5 - F5 Eb5 D5 C5 - -] n>d /SS 4

# Stream 5: Vocal Lead Verse 1 ('Came in from the city, walked into the door...')
[G4 G4 G4 G4 F4 D4 - - D4 F4 G4 - - - - -  G4 G4 G4 G4 F4 D4 - - D4 F4 G4 - - - - -  Bb4 Bb4 Bb4 Bb4 A4 F4 - - F4 A4 Bb4 - - - - -  C5 C5 C5 C5 Bb4 G4 - - D5 - - - - - - -] n>d /SS 5

# Stream 6: Chorus Brass Chords Root Transpose (Eb -> F -> Gm -> D)
[Eb4 - - - F4 - - - G4 - - - D4 - - -] n>d /SS 6

