## YAZOO - DON'T GO (Full Arrangement Instrumental Cover for PULP / SKRED)
#  128 BPM, G minor, 96 bars (about 3:00). Vince Clarke & Alison Moyet (1982).
#  Self-contained: drums from built-in waves 82-99, inline K-synth riser.
#  Uses n>d to convert note name strings (with '-' rests) to MIDI note streams.
#  Load:   [dont_go.sk] /ls
#  Start:  play        Stop:  stop
#
#  VOICE MAP:
#    v0  electronic kick (w82) + v5 sub punch (w0)
#    v1  gated 80s snare (w83) + v4 electronic clap (w86)
#    v2  closed hat (w84)  v3  open hat (w85)  v15 cowbell (w96)
#    v6  Vince Clarke bass saw (w15, centre) + v7 partner square (w16, right)
#    v8  synth brass centre (w15) + v9 partner saw (w15 left), v10 (w16 right)
#    v11 arpeggio lead centre (w15) + v12 partner pulse (w16)
#    v13 vocal lead synth centre (w15) + v14 partner saw (w15)
#    v16 K-synth build riser (w301)
#    v17 crash cymbal (w94)
#    v18 hi tom (w90)  v19 mid tom (w91)  v20 lo tom (w92) = Simmons tom roll
#    v21 Alison Moyet vocal laugh / cry FX (w15 formant glide)
#    v24 pad LFO  v26,v27 pad prototype  v28-v37 poly pool (5 stereo pairs)
#    v38 sub boom sine (w0) + v40 slowed kick sample (w82 f110)
#
#  DELAY BUSES:
#    Bus 1: Arp & Lead dotted-eighth echo (DS 1 128 .75, DP 1 1 ping-pong)
#    Bus 2: Vince Clarke bass 16th slapback (DS 2 128 .25)
#    Bus 3: Snare & Clap 80s gated room tail (DS 3 128 .5)
#    Bus 4: Synth brass & riser stereo wash (DS 4 128 .75, DP 4 1)
#
#  ARRANGEMENT (96 bars):
#    0-3   Intro: Alison's vocal laugh FX + 16th bassline enters alone
#    4-7   Arpeggio hook explodes in with stereo dotted-eighth echo
#    8-15  Full electronic drums (kick, snare, clap, 16th hats, cowbell)
#    16-31 Verse 1: vocal lead enters, staccato brass stabs on offbeats
#    32-47 Chorus 1: Eb - F - Gm - Bb chord progression, soaring vocal lead
#    48-55 Post-Chorus: arpeggio hook front & centre, Simmons tom fills
#    56-71 Verse 2: stripped back groove, counter-arp, bass cutoff build
#    72-87 Chorus 2 & Climax: full wall of sound, energetic electronic funk
#    88-95 Outro: arpeggio vamp & vocal refrain over driving bass, echo tail
#    96    End cleanup
# ======================================================================

[YAZOO - DONT GO] puts
M 128 16

## INLINE K-SYNTH RISER (one-shot wave 301)
[
/ riser: exponential sweep + highpass noise, zero DC
N: 131072
T: !N
E: (e(T*(4.6%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 900*(e(T*(2.7%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.6))
] k!
k>w301,44100,1

## DELAY BUSES
# Bus 1: Arp & Lead dotted-eighth ping-pong echo
DS 1 128 .75
DL 1 - - 8 3 3 10
DD 1 7 3
DP 1 1

# Bus 2: Bass slapback sixteenth (tight analog bounce)
DS 2 128 .25
DL 2 - - 4 0 0 8
DD 2 6 3

# Bus 3: Gated snare / clap 80s room tail
DS 3 128 .5
DL 3 - - 7 0 0 9
DD 3 5 4

# Bus 4: Synth brass hall wash
DS 4 128 .75
DL 4 - - 10 4 8 10
DD 4 8 2
DP 4 1

## VOICES
# Drums: four-on-the-floor kick + sub punch
v0 w82 f440 a7 p0
v5 w0 a-2 p0 t.001,.25,0,.08 j1 k160 q.7

# Crisp 80s snare, claps, hats, cowbell, crash
v1 w83 f440 a8 p0 r3 ds.25
v2 w84 f440 a-3 p.25
v3 w85 f440 a-2 p-.25
v4 w86 f440 a7 p0
v15 w96 f440 a3 p.2
v17 w94 f440 a4 p.2

# Simmons Electronic Toms (hi, mid, lo)
v18 w90 f480 a6 p-.3
v19 w91 f380 a6 p0
v20 w92 f280 a6 p.3

# Vince Clarke 16th Bass: snappy saw (centre) + detuned square (right), Character 2 drive
v6 w15 a-1 p0 t.001,.15,0,.04 j1,2 k520 q5 g.015 r2 ds.08
v6 >7
v7 w16 a-5 N0,8 p.4 r0
v6 G7 H7

# Arpeggio Lead: bright detuned saw/pulse pair with phase distortion c4, delay Bus 1
v11 w15 a-6 p0 t.002,.22,.4,.10 j1 k3800 q2.2 c4,.25 r1 ds.35
v11 >12
v12 w16 a-9 N0,9 p.55 r0
v11 G12 H12

# Alison Moyet Vocal Lead: rich, singing blues lead synth with subtle glide
v13 w15 a-6 p0 t.004,.35,.6,.25 j1,2 k3200 q1.8 g.02 c4,.20 r1 ds.3
v13 >14
v14 w15 a-8 N0,10 p-.5 r0
v13 G14 H14

# Staccato Synth Brass Stabs: detuned trio, sends to delay Bus 4
v8 w15 a-7 p0 t.002,.18,.3,.08 j1,2 k2600 q2.5 c4,.25 r4 ds.3
v8 >9
v8 >10
v9 w15 a-9 N0,12 p-.55 r0
v10 w16 a-10 N0,-12 p.55 r0
v8 G9,10 H9,10

# Alison Moyet Vocal Laugh / Cry FX (resonant formant pitch sweep)
v21 w15 a6 p0 t.01,.60,.2,.25 j1,2 k1600 q4 c2,.35 g.04

# Riser: stretched K-synth one-shot
v16 w301 f140 a8 p0 t.005,.01,1,.4 r4 ds.3

# Sub boom: audible sub drop + slowed kick
v38 w0 a0 p0 t.002,.90,0,.40 j1 k240 q.7 r3 ds.3
v40 w82 f110 a5 p0

# Pad: Poly pool, 2-voice prototype (detuned stereo saw pair), 5 instances at v28-v37
v24 w0 f.25 a0 t0,0,1,0 m1
v26 w15 a-10 p-.5 t1.2,.4,.8,1.4 j1 k2000 q.8 c4,.2 C24,.2 G27 H27
v27 w15 a-12 p.5 N0,8 t1.2,.4,.8,1.4 j1 k2000 q.8 c4,.2 C24,.2
/pg 0,26,2,0
/pp 0,0,28,5,0
v24 l1

