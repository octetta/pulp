## YAZOO - DON'T GO (Full Arrangement Instrumental Cover for PULP / SKRED)
#  128 BPM, B-flat minor, 96 bars (about 3:00). Vince Clarke & Alison Moyet (1982).
#  Self-contained: drums from built-in waves 82-99, inline K-synth riser.
#  Uses n>d to convert note name strings (with '-' rests) to MIDI note streams.
#  Load:   [dont_go.sk] /ls
#  Start:  play        Stop:  stop
#
#  VOICE MAP (all labeled via [name] vt):
#    v0  electronic kick (w82) + v5 sub punch (w0)
#    v1  gated 80s snare (w83) + v4 electronic clap (w86)
#    v2  closed hat (w84)  v3  open hat (w85)  v15 cowbell (w96)
#    v6  Vince Clarke bass saw (w15, centre) + v7 partner square (w16, right)
#    v8  synth brass centre (w15) + v9 partner saw (w15 left), v10 (w16 right)
#    v11 arpeggio lead centre (w15) + v12 partner pulse (w16)
#    v13 vocal lead synth centre (w15) + v14 partner saw (w15)
#    v16 K-synth build riser (w301)
#    v17 crash cymbal (w94)
#    v18 hi tom (w90)  v19 mid tom (w91)  v20 lo tom (w92) = Simmons tom roll
#    v21 Alison Moyet vocal laugh / cry FX (w15 formant glide)
#    v38 sub boom sine (w0) + v40 slowed kick sample (w82 f110)
#
#  DELAY BUSES:
#    Bus 1: Arp & Lead dotted-eighth echo (DS 1 128 .75, DP 1 1 ping-pong)
#    Bus 2: Vince Clarke bass 16th slapback (DS 2 128 .25)
#    Bus 3: Snare & Clap 80s gated room tail (DS 3 128 .5)
#    Bus 4: Synth brass & riser stereo wash (DS 4 128 .75, DP 4 1)
#
#  ARRANGEMENT (96 bars):
#    0-3   Intro: Alison's vocal laugh FX + 16th bassline enters alone
#    4-7   Signature synth brass hook explodes in with drums (Db5 - C5 - Bb4 - F4/F5)
#    8-15  Brass rests, Vince Clarke 16th arpeggio explodes in alone with drums & bass
#    16-31 Verse 1: vocal lead enters, staccato brass stabs on offbeats, arpeggio groove
#    32-47 Chorus 1: Gb - Ab - Bbm - Db progression, brass chords, vocal chorus hook
#    48-55 Post-Chorus: signature brass hook returns front & centre, Simmons fills
#    56-71 Verse 2: stripped back groove, vocal lead verse 2, filter cutoff sweep
#    72-87 Chorus 2 & Climax: full wall of sound, energetic electronic funk
#    88-95 Outro: arpeggio vamp & brass hook refrain over driving bass, echo tail
#    96    End cleanup
# ======================================================================

[YAZOO - DONT GO] puts
M 128 16

## INLINE K-SYNTH RISER (one-shot wave 301)
[
/ riser: exponential sweep + highpass noise, zero DC
N: 131072
T: !N
E: (e(T*(4.6%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 900*(e(T*(2.7%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.6))
] k!
k>w301,44100,1

## DELAY BUSES
# Bus 1: Arp & Lead dotted-eighth ping-pong echo
DS 1 128 .75
DL 1 - - 8 3 3 10
DD 1 7 3
DP 1 1

# Bus 2: Bass slapback sixteenth (tight analog bounce)
DS 2 128 .25
DL 2 - - 4 0 0 8
DD 2 6 3

# Bus 3: Gated snare / clap 80s room tail
DS 3 128 .5
DL 3 - - 7 0 0 9
DD 3 5 4

# Bus 4: Synth brass hall wash
DS 4 128 .75
DL 4 - - 10 4 8 10
DD 4 8 2
DP 4 1

## VOICES
# Drums: four-on-the-floor kick + sub punch
v0 w82 f440 a7 p0 [kick electronic] vt
v5 w0 a-2 p0 t.001,.25,0,.08 j1 k160 q.7 [kick sub punch] vt

# Crisp 80s snare, claps, hats, cowbell, crash
v1 w83 f440 a8 p0 r3 ds.25 [snare 80s gated] vt
v2 w84 f440 a-3 p.25 [closed hat] vt
v3 w85 f440 a-2 p-.25 [open hat] vt
v4 w86 f440 a7 p0 [electronic clap] vt
v15 w96 f440 a3 p.2 [cowbell] vt
v17 w94 f440 a4 p.2 [crash cymbal] vt

# Simmons Electronic Toms (hi, mid, lo)
v18 w90 f480 a6 p-.3 [hi simmons tom] vt
v19 w91 f380 a6 p0 [mid simmons tom] vt
v20 w92 f280 a6 p.3 [lo simmons tom] vt

# Vince Clarke 16th Bass: snappy saw (centre) + detuned square (right), Character 2 drive
v6 w15 a-1 p0 t.001,.15,0,.04 j1,2 k520 q5 g.015 r2 ds.08 [vince clarke bass saw] vt
v6 >7
v7 w16 a-5 N0,8 p.4 r0 [vince bass square] vt
v6 G7 H7

# The Iconic Synth Brass Hook (centre saw + detuned left/right stereo pair, delay Bus 4)
# Envelope has s=0 (decay to 0) so notes naturally articulate and never hang!
v8 w15 a-6 p0 t.002,.20,0,.08 j1,2 k2800 q2.5 c4,.25 r4 ds.3 [synth brass centre] vt
v8 >9
v8 >10
v9 w15 a-8 N0,12 p-.55 r0 [synth brass left] vt
v10 w16 a-9 N0,-12 p.55 r0 [synth brass right] vt
v8 G9,10 H9,10

# Arpeggio Lead: bright detuned saw/pulse pair with phase distortion c4, delay Bus 1
# Uses s=0 envelope for sharp, rhythmic Vince Clarke 16th staccato
v11 w15 a-6 p0 t.002,.18,0,.08 j1 k3800 q2.2 c4,.25 r1 ds.35 [arpeggio lead saw] vt
v11 >12
v12 w16 a-9 N0,9 p.55 r0 [arpeggio partner pulse] vt
v11 G12 H12

# Alison Moyet Vocal Lead: rich, singing blues lead synth with subtle glide
# Uses s=0 envelope (decay to 0) to avoid any stuck notes during arrangement transitions
v13 w15 a-6 p0 t.003,.28,0,.10 j1,2 k3200 q1.8 g.02 c4,.20 r1 ds.3 [alison vocal lead] vt
v13 >14
v14 w15 a-8 N0,10 p-.5 r0 [alison vocal partner] vt
v13 G14 H14

# Alison Moyet Vocal Laugh / Cry FX (resonant formant pitch sweep)
v21 w15 a6 p0 t.01,.60,0,.25 j1,2 k1600 q4 c2,.35 g.04 [alison laugh cry fx] vt

# Riser: stretched K-synth one-shot
v16 w301 f140 a8 p0 t.005,.01,1,.4 r4 ds.3 [ksynth build riser] vt

# Sub boom: audible sub drop + slowed kick
v38 w0 a0 p0 t.002,.90,0,.40 j1 k240 q.7 r3 ds.3 [sub boom sine] vt
v40 w82 f110 a5 p0 [slowed kick drop] vt

## EVENTS
[O DQ] /ceb 4 99
/cer 1

## STREAMS (Note arrays converted via n>d with '-' rests)
# Stream 1: Vince Clarke 16th Bassline in Bb minor (2 bars / 32 sixteenths)
# Notice '-' rests providing the authentic syncopated bounce!
[Bb1 Bb1 Bb2 Bb1  Bb1 Bb1 Bb2 Bb1  Bb1 Bb1 Bb2 Bb1  Ab1 - Ab1 -  Bb1 Bb1 Bb2 Bb1  Bb1 Bb1 Bb2 Bb1  Bb1 Bb1 Bb2 Bb1  Db2 - Eb2 -] n>d /SS 1

# Stream 2: Chorus Bassline Roots (Gb -> Ab -> Bbm -> Db, 2 bars / 32 sixteenths)
[Gb1 Gb1 Gb2 Gb1  Gb1 Gb1 Gb2 Gb1  Ab1 Ab1 Ab2 Ab1  Ab1 Ab1 Ab2 Ab1  Bb1 Bb1 Bb2 Bb1  Bb1 Bb1 Bb2 Bb1  Db2 Db2 Db3 Db2  Db2 Db2 Db3 Db2] n>d /SS 2

# Stream 3: The Famous Brass Hook (2 bars / 32 steps in Bb minor)
# Bar 1 has F4, Bar 2 leaps up to high F5!
[Db5 - Db5 - C5 - C5 - Bb4 F4 - F4 - Ab4 Bb4 Ab4  Db5 - Db5 - C5 - C5 - Bb4 F5 - F5 - Ab4 Bb4 Ab4] n>d /SS 3

# Stream 4: Vocal Lead Chorus Hook ('Baby don't go, baby don't go...', 2 bars / 32 steps)
[Db5 C5 Bb4 - Db5 C5 Bb4 - F5 - Eb5 Db5 C5 Bb4 - -  Db5 C5 Bb4 - Db5 C5 Bb4 - F5 - Ab5 Gb5 F5 Eb5 - -] n>d /SS 4

# Stream 5: Vocal Lead Verse 1 ('Came in from the city, walked into the door...', 4 bars / 64 steps)
[Bb4 Bb4 Bb4 Bb4 Ab4 F4 - - F4 Ab4 Bb4 - - - - -  Bb4 Bb4 Bb4 Bb4 Ab4 F4 - - F4 Ab4 Bb4 - - - - -  Db5 Db5 Db5 Db5 C5 Ab4 - - Ab4 C5 Db5 - - - - -  Eb5 Eb5 Eb5 Eb5 Db5 Bb4 - - F5 - - - - - - -] n>d /SS 5

# Stream 6: Vince Clarke 16th Arpeggio (4 bars / 64 steps)
[Bb3 Bb3 Bb3 - C4 Bb3 Bb3 Db4 Bb3 Eb4 Bb3 Bb3 F4 Bb3 Eb4 Db4  Bb3 Bb3 C4 Bb3 Db4 Bb3 Bb3 Eb4 Bb3 F4 Bb3 Bb3 Eb4 Bb3 Db4 Eb4  Ab3 - Ab3 Ab3 Bb3 Ab3 Ab3 C4 Ab3 Db4 Ab3 Ab3 Eb4 Ab3 Db4 C4  Gb3 - Gb3 Gb3 Ab3 Gb3 Gb3 Bb3 Gb3 C4 Gb3 Gb3 Db4 Gb3 C4 Bb3] n>d /SS 6

