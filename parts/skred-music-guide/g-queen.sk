## ============================================================================
##  TITLE MUSIC FROM A CLOCKWORK ORANGE (Wendy Carlos / Henry Purcell Z. 860)
##  "Music for the Funeral of Queen Mary" (Extended Realization)
##  Tempo: 60 BPM (16 steps per bar = 4.0 seconds per bar), Key: C Minor
##
##  Run in mini-skred:
##     [title_music_clockwork_orange.sk] /ls
##     play
##
##  VOICE MAP:
##    v0..v2   : Processional Timpani (Sub body, mallet transient, resonant head)
##    v3..v4   : Muffled Military Side Snare + Rim drag
##    v5       : Cathedral Gated Noise Wash / Gong shimmer
##    v6..v7   : Moog Trumpet 1 (Soprano lead + stereo detuned saw partner)
##    v8..v9   : Moog Trumpet 2 (Alto harmony + stereo partner)
##    v10..v11 : Moog Tenor Trombone (Tenor inner counterpoint + partner)
##    v12..v14 : Moog Bass Trombone + 16ft Contrabass Serpent Sub
##    v15..v17 : Rachel Elkind Vocoder Choir - Soprano Formant Trio
##    v18..v20 : Rachel Elkind Vocoder Choir - Alto Formant Trio
##    v21..v22 : Piercing High Moog Clarion (Climax octave descant)
##    v24      : Shared 5.2 Hz LFO for Choir & Brass tape vibrato
## ============================================================================

[A CLOCKWORK ORANGE - PURCELL FUNERAL MARCH (WENDY CARLOS REALIZATION)] puts
[Use 'play' to start, 'stop' to halt and clear cathedral echoes] puts

M 60 16

## ============================================================================
## 1. CATHEDRAL ACOUSTICS & DELAY BUSES (Tracks 1 - 4)
## ============================================================================
# Bus 1: Cathedral Hall Echo on Brass Lead & Timpani (dotted quarter @ 60 BPM)
DS 1 60 0.75
DL 1 - - 9 4 6 10
DD 1 6 3

# Bus 2: Wide Stereo Ping-Pong Choir & Clarion Cathedral Wash
DS 2 60 0.5
DL 2 - - 11 6 10 11
DD 2 7 4
DP 2 1

# Bus 3: Early Reflections Slapback for Inner Brass & Snare
DS 3 60 0.25
DL 3 - - 5 2 3 8
DD 3 5 4

# Bus 4: Deep Sub-Cathedral Shimmer Tail (1-beat long repeat, freeze-capable)
DS 4 60 1.0
DL 4 - - 12 5 8 10
DD 4 8 2
DP 4 1

## ============================================================================
## 2. VOICE DEFINITIONS
## ============================================================================

# --- Shared LFO (5.2 Hz Sine for Analog Vibrato / Formant Shimmer) ---
v24 w0 f5.2 a0 t0,0,1,0 m1 [vibrato lfo] vt
v24 l1

# --- Processional Timpani (Kettle Drums tuned to C and G) ---
v0 w0 a4 p0 t.003,.85,0,.45 j1 k220 q1.4 g.04 r1 ds.35 [timpani sub body] vt
v1 w82 f180 a3 p0 r1 ds.25 [timpani mallet thud] vt
v2 w88 f260 a1 p-.15 t.002,.55,0,.30 j1 k480 q2.0 [timpani kettle shell] vt
v0 H1,2

# --- Military Funeral Snare (Muffled Drum Corps) ---
v3 w83 f390 a1 p0 t.001,.24,0,.12 j1 k2800 q1.5 r3 ds.25 [funeral snare] vt
v4 w87 f440 a-2 p.2 [snare rim tap] vt

# --- Dark Cathedral Cymbal / Gong Roll ---
v5 w94 f240 a-3 p0 t.08,1.8,0,.9 j1 k1800 q1.2 r4 ds.45 [cathedral gong] vt

# --- Moog Soprano Trumpet 1 (v6 centered for Delay Bus 1, v7 panned R) ---
v6 w22 a-4 p0 t.018,.35,.82,.25 j1 k2800 q1.8 c4,.25 g.035 r1 ds.35 [moog trumpet 1] vt
v6 >7
v7 w15 a-7 N0,8 p.45 r0 ds0 [moog trumpet 1 partner] vt
v6 G7 H7

# --- Moog Alto Trumpet 2 (v8 centered for Delay Bus 3, v9 panned L) ---
v8 w15 a-5 p0 t.020,.35,.80,.25 j1 k2300 q1.6 c4,.20 g.035 r3 ds.25 [moog trumpet 2] vt
v8 >9
v9 w16 a-8 N0,-9 p-.45 r0 ds0 [moog trumpet 2 partner] vt
v8 G9 H9

# --- Moog Tenor Trombone (v10 centered, v11 panned R) ---
v10 w22 a-5 p0 t.025,.40,.80,.28 j1 k1850 q1.5 c2,.18 g.040 r3 ds.20 [moog tenor trombone] vt
v10 >11
v11 w15 a-8 N0,10 p.35 r0 ds0 [moog tenor partner] vt
v10 G11 H11

# --- Moog Bass Trombone & 16ft Contrabass Serpent (v12..v14) ---
v12 w15 a-3 p0 t.020,.45,.85,.30 j1,1 k1400 q2.2 c4,.30 g.045 r1 ds.20 [moog bass trombone] vt
v12 >13
v13 w16 a-6 N0,11 p-.30 r0 ds0 [bass reed partner] vt
v12 >14
v14 w80 a-5 N-12,0 p0 j1 k420 q1.2 r0 ds0 [16ft contrabass serpent] vt
v12 G13,14 H13,14

# --- Rachel Elkind Vocoder / Formant Choir: Soprano (v15..v17) ---
v15 w61 a-6 p0 t.06,.40,.85,.35 j1 k2600 q3.2 c4,.15 C24,.08 g.055 r2 ds.45 [vocoder soprano C] vt
v15 >16
v16 w69 a-9 N0,12 p-.60 r0 ds0 [vocoder soprano L] vt
v15 >17
v17 w70 a-9 N0,-12 p.60 r0 ds0 [vocoder soprano R] vt
v15 G16,17 H16,17

# --- Rachel Elkind Vocoder / Formant Choir: Alto (v18..v20) ---
v18 w62 a-7 p0 t.06,.40,.85,.35 j1 k2100 q3.0 c4,.15 C24,.08 g.055 r2 ds.40 [vocoder alto C] vt
v18 >19
v19 w71 a-10 N0,10 p-.50 r0 ds0 [vocoder alto L] vt
v18 >20
v20 w61 a-10 N0,-10 p.50 r0 ds0 [vocoder alto R] vt
v18 G19,20 H19,20

# --- High Clarion Moog Lead (Climax Descant, v21..v22) ---
v21 w76 a-6 p0 t.012,.30,.85,.30 j1 k4200 q2.0 c4,.30 C24,.05 g.030 r2 ds.40 [moog clarion] vt
v21 >22
v22 w22 a-8 N0,9 p.40 r0 ds0 [clarion partner] vt
v21 G22 H22

## ============================================================================
## 3. CLEANUP RESPONDER EVENT
## ============================================================================
[O DQ] /ceb 4 99
/cer 1

## ============================================================================
## 4. MUSICAL STREAMS (Notes, Ties `.`, Rests `-`, Legato Slurs `~Note`)
##    All March & Canzona streams are 128 steps (8 bars x 16 steps).
## ============================================================================

# --- INTRO STREAMS (64 steps = 4 bars: 3 Melting Glissandi + Timpani Pause) ---
# Bar 0: High cluster glissando down | Bar 1: Mid cluster glissando down | Bar 2: Low slide into C minor | Bar 3: Rest for Timpani
[ Ab5 . ~G4 .  . . . -   F5 . ~E4 .   . . . -   Eb5 . ~C4 .  . . . .  . . . -  - - - - ] n>d /SS 1
[ Eb5 . ~D4 .  . . . -   C5 . ~B3 .   . . . -   B4  . ~G3 .  . . . .  . . . -  - - - - ] n>d /SS 2
[ B4  . ~Ab3 . . . . -   Ab4 . ~G3 .  . . . -   G4  . ~Eb3 . . . . .  . . . -  - - - - ] n>d /SS 3
[ C3  . ~G1 .  . . . -   Ab2 . ~F1 .  . . . -   G2  . ~C2 .  . . . .  . . . -  - - - - ] n>d /SS 4

# --- MARCH SECTION A (128 steps = 8 bars): Purcell's Funeral March Theme ---
# Phrase 1 (Bars 0-3): Cm -> G/B -> Cm -> Ab -> Fm -> G -> Csus4 -> G
# Phrase 2 (Bars 4-7): Eb -> Bb/D -> Eb -> Fm7 -> G7 -> Cm -> G7 -> C (Picardy Tierce)

# Stream 11: Soprano (Trumpet 1) - 128 steps
[ Eb4 . . .  . . . -   D4  . . .  Eb4 . . -   F4  . ~Eb4 . D4  . ~C4 .  D4  . . .  . . . -
  G4  . . .  . . . -   F4  . . .  G4  . . -   Ab4 . ~G4 .  F4  . ~Eb4 . D4  . . .  ~B3 . . -
  G4  . . .  . . . -   F4  . . .  G4  . . -   Ab4 . ~G4 .  F4  . ~Eb4 . F4  . . .  . . . -
  Eb4 . . .  ~D4 . . - C4  . . .  ~B3 . . -   C4  . ~D4 .  B3  . . .    C4  . . .  . . . - ] n>d /SS 11

# Stream 12: Alto (Trumpet 2) - 128 steps
[ C4  . . .  . . . -   B3  . . .  C4  . . -   C4  . . .    B3  . ~G3 .  B3  . . .  . . . -
  Eb4 . . .  . . . -   D4  . . .  Eb4 . . -   F4  . ~Eb4 . D4  . ~C4 .  C4  . . .  ~G3 . . -
  Eb4 . . .  . . . -   D4  . . .  Eb4 . . -   C4  . . .    D4  . ~C4 .  D4  . . .  . . . -
  C4  . . .  ~B3 . . - G3  . . .  . . . -     Ab3 . . .    G3  . ~F3 .  E3  . . .  . . . - ] n>d /SS 12

# Stream 13: Tenor (Trombone) - 128 steps
[ G3  . . .  . . . -   G3  . . .  G3  . . -   Ab3 . ~G3 .  F3  . ~Eb3 . G3  . . .  . . . -
  Bb3 . . .  . . . -   Bb3 . . .  Bb3 . . -   C4  . ~Bb3 . Ab3 . ~G3 .  G3  . . .  ~D3 . . -
  Bb3 . . .  . . . -   Bb3 . . .  Bb3 . . -   F3  . ~G3 .  Ab3 . . .    Bb3 . . .  . . . -
  G3  . . .  ~F3 . . - Eb3 . . .  ~D3 . . -   Eb3 . ~F3 .  D3  . . .    G3  . . .  . . . - ] n>d /SS 13

# Stream 14: Bass (Bass Trombone & Serpent) - 128 steps
[ C2  . . .  . . . -   G2  . . .  C3  . . -   Ab2 . . .    F2  . ~Eb2 . G2  . . .  ~G1 . . -
  Eb2 . . .  . . . -   Bb2 . . .  Eb3 . . -   F2  . ~G2 .  Ab2 . . .    G2  . . .  ~G1 . . -
  Eb2 . . .  . . . -   Bb2 . . .  Eb2 . . -   F2  . ~Eb2 . D2  . ~C2 .  Bb1 . . .  ~Ab1 . . -
  G1  . . .  . . . -   C2  . . .  ~G1 . . -   Ab1 . ~F1 .  G1  . . .    C2  . . .  ~C1 . . - ] n>d /SS 14

# --- CANZONA / POLYPHONIC VARIATION SECTION B (128 steps = 8 bars) ---
# Features Wendy Carlos's intricate Baroque ornamentation, slurred eighth-note
# counterpoint, and soaring high register as heard at 00:46, 01:28, and 02:53.

# Stream 21: Soprano Ornate Variation (128 steps)
[ G4  . ~Ab4 . G4  . ~F4 .  Eb4 . ~D4 .  C4  . ~Eb4 -  F4  . ~G4 .  Ab4 . ~G4 .  F4  . ~Eb4 . D4  . . -
  Bb4 . ~C5 .  Bb4 . ~Ab4 . G4  . ~F4 .  Eb4 . ~G4 -   Ab4 . ~Bb4 . C5  . ~Bb4 . Ab4 . ~G4 .  F4  . . -
  C5  . . .    ~Bb4 . ~Ab4 . G4  . ~F4 . Eb4 . ~D4 -   C4  . ~D4 .  Eb4 . ~F4 .  G4  . ~Ab4 . G4  . . -
  Ab4 . ~G4 .  F4  . ~Eb4 . D4  . ~C4 .  B3  . ~D4 -   Eb4 . ~C4 .  D4  . ~B3 .  C4  . . .    . . . - ] n>d /SS 21

# Stream 22: Alto Ornate Counterpoint (128 steps)
[ Eb4 . . .    D4  . . .    C4  . ~B3 .  C4  . . -     C4  . ~Bb3 . Ab3 . ~C4 .  D4  . ~C4 .  B3  . . -
  Eb4 . . .    D4  . ~F4 .  Eb4 . ~D4 .  Eb4 . . -     F4  . ~G4 .  Ab4 . ~G4 .  F4  . ~Eb4 . D4  . . -
  Eb4 . ~F4 .  G4  . ~F4 .  Eb4 . ~D4 .  C4  . ~B3 -   Ab3 . ~B3 .  C4  . ~D4 .  Eb4 . ~F4 .  D4  . . -
  C4  . ~Eb4 . D4  . ~C4 .  B3  . ~A3 .  G3  . ~B3 -   C4  . ~Ab3 . G3  . . .    E3  . . .    . . . - ] n>d /SS 22

# Stream 23: Tenor Imitative Counterpoint (128 steps)
[ C4  . ~B3 .  Bb3 . ~Ab3 . G3  . ~F3 .  Eb3 . ~G3 -   Ab3 . ~G3 .  F3  . ~Eb3 . Ab3 . . .    G3  . . -
  G3  . ~Ab3 .Bb3 . . .     Bb3 . ~Ab3 . G3  . ~Bb3 -  C4  . ~Bb3 . Ab3 . ~Eb4 . D4  . ~C4 .  Bb3 . . -
  G3  . ~Ab3 . Bb3 . ~C4 .  Bb3 . ~Ab3 . G3  . ~F3 -   Eb3 . ~F3 .  G3  . ~Ab3 . Bb3 . ~C4 .  B3  . . -
  Eb3 . . .    F3  . ~G3 .  Ab3 . . .    D3  . ~G3 -   G3  . ~F3 .  G3  . ~D3 .  G3  . . .    . . . - ] n>d /SS 23

# Stream 24: Bass Walking Baroque Continuo (128 steps)
[ C2  . ~D2 .  Eb2 . ~F2 .  G2  . ~Ab2 . A2  . ~C3 -   Ab2 . ~Bb2 . C3  . ~Ab2 . F2  . ~G2 .  G1  . . -
  Eb2 . ~F2 .  G2  . ~Ab2 . Bb2 . ~C3 .  Db3 . ~Bb2 -  F2  . ~G2 .  Ab2 . ~F2 .  Bb2 . ~Ab2 . Bb1 . . -
  Ab2 . ~G2 .  F2  . ~Eb2 .Eb2 . ~F2 .  G2  . ~G1 -    Ab1 . ~B1 .  C2  . ~Ab1 . Eb2 . ~F2 .  G2  . . -
  F2  . ~Eb2 . D2  . ~C2 .  F2  . ~Eb2 . G2  . ~F2 -   Eb2 . ~Ab1 . G1  . . .    C2  . . .    ~C1 . . - ] n>d /SS 24

# --- HIGH CLARION DESCANT STREAM (128 steps = 8 bars, Octave Above Soprano) ---
[ Eb5 . . .  . . . -   D5  . . .  Eb5 . . -   F5  . ~Eb5 . D5  . ~C5 .  D5  . . .  . . . -
  G5  . . .  . . . -   F5  . . .  G5  . . -   Ab5 . ~G5 .  F5  . ~Eb5 . D5  . . .  ~B4 . . -
  G5  . . .  . . . -   F5  . . .  G5  . . -   Ab5 . ~G5 .  F5  . ~Eb5 . F5  . . .  . . . -
  Eb5 . . .  ~D5 . . - C5  . . .  ~B4 . . -   C5  . ~D5 .  B4  . . .    C5  . . .  . . . - ] n>d /SS 31

# --- K-SYNTH FILTER AUTOMATION CURVE (Stream 40: 64-point Slow Cathedral Sweep) ---
[1400 + (1800 * (s ((p 1) * ((!64)%63))))] k! k>d /SS 40

