# ======================================================================
#  HAMMER THE SIGNAL
#  industrial techno-pop for PULP/SKRED  -  134 BPM, E minor, ~2 minutes
#
#  Self-contained: drums are built-in waves 82-99, riser is inline k!.
#     [hammer_the_signal.sk] /ls
#
#  Engine features on show: K-synth drum samples, phase-distortion hook,
#  ring-mod clangs, FM(PM)+feedback metal stabs, filter-envelope reese
#  bass, screamer-filter 303 acid, 4 track-delay buses (tempo synced,
#  ping-pong, damping, freeze), voice links (G/H), glide, bitcrush,
#  step ratchets (z*), polymeter (12 vs 16 steps), pattern-as-automation
#  lanes, fake sidechain pump, and a one-step-per-bar conductor pattern
#  that arranges the whole song.
# ======================================================================

[HAMMER THE SIGNAL] puts
M 134 16

# ======================================================================
# INLINE K-SYNTH: riser one-shot -> wave 301 (drums are built-in waves 82-99)
# ======================================================================
[
/ riser: noise + exponential sine sweep, zero DC, rising envelope
N: 131072
T: !N
E: (e(T*(4.6%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 900*(e(T*(2.7%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.6))
] k!
k>w301,44100,1

# ======================================================================
# DELAY BUSES (track N feeds bus N)
# ======================================================================
DS 1 134 .75
DL 1 - - 8 3 3 11
DD 1 7 3
DS 2 134 .25
DL 2 - - 6 0 0 9
DD 2 5 4
DP 2 1
DS 3 134 .5
DL 3 - - 7 0 0 9
DD 3 6 5
DS 4 134 1
DL 4 - - 11 4 8 10
DD 4 8 2
DP 4 1

# ======================================================================
# VOICES
# ======================================================================
v0 w82 f440 a6 p0                          # kick
v1 w83 f440 a7 r2 p0 ds.2                    # snare
v2 w84 f440 a-3 p.25                        # closed hat
v3 w85 f440 a-2 p-.25                       # open hat
v4 w86 f440 a7 r2 p0 ds.3                    # clap
v5 w0 a-3 p0 t.002,.30,0,.10 j1 k180 q.7     # sub boom (pitch-dropped by glide)
v21 w94 f440 a5 p.2                         # crash
v22 w96 f440 a3 p-.3 r2 p0 ds.3              # cowbell
v23 w87 f440 a5 p.3                         # rim

# reese bass: two detuned saws, one note drives both (G/H links)
v6 w15 a-1 p0 t.002,.17,0,.06 j1 k650 q4 ft.001,.15,0,.05 fd2000
v6 >7
v7 N0,14
v6 G7 H7

# 303 acid: screamer filter, glide for slides, delay bus 3
v8 w15 a0 t.002,.20,0,.06 j1,2 k350 q10 ft.001,.18,0,.06 fd2600 g.03 r3 p0 ds.3

# industrial clang: ring mod of two inharmonic oscillators, crushed
v9 w16 f311 a0 t.001,.35,0,.2 bc5 r2 p0 ds.3 XM10 H10
v10 w15 f187 a0 t.001,.30,0,.2 m1

# fm clang solo (v18, v19)
v18 w0 f311 a0 t.001,.35,0,.2 FF2 FB6 F19,2.5 r2 p0 ds.3 H19
v19 w0 f187 a0 t.001,.30,0,.2 m1

# metal FM stab: phase-mod + operator feedback, modulator tracks pitch (+21 st)
v11 w0 a0 p-.35 t.001,.45,0,.35 FF2 FB4 F12,2.2 G12 H12
v12 w0 a0 t.001,.30,0,.30 N21 m1

# poppy hook: phase-distortion saw trio, detuned and spread
v13 w15 a-8 p0 t.004,.25,.4,.14 j1 k5200 q1.4 c4,.35 ct.001,.2,0,.1 cd.5 r1 ds.4
v13 >14
v13 >15
v14 N0,10 p-.55 r0
v15 w16 a-11 N0,-10 p.55 r0
v13 G14,15 H14,15

# chorus chops: vocal wavetable, crushed, wash bus
v17 w61 a-2 t.002,.18,.3,.1 j1 k4200 q1 bc8 r4 p0 ds.45
# riser: K-synth noise+sweep sample (sk/hammer-riser.ks), stretched to ~7 s by playback rate
v16 w301 f187 a8 p0 t.005,.01,1,.4 r4 ds.3
# pad: poly pool (POLYPHONY.md): 2-voice prototype (detuned saw pair, L/R), 5 instances -> v28..v37
v24 w0 f.31 a0 t0,0,1,0 m1
v26 w15 a-8 p-.5 t1.2,.4,.8,1.4 j1 k2400 q.8 c4,.2 C24,.2 G27 H27
v27 w15 a-10 p.5 N0,9 t1.2,.4,.8,1.4 j1 k2400 q.8 c4,.2 C24,.2
/pg 0,26,2,0
/pp 0,0,28,5,0
v24 l1

# ======================================================================
# EVENTS (EVENTS.md): hook phrase-start marker + end-of-song cleanup responder
# ======================================================================
y9 yc1
[v22 l.6] /ceb 5 9
[O DQ] /ceb 4 99
/cer 1

