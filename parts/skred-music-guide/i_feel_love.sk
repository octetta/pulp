v6 >7
v7 w16 a-7 N0,7 p.45 r0
v6 G7 H7

# soft lead approximating vocal contour (detuned trio)
v8 w15 a-9 p0 t.008,.35,.4,.25 j1 k2800 q1.1 c4,.2 r2 ds.25
v8 >9
v8 >10
v9 N0,8 p-.4 r0
v10 w16 a-12 N0,-8 p.4 r0
v8 G9,10 H9,10

# high sparkle / secondary arp
v13 w16 a-11 p-.35 t.001,.15,0,.06 j1 k4200 q1.4 r3 ds.2

# optional riser / impact
v16 w301 f220 a6 p0 t.004,.01,1,.35 r4 ds.25

# pad pool (warm detuned saws)
v24 w0 f.25 a0 t0,0,1,0 m1
v26 w15 a-9 p-.45 t1.4,.5,.7,1.6 j1 k1800 q.7 c4,.15 C24,.15 G27 H27
v27 w15 a-11 p.45 N0,6 t1.4,.5,.7,1.6 j1 k1800 q.7 c4,.15 C24,.15
/pg 0,26,2,0
/pp 0,0,28,5,0
v24 l1

## EVENTS (end-of-song cleanup)
[O DQ] /ceb 4 99
/cer 1

