## DONNA SUMMER / GIORGIO MORODER - I FEEL LOVE (Instrumental Cover for PULP / SKRED)
#  128 BPM, C minor / modal progression (C -> Eb -> F -> G), 96 bars (~3:00).
#  Produced by Giorgio Moroder & Pete Bellotte (1977).
#  Self-contained: drums from built-in waves 82-99, inline K-synth riser.
#  Uses n>d to convert note name strings (with '-' rests) to MIDI note streams.
#  Load:   [i_feel_love.sk] /ls
#  Start:  play        Stop:  stop
#
#  VOICE MAP (all labeled via [name] vt):
#    v0  four-on-the-floor kick (w82) + v5 sub boom (w0)
#    v1  disco snare (w83) + v4 electronic clap (w86)
#    v2  closed hat 16ths (w84)  v3  open hat offbeat (w85)
#    v6  Moog bass saw centre (w15) + v7 partner square (w16, right)
#    v8  Donna Summer vocal lead centre (w15) + v9 (left w15), v10 (right w16)
#    v11 Donna chorus falsetto lead centre (w15) + v12 partner (w16)
#    v13 high sparkle arpeggio centre (w16) + v14 partner saw (w15)
#    v16 K-synth build riser (w301)
#    v17 crash cymbal (w94)
#    v18 hi tom (w90)  v19 mid tom (w91)  v20 lo tom (w92) = Simmons tom roll
#    v21 Moroder white noise wind sweep (w5 resonant filter sweep)
#    v26 disco strings root (w15) + v27 3rd (w15 left), v28 5th (w16 right)
#
#  DELAY BUSES:
#    Bus 1: Moog bass 16th slapback / ping-pong gallop (DS 1 128 .25, DP 1 1)
#    Bus 2: Donna vocal lead tape echo (DS 2 128 .75, dotted eighth)
#    Bus 3: Snare & Clap room tail + sparkle arp slap (DS 3 128 .5)
#    Bus 4: Disco strings & riser stereo hall wash (DS 4 128 1, DP 4 1)
#
#  ARRANGEMENT (96 bars):
#    0-7   Intro: Lone Moog bass starts dark, 16th hats fade in, sparkle arp enters
#    8-15  Groove drops: 4-on-floor kick slams in, filter sweep opens, claps & strings
#    16-31 Verse 1: Donna Summer vocal lead ('Ooh, it's so good...'), C -> Eb -> F/G
#    32-47 Chorus 1: 'Ooh, I feel love...' soaring hook, sparkling arps, wall of sound
#    48-55 Breakdown: Drums drop out, delay freezes (DF 1 1), cosmic floating drone
#    56-63 Re-build: Kick returns, white noise wind rises, filter opens, tom roll build
#    64-79 Chorus 2 & Climax: Full wall of sound, energetic electronic funk
#    80-87 Extended Climax Vamp: High vocal ad-libs, modulating through C-Eb-F-G
#    88-95 Outro: Drums thin out, bass returns to C, hats half-time, final delay freeze
#    96    End cleanup
# ======================================================================

[DONNA SUMMER - I FEEL LOVE] puts
M 128 16

## INLINE K-SYNTH RISER (one-shot wave 301)
[
N: 65536
T: !N
E: (e(T*(4.2%N)))%100
R: r T
L: 0.32 f R
H: R-L
F: 750*(e(T*(2.5%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.55))
] k!
k>w301,44100,1

## DELAY BUSES
# Bus 1: Moog bass 16th slapback / ping-pong gallop (creates the Moroder pulse!)
DS 1 128 .25
DL 1 - - 8 2 2 11
DD 1 6 2
DP 1 1

# Bus 2: Donna Summer vocal lead dotted-eighth space echo
DS 2 128 .75
DL 2 - - 8 3 4 10
DD 2 7 2
DP 2 1

# Bus 3: Snare & Clap room tail + sparkle slap
DS 3 128 .5
DL 3 - - 6 1 1 8
DD 3 7 3

# Bus 4: Disco strings & riser stereo hall wash
DS 4 128 1
DL 4 - - 10 3 6 11
DD 4 7 2
DP 4 1

## VOICES
# Drums: four-on-the-floor kick + sub boom
v0 w82 f440 a7 p0 [kick electronic] vt
v5 w0 a-2 p0 t.001,.22,0,.06 j1 k160 q.7 [kick sub punch] vt

# Crisp disco snare, claps, hats, crash
v1 w83 f440 a7 p0 r3 ds.25 [snare 80s gated] vt
v2 w84 f440 a-3 p.25 [closed hat] vt
v3 w85 f440 a-2 p-.25 [open hat] vt
v4 w86 f440 a7 p0 [electronic clap] vt
v17 w94 f440 a4 p.2 [crash cymbal] vt

# Simmons Electronic Toms (hi, mid, lo)
v18 w90 f480 a6 p-.3 [hi simmons tom] vt
v19 w91 f380 a6 p0 [mid simmons tom] vt
v20 w92 f280 a6 p.3 [lo simmons tom] vt

# The Iconic Moog Modular Bassline: punchy resonant saw (centre) + detuned square (right)
# Sends ds.35 to Bus 1 for the famous galloping 16th tape-echo bounce!
v6 w15 a-2 p0 t.001,.14,0,.04 j1,2 k1200 q3.8 g0 r1 ds.35 [moog bass saw] vt
v6 >7
v7 w16 a-6 N0,8 p.45 r0 [moog bass square] vt
v6 G7 H7

# Donna Summer Vocal Lead (Verse): ethereal, floating singing synth with subtle glide
# Safe s=0 envelope (decay to 0) prevents any hanging notes across sections
v8 w15 a-6 p0 t.003,.35,0,.12 j1,2 k3400 q1.8 g.02 c4,.25 r2 ds.30 [donna vocal lead] vt
v8 >9
v8 >10
v9 w15 a-8 N0,10 p-.5 r0 [donna vocal left] vt
v10 w16 a-9 N0,-10 p.5 r0 [donna vocal right] vt
v8 G9,10 H9,10

# Donna Summer Chorus Falsetto Hook ('I feel love, I feel love...')
v11 w15 a-5 p0 t.003,.30,0,.10 j1,2 k3800 q2.0 g.015 c4,.25 r2 ds.35 [donna chorus hook] vt
v11 >12
v12 w16 a-8 N0,9 p.5 r0 [donna chorus partner] vt
v11 G12 H12

# High Sparkle Arpeggio: bright detuned pulse/saw pair with phase distortion c4, delay Bus 3
v13 w16 a-9 p-.35 t.001,.16,0,.06 j1 k4500 q2.0 c4,.2 r3 ds.25 [high sparkle arp] vt
v13 >14
v14 w15 a-11 N0,12 p.35 r0 [sparkle partner saw] vt
v13 G14 H14

# Giorgio Moroder White Noise Wind Sweep (resonant filter wash)
v21 w5 a-5 p0 t.04,1.4,0,.4 j1,1 k600 q4 [moroder noise wind] vt

# Riser: stretched K-synth one-shot
v16 w301 f220 a6 p0 t.005,.01,1,.35 r4 ds.3 [ksynth riser] vt

# 1970s Solina / ARP Disco Strings (Trio: Root, 3rd, 5th, delay Bus 4)
v26 w15 a-8 p0 t.06,.50,.4,.30 j1 k2200 q1.2 c4,.2 r4 ds.3 [disco strings root] vt
v27 w15 a-9 p-.55 t.06,.50,.4,.30 j1 k2200 q1.2 c4,.2 r4 ds.3 [disco strings 3rd] vt
v28 w16 a-9 p.55 t.06,.50,.4,.30 j1 k2200 q1.2 c4,.2 r4 ds.3 [disco strings 5th] vt

## EVENTS
[O DQ] /ceb 4 99
/cer 1

## STREAMS (Note arrays converted via n>d with '-' rests)
# Stream 1: Active Moog Bassline (16 steps / 1 bar, starts in C minor)
# Note pattern: C2 C2 C3 C3  G2 G2 Bb2 Bb2  C2 C2 C3 C3  G2 G2 Bb2 Bb2
[C2 C2 C3 C3  G2 G2 Bb2 Bb2  C2 C2 C3 C3  G2 G2 Bb2 Bb2] n>d /SS 1

# Stream 2: Bank - C Minor Bass Cell
[C2 C2 C3 C3  G2 G2 Bb2 Bb2  C2 C2 C3 C3  G2 G2 Bb2 Bb2] n>d /SS 2

# Stream 3: Bank - Eb Major Bass Cell
[Eb2 Eb2 Eb3 Eb3  Bb2 Bb2 Db3 Db3  Eb2 Eb2 Eb3 Eb3  Bb2 Bb2 Db3 Db3] n>d /SS 3

# Stream 4: Bank - F Major Bass Cell
[F2 F2 F3 F3  C3 C3 Eb3 Eb3  F2 F2 F3 F3  C3 C3 Eb3 Eb3] n>d /SS 4

# Stream 5: Bank - G Minor / G7 Bass Cell
[G2 G2 G3 G3  D3 D3 F3 F3  G2 G2 G3 G3  D3 D3 F3 F3] n>d /SS 5

# Stream 6: Donna Summer Verse Vocal ('Ooh, it's so good...', 4 bars / 64 steps)
[G5 - - -  F5 - Eb5 -  D5 - C5 -  - - - -  G5 - - -  F5 - Eb5 -  D5 - C5 -  - - - -  Bb5 - - -  Ab5 - G5 -  F5 - Eb5 -  - - - -  C6 - - -  Bb5 - Ab5 -  G5 - F5 -  - - - -] n>d /SS 6

# Stream 7: Donna Summer Chorus Vocal ('Ooh, I feel love...', 4 bars / 64 steps)
[C5 - D5 -  Eb5 - G5 -  F5 - Eb5 -  C5 - - -  C5 - D5 -  Eb5 - G5 -  F5 - Eb5 -  C5 - - -  Eb5 - F5 -  G5 - Bb5 -  Ab5 - G5 -  Eb5 - - -  F5 - G5 -  Ab5 - C6 -  Bb5 - Ab5 -  G5 - - -] n>d /SS 7

# Stream 8: Active Sparkle Arp (16 steps / 1 bar, starts in C)
[C5 Eb5 G5 C6  Eb5 G5 C6 Eb6  C5 Eb5 G5 C6  Eb5 G5 C6 Eb6] n>d /SS 8

# Stream 9: Bank - Sparkle Arp in Eb
[Eb5 G5 Bb5 Eb6  G5 Bb5 Eb6 G6  Eb5 G5 Bb5 Eb6  G5 Bb5 Eb6 G6] n>d /SS 9

# Stream 10: Bank - Sparkle Arp in F
[F5 A5 C6 F6  A5 C6 F6 A6  F5 A5 C6 F6  A5 C6 F6 A6] n>d /SS 10

# Stream 11: Bank - Sparkle Arp in G
[G5 Bb5 D6 G6  Bb5 D6 G6 Bb6  G5 Bb5 D6 G6  Bb5 D6 G6 Bb6] n>d /SS 11

