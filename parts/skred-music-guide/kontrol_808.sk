# ======================================================================
#  KONTROL 808 (Heavy Industrial / Cyber-Grind)
#  Inspired by KMFDM and 808 State
#  136 BPM, D minor, Heavy Industrial Metal & Acid-Rave Machine
# ======================================================================

[KONTROL 808 - INDUSTRIAL CYBER-GRIND] puts
V -7.2
M 136 16

# ----------------------------------------------------------------------
# DELAY BUSES (tempo synced to 136 BPM)
# ----------------------------------------------------------------------
# Bus 1: 16th industrial slapback
DS 1 136 .25
DL 1 - - 6 0 0 9
DD 1 5 4

# Bus 2: Eighth note ping-pong rave echo (808 State style)
DS 2 136 .5
DL 2 - - 7 0 0 10
DD 2 6 4
DP 2 1

# Bus 3: Dotted-eighth metallic echo
DS 3 136 .75
DL 3 - - 8 3 3 11
DD 3 7 3

# Bus 4: Heavy industrial hall wash
DS 4 136 1.0
DL 4 - - 11 4 8 10
DD 4 8 2
DP 4 1

# ----------------------------------------------------------------------
# VOICES
# ----------------------------------------------------------------------
# DRUMS: Roland TR-808 + Industrial Machine Percussion
v0 w82 f440 a5 p0                           # 808 kick punch
v1 w83 f440 a5.5 r2 p0 ds.25                # industrial snare
v2 w84 f440 a-3 p.25                        # 808 closed hat
v3 w85 f440 a-2 p-.25                       # 808 open hat
v4 w86 f440 a5 r2 p0 ds.3                   # 808 clap
v5 w0 a-2.5 p0 t.002,.32,0,.10 j1 k160 q.7  # 808 sub boom (pitch dive)
v21 w94 f440 a3 p.2                         # crash cymbal
v22 w96 f440 a3.5 p-.25 r2 ds.3             # 808 cowbell (808 State signature!)
v23 w87 f440 a5 p.3                         # rim tick / anvil edge

# INDUSTRIAL METAL CLANG (Ring Mod of inharmonic oscillators)
v18 w16 f415 a-3 t.001,.30,0,.15 bc6 r2 p0 ds.35 XM19 H19
v19 w15 f261 a0 m1

# FM FEEDBACK METAL STRIKE (Heavy Anvil Hit)
v11 w0 a-2 p-.3 t.001,.35,0,.2 FF2 FB6 F12,2.8 G12 H12 r2 ds.3
v12 w0 a0 t.001,.25,0,.2 N26 m1

# RISER (inline K-synth industrial noise sweep)
[
/ industrial noise riser
N: 131072
T: !N
E: (e(T*(4.5%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 950*(e(T*(2.8%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.65))
] k!
k>w301,44100,1
v16 w301 f190 a8 p0 t.005,.01,1,.3 r4 ds.3  # noise riser

# BASS 1: KMFDM Industrial Guitar/Synth Chug (Detuned Moog Saw + Pulse Octave)
v6 w15 a-2 p0 t.002,.15,0,.04 j1,1 k650 q4.5 ft.001,.13,0,.03 fd2800 c4,.45
v6 >7
v7 w16 a-4 N12,9 p0
v6 G7 H7

# BASS 2: 808 State "Cubik" Acid Screamer (High-Q Gliding Saw)
v8 w15 a-3 t.002,.18,0,.05 j1,2 k400 q9.0 ft.001,.16,0,.05 fd3200 g.035 r2 p0 ds.35

# BASS 3: Sub-Bass Reinforcer (Drops & Climax)
v10 w0 a-1 p0 t.002,.25,.2,.08 j1 k250 q1.5

# LEAD 1: KMFDM Industrial Siren / Screamer Hook Trio
v13 w15 a-8 p0 t.004,.22,.4,.10 j1,1 k5400 q1.8 c4,.4 r1 ds.4
v13 >14
v13 >15
v14 w15 a-10 p-.6 N0,10 r0
v15 w16 a-10 p.6 N0,-10 r0
v13 G14,15 H14,15

# LEAD 2: 808 State Heavy Parallel Rave Stabs (Detuned Saw 5ths)
v9 w15 a-6 p-.2 t.002,.20,0,.08 j1,1 k3800 q2.2 r2 ds.3 G20 H20
v20 w15 a-8 p.2 N7 m0

# POLYPHONIC INDUSTRIAL PAD POOL (Cold Cyber-Strings)
v24 w0 f.32 a0 t0,0,1,0 m1
v26 w15 a-10 p-.5 t1.0,.4,.7,1.2 j1 k2400 q.8 c4,.2 C24,.2 G27 H27
v27 w15 a-12 p.5 N0,9 t1.0,.4,.7,1.2 j1 k2400 q.8 c4,.2 C24,.2
/pg 0,26,2,0
/pp 0,0,28,5,0
v24 l1

# ----------------------------------------------------------------------
# STREAMS (Notes via n>d)
# ----------------------------------------------------------------------

# Stream 1: KMFDM Industrial Metal Chug (16 steps = 1 bar in D minor)
# D1 D1 . D1  F1 - D1 -  Ab1 - G1 -  D1 - F1 -
[ D1 D1 . D1  F1 - D1 -  Ab1 - G1 -  D1 - F1 - ] n>d /SS 1

# Stream 2: 808 State "Cubik" Rave-Industrial Stabs (32 steps = 2 bars)
[
  D2 D2 F2 D2  - G2 - Ab2  F2 - D2 -  C2 - D2 -
  D2 D2 F2 D2  - G2 - C3   B2 - Ab2 - G2 - F2 -
] n>d /SS 2

# Stream 3: KMFDM Relentless 16th Sequencer Ostinato (32 steps = 2 bars)
[
  D2 D2 D3 D2  F2 D2 Ab2 G2  D2 D2 D3 D2  C3 B2 A2 F2
  D2 D2 D3 D2  F2 D2 Ab2 G2  D2 D2 D3 D2  F3 E3 D3 C3
] n>d /SS 3

# Stream 13: Industrial Siren Lead - Memory Bank (4 bars / 64 steps)
[
  D5 - - -  Ab5 - G5 -  F5 - D5 -  C5 - D5 -
  D5 - - -  Ab5 - G5 -  F5 - - -  E5 - - -
  D5 - - -  Ab5 - G5 -  F5 - D5 -  F5 - G5 -
  Ab5 - - - G5 - - -  F5 - E5 -  D5 - C5 -
] n>d /SS 13
/SC 4 13

# Stream 14: High Siren Climax Variation - Memory Bank (4 bars / 64 steps)
[
  D6 - - -  Ab6 - G6 -  F6 - D6 -  C6 - D6 -
  D6 - - -  Ab6 - G6 -  F6 - - -  E6 - - -
  D6 - - -  Ab6 - G6 -  F6 - D6 -  F6 - G6 -
  Ab6 - - - G6 - - -  F6 - E6 -  D6 - C6 -
] n>d /SS 14

# Stream 5: 808 State Acid Screamer Riff (with slides) (32 steps = 2 bars)
[
  D2 . ~F2 .  ~G2 . ~Ab2 .  ~G2 . ~F2 .  ~D2 . ~C2 .
  D2 . ~F2 .  ~G2 . ~C3 .   ~B2 . ~Ab2 . ~G2 . ~F2 .
] n>d /SS 5

# Stream 6: Dark Pre-Drop Pad Chords (4 bars: Dm -> Bb -> Gm -> A)
[
  D3 . . .  . . . .  . . . .  . . . .
  Bb2 . . . . . . .  . . . .  . . . .
  G2 . . .  . . . .  . . . .  . . . .
  A2 . . .  . . . .  . . . .  . . . .
] n>d /SS 6

