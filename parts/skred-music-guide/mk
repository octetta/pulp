#!/bin/bash
a='hammer_the_signal.sk
dont_go.sk
closer.sk
whip_it.sk
i_feel_love.sk
sweet_dreams.sk
uncontrollable_urge.sk
tainted_love.sk
pocket-calc.sk
run_to_the_sun.sk
title_music_clockwork_orange.sk'
for i in $a
do
b=$(basename $i .sk)
z=$(printf "%s.zip" $b)
cp $i main.sk
echo $z
zip -q $z main.sk
done
rm -f main.sk
