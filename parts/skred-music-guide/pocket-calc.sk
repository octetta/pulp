# “little melody” – pure high tone (the calculator voice)
v13 w0 a-6 p.2 t.001,.25,0,.12 j1 k4800 q.8 r2 ds.15

# soft texture / noise bed
v16 w5 f800 a-14 p0 t.01,.4,0,.3 j2 k1800 q.6

# warm pad (very restrained)
v24 w0 f.22 a0 t0,0,1,0 m1
v26 w15 a-14 p-.4 t1.6,.5,.7,1.8 j1 k1600 q.5 c4,.1 C24,.1 G27 H27
v27 w15 a-16 p.4 N0,4 t1.6,.5,.7,1.8 j1 k1600 q.5 c4,.1 C24,.1
/pg 0,26,2,0
/pp 0,0,28,4,0
v24 l1

