## POCKET CALCULATOR (instrumental cover) for PULP/SKRED
#  126 BPM, electronic pop, 88 bars (~2:47). Instrumental only.
#  Self-contained: 100% synthesized Kraftwerk analog electronic drums
#  (pitch-drop sine kick, noise snap snare, micro-tick hats),
#  Minimoog motorik bass, iconic Casio VL-80 calculator voice, and warm poly pad.
#     [pocket-calc.sk] /ls      then:   play     (stop:  stop)
#
#  Inspired by Kraftwerk's 1981 classic from 'Computer World'.
#  Key elements:
#    - Steady motorik 4/4 electronic pulse with syncopated step-10 kick
#    - Deep sequenced Minimoog bass with octave sub
#    - Bright pulse/saw lead for the main riff
#    - Distinct high "little melody" (Casio calculator motif)
#    - Sparse, precise arrangement with clean voice releases via l0
#
#  VOICE MAP
#    v0 kick (sine pitch drop) + v4 kick click transient
#    v1 snare (noise snap bc4) + v15 snare body tone
#    v2 closed micro-tick hat   v3 open hat sizzle   v5 noise transition wash
#    v6 motorik bass (centre) + v7 sub bass octave partner
#    v8 main lead (bright pulse) + v9 detuned saw partner
#    v13 little melody / Casio VL-80 voice (pure high tone) + v14 octave partner
#    v16 soft noise / texture bed
#    v24 pad LFO   v26-v27 pad prototype   v28-v35 pad pool
#  DELAY BUSES
#    1  clean 16th slapback on lead / Casio
#    2  longer wash on pad / melody
#  PATTERNS
#    0 conductor   1 kick   2 snare   3 hats
#    6 bass        8 main lead   9 little melody   10 melody variation
#    11 pad        13 fill       14 pump
# ======================================================================

[POCKET CALCULATOR] puts
M 126 16

## DELAY BUSES (clean and restrained)
DS 1 126 .25
DL 1 - - 3 0 0 7
DD 1 9 4
DS 2 126 .75
DL 2 - - 6 1 1 9
DD 2 7 3

## VOICES
# Drums: 100% Pure Kraftwerk Synthesized Analog Percussion
# Electronic Kick: Pure sine wave with fast pitch drop + transient click
v0 w0 a5 p0 t.001,.14,0,.03 g0 n60 g.025 n36 [kraftwerk electronic kick] vt
v0 >4
v4 w5 a-6 p0 t.001,.012,0,.005 k4000 q2.0 [kick click transient] vt
v0 G4 H4

# Electronic Snare: Tight white noise snap with bitcrusher + analog tone body
v1 w5 a5 p0 t.001,.09,0,.02 j1 k2600 q3.5 bc4 r2 ds.15 [kraftwerk noise snap snare] vt
v1 >15
v15 w1 a-3 p0 t.001,.07,0,.02 n55 [snare body tone] vt
v1 G15 H15

# Micro-tick Hats: Crisp synthetic clicks
v2 w5 a-5 p.15 t.001,.02,0,.005 k6800 q4.0 [electronic micro-tick hat] vt
v3 w5 a-4 p-.15 t.001,.12,0,.04 k5500 q3.0 [electronic open sizzle] vt

# Transition Noise Wash (used on section downbeats)
v5 w5 a-4 p.1 t.01,.7,0,.2 j2 k3200 q.8 [electronic noise wash] vt

# Minimoog Motorik Bass: Saw wave driven into resonant ladder filter + sub square
# Level balanced cleanly to maintain headroom and punch without distortion
v6 w15 a-2 p0 t.002,.14,0,.04 j1 k900 q2.8 [kraftwerk motorik bass saw] vt
v6 >7
v7 w1 a-6 N-12,0 p0 r0 [motorik sub square] vt
v6 G7 H7

# Main Lead: Bright, slightly phase-distorted pulse/saw lead
v8 w16 a-6 p0 t.003,.18,0,.06 j1 k3200 q1.2 c4,.15 r1 ds.18 [kraftwerk lead synth] vt
v8 >9
v9 w15 a-9 N0,5 p.35 r0 [kraftwerk lead partner] vt
v8 G9 H9

# "Little Melody" - Pure high Casio VL-Tone / VL-80 handheld calculator voice
v13 w0 a-5 p.2 t.001,.20,0,.08 j1 k4500 q.9 r2 ds.15 [casio vl-tone pure tone] vt
v13 >14
v14 w1 a-8 N0,12 p-.2 r0 [casio octave bleep partner] vt
v13 G14 H14

# Soft texture / noise bed
v16 w5 f800 a-14 p0 t.01,.4,0,.3 j2 k1800 q.6 [soft noise bed] vt

# Warm polyphonic pad (very restrained, classic vintage analog string machine)
v24 w0 f.22 a0 t0,0,1,0 m1
v26 w15 a-14 p-.4 t1.6,.5,.7,1.8 j1 k1600 q.5 c4,.1 C24,.1 G27 H27
v27 w15 a-16 p.4 N0,4 t1.6,.5,.7,1.8 j1 k1600 q.5 c4,.1 C24,.1
/pg 0,26,2,0
/pp 0,0,28,4,0
v24 l1

