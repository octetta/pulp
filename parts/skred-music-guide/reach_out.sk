# ======================================================================
#  REACH OUT (Violator / Personal Jesus Era Tribute)
#  112 BPM, E minor, Swung Blues-Electro Stomp
# ======================================================================

[REACH OUT - VIOLATOR ERA TRIBUTE] puts
V -7.3
M 112 16

# ----------------------------------------------------------------------
# DELAY BUSES (tempo synced to 112 BPM)
# ----------------------------------------------------------------------
# Bus 1: Dotted-eighth stereo lead echo (Alan Wilder signature)
DS 1 112 .75
DL 1 - - 8 3 3 11
DD 1 7 3

# Bus 2: 16th slapback echo for guitar riff
DS 2 112 .25
DL 2 - - 6 0 0 9
DD 2 5 4

# Bus 3: Eighth note ping-pong echo
DS 3 112 .5
DL 3 - - 7 0 0 10
DD 3 6 4
DP 3 1

# Bus 4: Dark cathedral hall wash
DS 4 112 1.0
DL 4 - - 11 4 8 10
DD 4 8 2
DP 4 1

# ----------------------------------------------------------------------
# VOICES
# ----------------------------------------------------------------------
# DRUMS (Stomping Blues Beat + Metal Plates)
v0 w82 f440 a5.5 p0                          # acoustic punch kick
v1 w83 f440 a6.0 r2 p0 ds.25                 # dry backbeat snare
v2 w84 f440 a-3.5 p.2                        # closed hat / shaker
v3 w85 f440 a-2 p-.2                         # open hat
v4 w86 f440 a5.5 r4 p0 ds.35                 # cathedral footstomp / clap
v5 w0 a-2.5 p0 t.002,.35,0,.12 j1 k150 q.7   # sub kick weight (pitch drop)
v21 w94 f440 a3.5 p.2                        # crash cymbal
v22 w96 f380 a3.0 p-.3 r2 ds.3               # stamped metal plate / chain
v23 w87 f440 a4.5 p.25                       # acoustic rim tick

# RISER (inline K-synth dark breath / noise sweep)
[
/ dark noise riser
N: 131072
T: !N
E: (e(T*(4.2%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 750*(e(T*(2.5%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.3)+(H*.7))
] k!
k>w301,44100,1
v16 w301 f170 a7.5 p0 t.005,.01,1,.3 r4 ds.3  # dark riser

