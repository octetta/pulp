## SWEET DREAMS (instrumental cover sketch) for PULP/SKRED
#  125 BPM, C minor, 40 bars (~1:17).  Instrumental only - no vocal/lyrics.
#  Load:   [sweet_dreams.sk] /ls      then:   play     (stop:  stop)
#  UNTESTED / UNHEARD.  Notes are from my recollection of the song:
#  all pitch material is in the STREAMS section - fix notes there only.
#  Chords: Cm | Ab | Fm | G   (4 bars, one chord per bar)
#  Sections start with a '##' line so you can run them one at a time.

[SWEET DREAMS cover sketch] puts
M 125 16

## DELAY BUS 1 (hook echo)
DS 1 125 .75
DL 1 - - 8 3 3 11
DD 1 7 3

## VOICES
v0 w82 f440 a6 p0                              # kick
v1 w83 f440 a7 p0                              # snare
v2 w84 f440 a-3 p.25                            # closed hat
v3 w85 f440 a-2 p-.25                           # open hat
v4 w86 f440 a5 p0                              # clap
v5 w94 f440 a4 p.2                              # crash

# SH-101 style sequenced bass: saw, resonant LP, short filter env
v6 w15 a-1 p0 t.002,.16,0,.05 j1 k700 q3 ft.001,.12,0,.05 fd1800

# Oberheim-ish lead: detuned saw trio, centre voice feeds delay
v8 w15 a-8 p0 t.01,.30,.5,.30 j1 k3200 q1.2 c4,.25 r1 ds.3
v8 >9
v8 >10
v9 N0,9 p-.5 r0
v10 w16 a-11 N0,-9 p.5 r0
v8 G9,10 H9,10

# Juno-ish pad: poly pool (copied from hammer_the_signal pattern)
v24 w0 f.31 a0 t0,0,1,0 m1
v26 w15 a-8 p-.5 t1.2,.4,.8,1.4 j1 k2400 q.8 c4,.2 C24,.2 G27 H27
v27 w15 a-10 p.5 N0,9 t1.2,.4,.8,1.4 j1 k2400 q.8 c4,.2 C24,.2
/pg 0,26,2,0
/pp0,0,28,5,0
v24 l1

## EVENTS (end-of-song cleanup responder)
[O DQ] /ceb 4 99
/cer 1

## STREAMS (all pitch material lives here - edit to correct notes)
# bass: 8 eighth-notes per bar x 4 bars (Cm, Ab, Fm, G); octave pulse
( 36 48 36 48 36 48 36 46  32 44 32 44 32 44 32 43  29 41 29 41 29 41 29 40  31 43 31 43 31 43 31 41 ) /SS 1
# bass velocities (one bar)
( 1 .7 .85 .7 1 .7 .85 .7 ) /SS 2
# lead: two long notes per bar
( 67 63 68 63 68 65 67 62 ) /SS 3


