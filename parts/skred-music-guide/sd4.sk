## SWEET DREAMS (instrumental cover sketch) for PULP/SKRED
#  125 BPM, C minor, 40 bars (~1:17).  Instrumental only - no vocal/lyrics.
#  Load:   [sweet_dreams.sk] /ls      then:   play     (stop:  stop)
#  UNTESTED / UNHEARD.  Riff notes taken from published bass tabs:
#  all pitch material is in the STREAMS section - fix notes there only.
#  Bass = 2-bar, 9-note riff C C C Eb C | Ab Ab G G, rhythm inferred from
#  ASCII bass tabs (so the timing is a best guess - see RIFF_STEPS).
#  Pad: Cm | Ab Gm, looped (intro harmony per a published chord chart).
#  Sections start with a '##' line so you can run them one at a time.

[SWEET DREAMS cover sketch] puts
M 125 16

## DELAY BUS 1 (hook echo)
DS 1 125 .75
DL 1 - - 8 3 3 11
DD 1 7 3

# ---- delay bus 2 (bass echo, dotted eighth) ----
DS 2 125 .75
DL 2 - - 5 0 0 10
DD 2 7 3

## VOICES
v0 w82 f440 a6 p 0                              # kick
v1 w83 f440 a7 p 0                              # snare
v2 w84 f440 a-3 p.25                            # closed hat
v3 w85 f440 a-2 p-.25                           # open hat
v4 w86 f440 a5 p 0                              # clap
v5 w94 f440 a4 p.2                              # crash

# SH-101 style sequenced bass: saw, resonant LP (no filter env: ft/fd rejected at load)
v6 w15 a-1 p 0 t.002,.20,0,.05 j1 k900 q2.5 r2 ds.3

# Oberheim-ish lead: detuned saw trio, centre voice feeds delay
v8 w15 a-8 p 0 t.01,.30,.5,.30 j1 k3200 q1.2 c4,.25 r1 ds.3
v8 >9
v8 >10
v9 N0,9 p-.5 r0
v10 w16 a-11 N0,-9 p.5 r0
v8 G9,10 H9,10

# Juno-ish pad: poly pool (copied from hammer_the_signal pattern)
v24 w0 f.31 a0 t0,0,1,0 m1
v26 w15 a-8 p-.5 t1.2,.4,.8,1.4 j1 k2400 q.8 c4,.2 C24,.2 G27 H27
v27 w15 a-10 p.5 N0,9 t1.2,.4,.8,1.4 j1 k2400 q.8 c4,.2 C24,.2
/pg 0,26,2,0
/pp 0,0,28,5,0
v24 l1

