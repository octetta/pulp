## SWEET DREAMS (instrumental cover, full arrangement) for PULP/SKRED
#  125 BPM, C minor, 96 bars (about 3:04). Instrumental only, no vocals or lyrics.
#  Self-contained: drums are built-in waves 82-99, riser is an inline K-synth.
#     [sweet_dreams_full.sk] /ls      then:   play     (stop:  stop)
#
#  Built from the hammer_the_signal.sk architecture: voices, streams, patterns,
#  and a one-step-per-bar conductor (pattern 0) that arranges the whole song.
#
#  THE RIFF: a constant eighth-note line, 16 notes over 2 bars, played all song:
#     C C C C Eb Eb C C | Ab Ab Ab C G G G C      (harmony: Cm | Ab then Gm)
#  GUESSES (not verified, edit freely):
#    - the 2nd intermittent riff (pattern 7) placement of its 12 notes
#    - the boom and noise blast on the 2nd bar of the loop (pattern 15)
#    - the lead notes (pattern 8), the drum feel, and every mix level
#  UNTESTED and UNHEARD at the time of writing.
#
#  VOICE MAP
#    v0 kick  v1 snare  v2 closed hat  v3 open hat  v4 clap  v5 crash
#    v6 bass saw (centre) + v7 partner square (right)   = the constant riff
#    v8 lead (centre) + v9, v10 partners                = placeholder lead
#    v13 left-panned square                             = the 2nd, intermittent riff
#    v16 riser   v24 pad LFO   v26 v27 pad prototype   v28-v37 pad pool
#    v38 sub boom  v39 noise blast  v40 slowed kick sample (boom layer)
#  DELAY BUSES  1 lead/pad echo (dotted eighth)  2 bass slapback (sixteenth)
#               3 boom tail  4 riser wash
#  PATTERNS  0 conductor  1 kick  2 snare+clap  3 hats 8ths  6 riff  7 left riff
#            8 lead  11 pad  13 snare roll  14 pump  15 boom  16 cutoff sweep
#            18 hats 16ths
#  SECTIONS
#     0-3 riff alone    4-7 hats+pad, bass filter opens    8-15 verse (drums in)
#     12 left riff in   16-19 lead in    20-23 build + riser + roll
#     24-39 chorus A    40-47 breakdown (delay freeze, riser)
#     48-63 chorus B    64-71 bridge and build    72-87 final chorus
#     88-95 outro       96 end and cleanup
# ======================================================================

[SWEET DREAMS] puts
M 125 16

## INLINE K-SYNTH (riser one-shot to wave 301, copied from hammer_the_signal.sk)
[
/ riser: noise + exponential sine sweep, zero DC, rising envelope
N: 131072
T: !N
E: (e(T*(4.6%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 900*(e(T*(2.7%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.6))
] k!
k>w301,44100,1

## DELAY BUSES (track N feeds bus N)
DS 1 125 .75
DL 1 - - 8 3 3 11
DD 1 7 3
DS 2 125 .25
DL 2 - - 3 0 0 8
DD 2 7 3
DS 3 125 .75
DL 3 - - 8 0 0 10
DD 3 5 4
DS 4 125 1
DL 4 - - 11 4 8 10
DD 4 8 2
DP 4 1

## VOICES
v0 w82 f440 a6 p0                                # kick
v1 w83 f440 a7 p0                                # snare
v2 w84 f440 a-3 p.25                             # closed hat
v3 w85 f440 a-2 p-.25                            # open hat
v4 w86 f440 a5 p0                                # clap
v5 w94 f440 a4 p.2                               # crash

# constant riff: saw plus detuned square partner on the right, slight bass slapback
v6 w15 a-1 p0 t.002,.20,0,.05 j1 k900 q2.5 r2 ds.08
v6 >7
v7 w16 a-5 N0,9 p.5 r0
v6 G7 H7

# left-panned intermittent riff (octave up, plucky square)
v13 w16 a-9 p-.5 t.002,.18,0,.05 j1 k2600 q1

# placeholder lead: detuned saw trio, centre voice feeds delay bus 1
v8 w15 a-8 p0 t.01,.30,.5,.30 j1 k3200 q1.2 c4,.25 r1 ds.3
v8 >9
v8 >10
v9 N0,9 p-.5 r0
v10 w16 a-11 N0,-9 p.5 r0
v8 G9,10 H9,10

# riser: K-synth noise and sweep, stretched by playback rate, wash bus 4
v16 w301 f187 a8 p0 t.005,.01,1,.4 r4 ds.3

# boom: audible sub drop, slowed kick sample, noise blast
v38 w0 a0 p0 t.002,.90,0,.40 j1 k260 q.7 r3 ds.3
v39 w5 f2000 a-8 p0 t.001,.30,0,.20 j2 k1200 q.7
v40 w82 f110 a4 p0

# pad: poly pool, 2-voice prototype (detuned saw pair, L/R), 5 instances at v28-v37
v24 w0 f.31 a0 t0,0,1,0 m1
v26 w15 a-8 p-.5 t1.2,.4,.8,1.4 j1 k2400 q.8 c4,.2 C24,.2 G27 H27
v27 w15 a-10 p.5 N0,9 t1.2,.4,.8,1.4 j1 k2400 q.8 c4,.2 C24,.2
/pg 0,26,2,0
/pp 0,0,28,5,0
v24 l1

## EVENTS (end-of-song cleanup responder)
[O DQ] /ceb 4 99
/cer 1

