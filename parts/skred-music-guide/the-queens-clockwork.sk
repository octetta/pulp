# ======================================================================
#  THE QUEEN'S CLOCKWORK  (PULP / SKRED Skode)
#  A new electronic arrangement after Henry Purcell's public-domain march
#  from Music for the Funeral of Queen Mary (1695).
#
#  60 BPM | C minor | slow processional / dark electro-baroque
#  Written using hammer-v2.sk as a structural reference.
#
#  DESIGN:
#    - three descending opening glissandi, then a solitary timpani/sub strike
#    - four-part, linked Moog-brass chorale with wide octave support
#    - a marching bass, side-snare and sparse metallic clock ticks
#    - a cold choir/string bed, rising dissonance, then a stripped final cadence
#    - unified `i` streams use note-on, tie (.), rest (-), and legato (~Note)
#
#  This is a fresh arrangement, not a transcription of Wendy Carlos's recording.
#  Load: [the-queens-clockwork.sk] /ls
#  Start: play
# ======================================================================

[THE QUEENS CLOCKWORK] puts
M 60 16

# ----------------------------------------------------------------------
# DELAY: long, dark cathedral reflections with restrained feedback for headroom
# ----------------------------------------------------------------------
DS 1 60 .5
DL 1 - - 5 1 2 8
DD 1 6 3
DS 2 60 .25
DL 2 - - 4 0 0 6
DD 2 5 3
DP 2 1
DS 3 60 .75
DL 3 - - 5 1 2 6
DD 3 7 3

# ----------------------------------------------------------------------
# VOICES: keep the brass family centered with partners adding width without delay
# ----------------------------------------------------------------------
# Timpani / low funeral pulse
v0  w82 f180 a2 p0 [timpani mallet] vt
v1  w0  f65  a-2 p0 t.002,.75,0,.35 j1 k180 q.8 [sub funeral drum] vt
v2  w83 f440 a0 p0 [military side snare] vt
v3  w87 f440 a-5 p.2 [clock rim] vt
v4  w84 f440 a-8 p-.2 [clock dust] vt
v5  w94 f440 a-4 p0 [cathedral crash] vt

# Moog brass: main voices use dark, harmonically rich band-limited tables.
# Linked partners are quieter and detuned/panned for size.
v8  w22 a-3 p0 t.01,.35,.22,.22 j1 k2600 q1.5 r1 ds.18 [trumpet one] vt
v8  >9
v9  w15 a-8 N0,7 p-.45 r0 [trumpet one width] vt
v8  G9 H9

v10 w22 a-5 p0 t.015,.4,.18,.25 j1 k2100 q1.2 r1 ds.12 [trumpet two] vt
v10 >11
v11 w16 a-9 N0,-6 p.45 r0 [trumpet two width] vt
v10 G11 H11

v12 w23 a-4 p0 t.02,.5,.15,.3 j1 k1450 q1.0 r1 ds.1 [tenor trombone] vt
v12 >13
v13 w16 a-9 N0,5 p-.3 r0 [trombone width] vt
v12 G13 H13

v14 w16 a-2 p0 t.02,.65,.12,.35 j1 k850 q1.2 r1 ds.08 [bass trombone serpent] vt
v14 >15
v15 w15 a-8 N0,-5 p.3 r0 [serpent width] vt
v14 G15 H15

# The high glass note and a frozen string-cloud, used sparingly.
v16 w0 a-8 p0 t.01,.5,0,.25 j1 k3000 q1.2 r2 ds.25 [glass warning tone] vt
v17 w79 a-10 p-.5 t.5,.8,.5,1.2 j1 k1900 q.8 r3 ds.2 [digital funeral strings left] vt
v17 >18
v18 w24 a-12 N0,8 p.5 r0 [digital funeral strings right] vt

# Three linked descending opening gliss voices. These are deliberately
# original sound-design gestures, not a copy of the Carlos recording.
v20 w15 a-7 p0 t.01,.3,0,.18 j1 k1800 q2.2 g.12 r2 ds.2 [melting brass glide] vt
v20 >21
v21 w16 a-11 N0,5 p-.35 r0 [glide shadow] vt
v20 G21 H21

# A dry, quiet electronic tick to make the slow march feel clockwork.
v22 w96 f440 a-10 p.25 [clock bell] vt

# ----------------------------------------------------------------------
# NOTE STREAMS
# Every stream read below is aligned to a 64-step / four-bar phrase.
# Each step is a sixteenth. Dots tie the previous note and '-' releases it.
# Slur tokens (~Note) change pitch without a fresh envelope attack.
# The melody is a new, compact C-minor march statement shaped around the
# source work's stark chromatic ceremonial character.
# ----------------------------------------------------------------------

# Main brass statement: four-bar C-minor phrase, with tied sixteenths.
[ C5 . . . Db5 . . . Db5 . . . C5 . . . - . . . C5 . . . Eb5 . . . D5 . . . C5 . . . - . . . C5 . . . F5 . . . F#5 . . . G5 . . . - . . . Eb5 . . . ] n>d /SS 1
# Bass line: measured C / Ab / F / G gravity with rests.
[ C2 . . . - . . . C2 . . . G1 . . . Ab1 . . . - . . . Ab1 . . . Eb2 . . . F1 . . . - . . . F1 . . . C2 . . . G1 . . . - . . . G1 . . . D2 . . . ] n>d /SS 2
# Counterline: ties and slurs add a baroque sheen.
[ G4 . . . ~Ab4 . . . G4 . . . F4 . . . Eb4 . . . . . . . D4 . . . ~Eb4 . . . F4 . . . . . . . Ab4 . . . G4 . . . D4 . . . . . . . G4 . . . F#4 . . . ] n>d /SS 3
# High warning line: real rests leave cold space around the brass.
[ - . . . - . . . G5 . . . - . . . - . . . - . . . Ab5 . . . G5 . . . - . . . - . . . F5 . . . - . . . - . . . Eb5 . . . D5 . . . - . . . ] n>d /SS 4
# Independent copy for the isolated glass pattern so the stream heads never collide.
[ - . . . - . . . G5 . . . - . . . - . . . - . . . Ab5 . . . G5 . . . - . . . - . . . F5 . . . - . . . - . . . Eb5 . . . D5 . . . - . . . ] n>d /SS 5

# ----------------------------------------------------------------------
# PATTERNS
# ----------------------------------------------------------------------
# y1: slow timpani march, two-bar cycle with a few deliberate silences.
y1
[timpani procession] yt
[v0 l.85 v1 g0 n36 g.04 n30 l.8] x0
[v0 l.45] x8
[v0 l.7 v1 g0 n36 g.04 n30 l.7] x16
[v0 l.35] x24
[v0 l.8 v1 g0 n36 g.04 n30 l.8] x32
[v0 l.45] x40
[v0 l.65 v1 g0 n36 g.04 n30 l.65] x48
[v0 l.35] x56
[=127,0] x63

# y2: main four-part chorale. Each voice reads the same phrase length.
y2
[main brass chorale] yt
[v8 i&1,.92] x0,1,2,3,4,5,6,7
[v8 i&1,.92] x8,9,10,11,12,13,14,15
[v8 i&1,.92] x16,17,18,19,20,21,22,23
[v8 i&1,.92] x24,25,26,27,28,29,30,31
[v8 i&1,.92] x32,33,34,35,36,37,38,39
[v8 i&1,.92] x40,41,42,43,44,45,46,47
[v8 i&1,.92] x48,49,50,51,52,53,54,55
[v8 i&1,.92] x56,57,58,59,60,61,62,63

# Low line and counterline: independent phrases add actual counterpoint.
y3
[serpent bass line] yt
[v14 i&2,.88] x0,1,2,3,4,5,6,7
[v14 i&2,.88] x8,9,10,11,12,13,14,15
[v14 i&2,.88] x16,17,18,19,20,21,22,23
[v14 i&2,.88] x24,25,26,27,28,29,30,31
[v14 i&2,.88] x32,33,34,35,36,37,38,39
[v14 i&2,.88] x40,41,42,43,44,45,46,47
[v14 i&2,.88] x48,49,50,51,52,53,54,55
[v14 i&2,.88] x56,57,58,59,60,61,62,63

y4
[inner brass counterpoint] yt
[v12 i&3,.7] x0,1,2,3,4,5,6,7
[v12 i&3,.7] x8,9,10,11,12,13,14,15
[v12 i&3,.7] x16,17,18,19,20,21,22,23
[v12 i&3,.7] x24,25,26,27,28,29,30,31
[v12 i&3,.7] x32,33,34,35,36,37,38,39
[v12 i&3,.7] x40,41,42,43,44,45,46,47
[v12 i&3,.7] x48,49,50,51,52,53,54,55
[v12 i&3,.7] x56,57,58,59,60,61,62,63

y5
[high warning counterline] yt
[v16 i&4,.5] x0,1,2,3,4,5,6,7
[v16 i&4,.5] x8,9,10,11,12,13,14,15
[v16 i&4,.5] x16,17,18,19,20,21,22,23
[v16 i&4,.5] x24,25,26,27,28,29,30,31
[v16 i&4,.5] x32,33,34,35,36,37,38,39
[v16 i&4,.5] x40,41,42,43,44,45,46,47
[v16 i&4,.5] x48,49,50,51,52,53,54,55
[v16 i&4,.5] x56,57,58,59,60,61,62,63

# y6: dry side-snare and clockwork ticks. Keep it military, not dance music.
y6
[side snare and clock] yt
[v2 l.65] x0
[v3 l.45] x4
[v2 l.4] x8
[v22 l.25] x12
[v2 l.55] x16
[v3 l.4] x20
[v2 l.35] x24
[v22 l.25] x28
[v2 l.65] x32
[v3 l.45] x36
[v2 l.4] x40
[v22 l.3] x44
[v2 l.55] x48
[v3 l.4] x52
[v2 l.35] x56
[v22 l.25] x60
[=127,0] x63

# y7: string-cloud chords with restrained slow decay.
y7
[funeral string cloud] yt
[v17 f130 l.5 v18 f130 l.35] x0
[v17 f155 l.45 v18 f155 l.3] x16
[v17 f174 l.45 v18 f174 l.3] x32
[v17 f196 l.4 v18 f196 l.25] x48
[=127,0] x63

# y8: three ominous gliss gestures, separated by space.
y8
[melting opening glissandi] yt
[v20 g0 n84 g.12 n72 l.75] x0
[v20 g0 n79 g.12 n67 l.7] x4
[v20 g0 n74 g.12 n62 l.7] x8
[v20 l0] x12
[=127,0] x15
[-] x16

# y9: isolated glass warning notes.
y9
[glass warning] yt
[v16 i&5,.5] x0,1,2,3,4,5,6,7
[v16 i&5,.5] x8,9,10,11,12,13,14,15


# ----------------------------------------------------------------------
# CONDUCTOR: 48 bars. The opening is almost empty and the march gradually
# becomes a huge, dissonant brass machine, then collapses to a bare cadence.
# ----------------------------------------------------------------------
y0
[conductor] yt
%16
# Bars 0-3: descending glissandi, single timpani strike, then silence.
[y8 z1] x0
[=126,1] x1
[=126,2] x2
[y1 z1 v0 l.8] x3
[=126,4] x4
[=126,5] x5
[=126,6] x6
[=126,7] x7

# Bars 8-15: first statement, bass enters before the brass.
[y7 z1 y3 z1] x8
[=126,9] x9
[y2 z1] x10
[=126,11] x11
[y4 z1] x12
[=126,13] x13
[y9 z1] x14
[=126,15] x15

# Bars 16-23: full procession with clockwork percussion.
[y1 z1 y2 z1 y3 z1 y4 z1 y6 z1] x16
[=126,17] x17
[=126,18] x18
[y5 z1] x19
[=126,20] x20
[=126,21] x21
[y9 z1] x22
[=126,23] x23

# Bars 24-31: heavier statement, higher line and more metallic pressure.
[v5 l.55 y5 z1 y6 z1] x24
[=126,25] x25
[y9 z1] x26
[=126,27] x27
[v5 l.6] x28
[=126,29] x29
[=126,30] x30
[=126,31] x31

# Bars 32-39: strip to bass + glass, let the room ring.
[y2 z0 y4 z0 y5 z0 y6 z0 y1 z0 v8 l0 v10 l0 v12 l0 v14 l0 y9 z1] x32
[=126,33] x33
[=126,34] x34
[=126,35] x35
[y7 z0] x36
[=126,37] x37
[=126,38] x38
[=126,39] x39

# Bars 40-43: brass returns in a controlled, solemn crescendo.
[y1 z1 y2 z1 y3 z1 y4 z1 y6 z1] x40
[=126,41] x41
[/SP 4 0 y5 z1] x42
[v5 l.65] x43

# Bars 44-47: final chorale, then an exposed C-minor cadence.
[y9 z0 y5 z0 y6 z0 v16 l0 v8 l0 v10 l0 v12 l0 v14 l0] x44
[/SP 1 0 /SP 2 0 /SP 3 0 y2 z1 y3 z1 y4 z1 y7 z1] x45
[=126,46] x46
[v5 l.5 y1 z0 y6 z0 y7 z0] x47

[use 'play' to start the piece, 'stop' to stop it] puts
[play] : Z0 y0 z1 ;
[stop] : Z0 O DQ ;
