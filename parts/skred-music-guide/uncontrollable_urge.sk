## UNCONTROLLABLE URGE (DEVO) - Showcase Cover for PULP/SKRED
#  184 BPM, key of A, 136 bars (about 2:57).
#  Written by Mark Mothersbaugh & Gerald Casale (1978, Q: Are We Not Men? A: We Are Devo!).
#  Self-contained: drums from built-in waves 82-99.
#  Uses n>d to convert note name strings to MIDI streams.
#     [devo_uncontrollable_urge.sk] /ls      then:   play     (stop:  stop)
#
#  VOICE MAP (all labeled via [name] vt):
#    v0  kick motorik (w82)  v1  snare 70s crack (w83)
#    v2  closed hat (w84)    v3  open hat (w85)    v5  crash cymbal (w94)
#    v6  Gerald Casale bass saw (w15) + v7 partner square (w16)
#    v8  Bob Mothersbaugh guitar root (w15) + v9 fifth (+7), v10 octave (+12)
#    v11 FM metal stab (w0) + v12 stab modulator (w0)
#    v13 Mark Mothersbaugh vocal lead (w15) + v14 partner pulse (w16)
#    v15 Minimoog quirky bleep saw (w15) + v16 pulse partner (w16)
#
#  DELAY BUSES:
#    Bus 1: FM metal stab & vocal echo (DS 1 184 .75, DL 1 - - 6 2 2 9, DD 1 7 3)
#    Bus 2: Bass slapback sixteenth (DS 2 184 .25, DL 2 - - 4 0 0 8, DD 2 6 3)
#
#  SECTIONS (bar numbers):
#     0-7   intro (y4 solo bass -> +drums -> +guitar chug -> +FM stab -> snare roll)
#     8-15  start-stop break 1 (groove + 'YEAH!' shouts -> dead stop FM stab echo)
#     16-31 verse 1: driving A drone + guitar chug + Minimoog bleeps + vocal lead
#     32-47 chorus 1: E -> D -> A power chords + Minimoog squeals + vocal hook
#     48-55 start-stop break 2
#     56-71 verse 2: 'Got an urge, I wanna purge, cause I'm losing control...'
#     72-87 chorus 2
#     88-95 start-stop break 3
#     96-111 final chorus: maximum energy wall of sound
#     112-135 outro vamp: relentless motorik drive + frantic vocal chanting
#     136   hard stop, crash hit & cleanup
# ======================================================================

[UNCONTROLLABLE URGE] puts
M 184 16

## DELAY BUSES
# Bus 1: FM metal stab echo (dotted eighth delay, gives that eerie cavernous DEVO space)
DS 1 184 .75
DL 1 - - 6 2 2 9
DD 1 7 3

# Bus 2: Bass slapback sixteenth
DS 2 184 .25
DL 2 - - 4 0 0 8
DD 2 6 3

## VOICES
v0 w82 f440 a6 p0 [kick motorik] vt
v1 w83 f440 a7 p0 r3 ds.18 [snare 70s crack] vt
v2 w84 f440 a-3 p.25 [closed hat] vt
v3 w85 f440 a-2 p-.25 [open hat] vt
v5 w94 f440 a4 p.2 [crash cymbal] vt

# bass: plucky saw plus detuned square partner on the right
v6 w15 a-1 p0 t.002,.14,.25,.06 j1 k1300 q1.8 r2 ds.08 [bass saw] vt
v6 >7
v7 w16 a-6 N0,8 p.4 [bass square] vt
v6 G7 H7

# guitar power chord from ONE note: v8 root, v9 fifth, v10 octave, bright and spread
v8 w15 a-8 p-.25 t.002,.09,.15,.05 j1 k3800 q.7 c4,.15 [guitar root] vt
v8 >9
v8 >10
v9 N7 a-10 p.3 [guitar fifth] vt
v10 N12 a-12 p-.5 [guitar octave] vt
v8 G9,10 H9,10

# metal FM stab (copied from hammer_the_signal.sk), modulator tracks pitch
v11 w0 a-2 p-.35 t.001,.45,0,.35 FF2 FB4 F12,2.2 G12 H12 r1 ds.25 [fm metal stab] vt
v12 w0 a0 t.001,.30,0,.30 N21 m1 [stab modulator] vt

# Mark Mothersbaugh vocal lead: punchy staccato synth lead with safe s=0 envelope
v13 w15 a-3 p0 t.003,.16,0,.04 j1 k3600 q2.0 r1 ds.20 [devo vocal lead] vt
v13 >14
v14 w16 a-7 N0,12 p.25 [vocal partner pulse] vt
v13 G14 H14

# Minimoog quirky synth bleeps & squeals
v15 w15 a-3 p-.20 t.001,.08,0,.03 j1 k2800 q4.0 r1 ds.20 [minimoog bleep saw] vt
v15 >16
v16 w16 a-7 N0,12 p.20 [minimoog bleep pulse] vt
v15 G16 H16

## EVENTS (end-of-song cleanup responder)
[O DQ] /ceb 4 99
/cer 1

