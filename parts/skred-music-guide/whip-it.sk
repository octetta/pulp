/cer 1

## STREAMS (Note arrays converted via n>d with '-' rests)
# Stream 1: DEVO iconic main riff (E E E E A B D -) – 1 bar of eighths
[E2 E2 E2 E2 A2 B2 D3 -] n>d /SS 1

# Stream 2: Main riff velocities / accents
[1 .75 .9 .75 1 .85 1 -] n>d /SS 2

# Stream 3: Verse ending turnaround (A G F# E)
[A2 A2 G2 G2 F#2 F#2 E2 -] n>d /SS 3

# Stream 4: Chorus bass roots (C G D C, 2 bars of eighths)
[C2 C2 C2 C2 C2 C2 C2 C2  G1 G1 G1 G1 G1 G1 G1 G1  D2 D2 D2 D2 D2 D2 D2 D2  C2 C2 C2 C2 C2 C2 C2 C2] n>d /SS 4

# Stream 5: Verse 1 Vocal Line ('Crack that whip! ... Give the past a slip!')
# 2 bars / 32 sixteenth steps
[B3 - B3 - B3 - - - - - - - - - - -  B3 - B3 - B3 - B3 - B3 - - - - - - -] n>d /SS 5

# Stream 6: Chorus Vocal Line ('When a problem comes along... you must whip it!')
# 4 bars / 64 sixteenth steps
[G4 - E4 - G4 - E4 - G4 - E4 - G4 - - -  - - E4 - G4 - E4 - E4 - - - - - - -  A4 - F#4 - A4 - F#4 - A4 - F#4 - A4 - F#4 -  - - E4 - G4 - E4 - E4 - - - - - - -] n>d /SS 6

# Stream 7: Bob Mothersbaugh's Angular Synth Solo (2 bars / 32 eighth notes)
[E4 G4 A4 B4  D5 B4 A4 G4  E4 G4 A4 B4  D5 E5 D5 B4  E4 G4 A4 B4  D5 B4 A4 G4  A4 B4 D5 E5  G5 E5 D5 B4] n>d /SS 7

