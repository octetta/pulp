## DEVO - WHIP IT (Full Instrumental Cover for PULP / SKRED)
#  158 BPM, E Mixolydian / E Major, 92 bars (~2:20).
#  Self-contained: drums from built-in waves 82-99, inline K-synth riser.
#  Uses slowed snare sample (w83 at f175) for the authentic whip crack sound!
#  Uses n>d to convert note name strings (with '-' rests) to MIDI streams.
#  Load:   [whip_it.sk] /ls
#  Start:  play        Stop:  stop
#
#  VOICE MAP:
#    v0  motorik electronic kick (w82)
#    v1  crisp 80s snare (w83) + v4 electronic clap (w86)
#    v2  closed hat (w84)  v3  open hat (w85)  v5  crash cymbal (w94)
#    v6  Moog bass saw (w15, centre)
#    v7  Moog bass partner square (w16, right, linked to v6)
#    v8  guitar-style chug (w16, left, linked to v6)
#    v11 guitar / synth solo voice (w15) + v12 partner pulse (w16, linked to v11)
#    v13 vocal lead synth (w15) + v14 partner saw (w15, linked to v13)
#    v16 K-synth build riser (w301)
#    v21 slowed snare whip crack (w83 at f175, delay Bus 1)
#    v22 whip initial transient crack (w87)
#    v23 whip leather lash tail (w5 noise)
#    v18 chorus synth stab left (w15) + v19 right (w15), v20 centre (w16, linked to v18)
#
#  DELAY BUSES:
#    Bus 1: Whip crack & lead slapback (DS 1 158 .25, DL 1 - - 5 0 0 9)
#    Bus 2: Bass slapback sixteenth (DS 2 158 .25, DL 2 - - 4 0 0 8)
#    Bus 3: Gated snare room (DS 3 158 .5, DL 3 - - 6 0 0 9)
#    Bus 4: Synth chorus wash (DS 4 158 .75, DL 4 - - 10 4 8 10, DP 4 1)
#
#  ARRANGEMENT (92 bars):
#    0-3   Intro drums (Alan Myers motorik beat enters)
#    4-11  Iconic 2-bar riff enters (A -> B1 -> A -> B2) with whip cracks on 2 & 4
#    12-19 Verse 1: 'Crack that whip!' + whip cracks after vocal calls
#    20-27 Pre-chorus 1: 'When a problem comes along, you must whip it!'
#    28-35 Chorus 1: C - G - D - C progression, synth chords + whip cracks
#    36-43 Return to main riff + whip accents
#    44-51 Verse 2: 'When something's going wrong...'
#    52-59 Pre-chorus 2 + riser sweep
#    60-67 Chorus 2
#    68-75 Bob Mothersbaugh's angular synth/guitar solo
#    76-83 Final Chorus: full explosive wall of sound, continuous whip snaps
#    84-91 Outro vamp & final whip crack flurry
#    92    End cleanup
# ======================================================================

[DEVO - WHIP IT] puts
M 158 16

## INLINE K-SYNTH RISER (one-shot wave 301)
[
/ riser: exponential sweep + highpass noise, zero DC
N: 131072
T: !N
E: (e(T*(4.6%N)))%100
R: r T
L: 0.35 f R
H: R-L
F: 900*(e(T*(2.7%N)))*((p 2)%(p 0))
P: +\F
S: s P
W: w E*((S*.35)+(H*.6))
] k!
k>w301,44100,1

## DELAY BUSES
# Bus 1: Whip crack & lead slapback
DS 1 158 .25
DL 1 - - 5 0 0 9
DD 1 8 3

# Bus 2: Bass slapback sixteenth
DS 2 158 .25
DL 2 - - 4 0 0 8
DD 2 6 3

# Bus 3: Snare room tail
DS 3 158 .5
DL 3 - - 6 0 0 9
DD 3 5 4

# Bus 4: Synth chorus wash
DS 4 158 .75
DL 4 - - 10 4 8 10
DD 4 8 2
DP 4 1

## VOICES
# Motorik drums (Alan Myers style)
v0 w82 f440 a7 p0 [kick motorik] vt
v1 w83 f440 a8 p0 r3 ds.25 [snare 80s] vt
v2 w84 f440 a-3 p.25 [closed hat] vt
v3 w85 f440 a-2 p-.25 [open hat] vt
v4 w86 f440 a6 p0 [electronic clap] vt
v5 w94 f440 a4 p.2 [crash cymbal] vt

# Moog bass + guitar trio: v6 (centre saw), v7 (right square), v8 (left guitar chug)
# Linked via G and H so v7 and v8 track v6 note and gate automatically!
v6 w15 a-1 p0 t.001,.18,0,.04 j1,2 k1800 q3.5 r2 ds.08 [moog bass saw] vt
v6 >7
v7 w16 a-5 N0,7 p.4 r0 [moog bass square] vt
v6 >8
v8 w16 a-6 N0,0 p-.35 t.001,.15,0,.03 j1 k3200 q1 c4,.15 [guitar chug] vt
v6 G7 H7 G8 H8

# DEVO Solo Lead: bright saw/pulse pair with phase distortion c4, delay Bus 1
v11 w15 a-6 p0 t.002,.20,0,.10 j1 k3800 q2.2 c4,.25 r1 ds.35 [solo lead saw] vt
v11 >12
v12 w16 a-9 N12,9 p.55 r0 [solo partner pulse] vt
v11 G12 H12

# Vocal Lead Synth: Mark Mothersbaugh / Gerald Casale vocal line
# Uses s=0 envelope (decay to 0) so vocal notes never hang or get stuck!
v13 w15 a-6 p0 t.003,.26,0,.08 j1,2 k3000 q1.8 g.015 c4,.20 r1 ds.3 [vocal lead synth] vt
v13 >14
v14 w15 a-8 N0,10 p-.5 r0 [vocal partner saw] vt
v13 G14 H14

# ====================================================================
# THE WHIP CRACK: Snare played at a slower rate (w83 at f175)
# Layered with sharp rim crack (w87) and noise lash tail (w5)
# ====================================================================
v21 w83 f175 a9 p0 r1 ds.35 [whip slowed snare] vt
v22 w87 f350 a7 p-.1 [whip rim crack] vt
v23 w5 f1400 a-3 p.2 t.001,.09,0,.03 j2 k2800 q2 [whip noise lash] vt

# Riser: stretched K-synth one-shot
v16 w301 f160 a8 p0 t.005,.01,1,.4 r4 ds.3 [ksynth riser] vt

# Chorus Synth Stabs: punchy analog chord trio (centre/left/right), delay Bus 4
# Envelope has s=0 (decay to 0) so stabs decay naturally to 0 and never hang or drone!
v18 w15 a-6 p-.35 t.002,.20,0,.06 j1 k2800 q2 r4 ds.25 [chorus synth stab left] vt
v18 >19
v18 >20
v19 w15 a-8 p.35 N0,7 t.002,.20,0,.06 j1 k2800 q2 r4 ds.25 [chorus synth stab right] vt
v20 w16 a-8 p0 N0,12 t.002,.20,0,.06 j1 k2800 q2 r4 ds.25 [chorus synth stab centre] vt
v18 G19,20 H19,20

